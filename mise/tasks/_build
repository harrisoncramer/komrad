#!/usr/bin/env bash
# Building komrad, with nothing exported, so a task that starts a server can source it too.

tree_is_dirty() {
	[ -n "$(git status --porcelain)" ]
}

# The toolchain records no revision when it is built from a git worktree, so the commit is
# stamped in the same way the version is.
build_commit() {
	if ! git rev-parse --git-dir >/dev/null 2>&1 || tree_is_dirty; then
		return 0
	fi

	git rev-parse HEAD
}

dirty_suffix() {
	echo "+dirty.$(date +%H%M%S)"
}

local_version() {
	if ! git rev-parse --git-dir >/dev/null 2>&1 || ! tree_is_dirty; then
		return 0
	fi

	echo "v0.0.0-local.$(git rev-parse --short HEAD)$(dirty_suffix)"
}

# The docs directory a build publishes to: a release tag, latest, or dev for a local build.
docs_version() {
	if [ -n "${DOCS_VERSION:-}" ]; then
		echo "$DOCS_VERSION"
	elif [[ "${KOMRAD_VERSION:-}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
		echo "$KOMRAD_VERSION"
	else
		echo dev
	fi
}

go_build_binary() {
	local os="$1" arch="$2" version="$3" out="$4"
	local commit
	commit="$(build_commit)"

	fetch_postgres "$os" "$arch"

	CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" go build \
		-trimpath \
		-tags postgres \
		-ldflags "-s -w -X komrad/internal/version.stamped=$version -X komrad/internal/version.stampedCommit=$commit" \
		-o "$out" .
}

# A build for this machine, which takes its version from the toolchain unless the tree is
# dirty, and only its commit from here.
go_build_local() {
	local out="$1"
	local version commit
	version="$(local_version)"
	commit="$(build_commit)"

	fetch_postgres "$(go env GOOS)" "$(go env GOARCH)"

	go build -tags postgres -ldflags "-X komrad/internal/version.stamped=$version -X komrad/internal/version.stampedCommit=$commit" -o "$out" .
}

# dev_cache is where builds and installs shared by every checkout on this machine are kept.
dev_cache() {
	echo "${XDG_CACHE_HOME:-$HOME/.cache}/komrad-dev"
}

# dev_cache_prune drops the entries under dir nothing has used in two weeks.
dev_cache_prune() {
	find "$1" -mindepth 1 -maxdepth 1 -mtime +14 -exec rm -rf {} +
}

custom_gcl_sum() {
	find tools/komradlint .custom-gcl.yml -type f -print0 | LC_ALL=C sort -z | xargs -0 git hash-object | git hash-object --stdin
}

build_custom_gcl() {
	local sum entry tmp
	sum="$(custom_gcl_sum)"
	entry="$(dev_cache)/custom-gcl/$(printf '%s %s' "$sum" "$(go env GOVERSION GOOS GOARCH)" | git hash-object --stdin)"

	touch -c "$entry"
	rm -f local/custom-gcl
	if [ ! -x "$entry" ]; then
		golangci-lint custom
		mkdir -p "$(dirname "$entry")"
		tmp="$(mktemp "$entry.XXXXXX")"
		mv -f local/custom-gcl "$tmp"
		mv -f "$tmp" "$entry"
		dev_cache_prune "$(dirname "$entry")"
	fi

	mkdir -p local
	ln -s "$entry" local/custom-gcl
	echo "$sum" >local/custom-gcl.sum
}

sha256_of() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | cut -d' ' -f1
	else
		shasum -a 256 "$1" | cut -d' ' -f1
	fi
}

# postgres_target is the name the embedded Postgres archives give a Go platform.
postgres_target() {
	case "$1/$2" in
	darwin/arm64) echo aarch64-apple-darwin ;;
	darwin/amd64) echo x86_64-apple-darwin ;;
	linux/amd64) echo x86_64-unknown-linux-gnu ;;
	linux/arm64) echo aarch64-unknown-linux-gnu ;;
	*)
		echo "there is no embedded Postgres for $1/$2" >&2
		return 1
		;;
	esac
}

# The repository whose prereleases hold the embedded Postgres archives postgres:build publishes.
POSTGRES_RELEASE_REPO="harrisoncramer/komrad"

# postgres_release_tag is the prerelease that holds the embedded Postgres archives of one version.
postgres_release_tag() {
	echo "postgres-$1"
}

# fetch_postgres puts the pinned embedded Postgres archive for one platform where the postgres
# build tag embeds it from, refusing a download whose checksum is not the pinned one.
fetch_postgres() {
	local os="$1" arch="$2"
	local root target line sum name release entry tmp out
	root="$(git rev-parse --show-toplevel)"
	target="$(postgres_target "$os" "$arch")"
	line="$(grep -- "-$target.tar.gz\$" "$root/internal/postgres/checksums.txt")"
	sum="${line%% *}"
	name="${line##* }"
	release="${name#postgresql-}"
	release="${release%-"$target".tar.gz}"
	entry="$(dev_cache)/postgres/$sum.tar.gz"
	out="$root/internal/postgres/bundle/${os}_${arch}.tar.gz"

	if [ ! -f "$entry" ]; then
		mkdir -p "$(dirname "$entry")"
		tmp="$(mktemp "$entry.XXXXXX")"
		gh release download "$(postgres_release_tag "$release")" --repo "$POSTGRES_RELEASE_REPO" --pattern "$name" --output "$tmp" --clobber
		if [ "$(sha256_of "$tmp")" != "$sum" ]; then
			rm -f "$tmp"
			echo "the download of $name does not match the checksum pinned in internal/postgres/checksums.txt" >&2
			return 1
		fi
		mv -f "$tmp" "$entry"
		dev_cache_prune "$(dirname "$entry")"
	fi

	touch -c "$entry"
	mkdir -p "$(dirname "$out")"
	if ! cmp -s "$entry" "$out"; then
		cp "$entry" "$out"
	fi
}
