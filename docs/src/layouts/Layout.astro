---
import "@fontsource-variable/inter";
import "../styles/global.css";

import Header from "../components/Header";
import Search from "../components/Search.astro";
import { SITE_TITLE } from "../consts";
import { canonical, link } from "../site";

type Props = {
  title: string;
  description?: string;
  sidebar?: boolean;
};

const { title, description, sidebar } = Astro.props;
const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href={link("/favicon.png")} />
    <link rel="canonical" href={canonical(Astro.url.pathname)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header client:load path={Astro.url.pathname}>
      <Search />
    </Header>
    <slot name="hero" />
    {sidebar ? (
      <div class="mx-auto flex max-w-[1240px] justify-center px-6">
        <aside class="sidebar">
          <slot name="sidebar" />
        </aside>
        <main class="min-w-0 max-w-[900px] flex-1 py-6 lg:max-w-[924px] lg:pl-6">
          <slot />
        </main>
      </div>
    ) : (
      <main class="mx-auto max-w-[900px] px-6 py-6">
        <slot />
      </main>
    )}
    <script>
      if (location.hash) {
        history.scrollRestoration = "manual";
        const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
        const land = () => target?.scrollIntoView({ block: "start" });
        land();
        void document.fonts.ready.then(land);
      }
    </script>
  </body>
</html>

<style>
  @reference "../styles/global.css";

  .sidebar {
    @apply sticky top-16 hidden h-[calc(100vh-4rem)] w-66 shrink-0 self-start overflow-y-auto overscroll-contain border-r border-app-background-medium pt-8 pr-6 pb-8 lg:block;
    scrollbar-width: none;
    mask-image: linear-gradient(to bottom, black calc(100% - 2rem), transparent);
  }
</style>
