#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
set -euo pipefail
#MISE description="Fast feedback while you work: build, formatting, and only the packages your branch touched."

usage() {
	echo "Usage: mise run check:quick"
	echo
	echo "The loop to run after an edit. It runs the shell and Go formatters in"
	echo "reporting mode and builds every package, then tests and lints only the Go"
	echo "packages your branch changed, taken from the diff against origin/main plus"
	echo "whatever is still uncommitted. The build is unconditional because deleting"
	echo "or moving a package leaves nothing for the diff to resolve to while still"
	echo "breaking everything that imported it."
	echo
	echo "Which packages those are is worked out by 'weavepkg changed', which reads"
	echo "the import graph of every module in the repository, so a change under"
	echo "tools/ is tested and linted the same way as one in weave itself."
	echo
	echo "It is not the gate. The full test suite, gen:check, and db:validate are"
	echo "deliberately not here, and the packages that import what you changed are"
	echo "not tested either, so a pass here says your change compiles and its own"
	echo "packages are green. Run 'mise run check' before you push."
	echo
	echo "The custom linter is only run when local/custom-gcl already exists, since"
	echo "building it is the slow half of go:lint. Run 'mise run go:build-linter'"
	echo "once and every later check:quick lints for free."
	echo
	echo "buf format and buf lint run only when your branch changed a .proto, since"
	echo "linting builds the check plugin weave's own proto rules live in."
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	esac
done

cd "$MISE_CONFIG_ROOT"

BIN_PATH="$MISE_CONFIG_ROOT/local/custom-gcl"
CONFIG="$MISE_CONFIG_ROOT/.golangci.yaml"
BASE_REF="origin/main"

changed_files() {
	if base="$(git merge-base "$BASE_REF" HEAD 2>/dev/null)"; then
		git diff --name-only "$base"
	else
		echo "no $BASE_REF to diff against, so nothing counts as changed" >&2
	fi

	git ls-files --others --exclude-standard
}

plan_field() {
	printf '%s' "$PLAN" | jq -r "$1"
}

module_field() {
	printf '%s' "$PLAN" | jq -r --arg dir "$1" ".modules[] | select(.dir == \$dir) | $2"
}

test_module() {
	local dir="$1"
	shift

	(cd "$MISE_CONFIG_ROOT/$dir" && gotestsum --format pkgname -- "$@")
}

lint_module() {
	local dir="$1"
	shift

	(cd "$MISE_CONFIG_ROOT/$dir" && "$BIN_PATH" run --config "$CONFIG" --timeout 5m "$@")
}

PLAN="$(cd tools/weavepkg && go run . changed --base "$BASE_REF" --dir "$MISE_CONFIG_ROOT")"

CHANGED_COUNT="$(plan_field '[.modules[].packages[]] | length')"
TESTED_COUNT="$(plan_field '[.modules[].packages[] | select(.testable)] | length')"
DEPENDENTS="$(plan_field '.untestedDependents')"

MODULES=()
while IFS= read -r dir; do
	[ -n "$dir" ] || continue
	MODULES+=("$dir")
done < <(plan_field '.modules[] | select(.packages | length > 0) | .dir')

failed=()
run_step() {
	local name="$1"
	shift

	gum log --level info "running $name"
	if ! "$@"; then
		failed+=("$name")
	fi
}

run_step "bash:check" mise run bash:check
run_step "bash:fmt --check" mise run bash:fmt --check
run_step "docs:check" mise run docs:check
run_step "go:fmt --check" mise run go:fmt --check
run_step "go build" go build ./...

PROTO_LINTED=false
if [ -n "$(changed_files | grep '\.proto$' || true)" ]; then
	PROTO_LINTED=true
	run_step "proto:fmt --check" mise run proto:fmt --check
	run_step "proto:lint" mise run proto:lint
fi

LINTED=false
if [ -x "$BIN_PATH" ]; then
	LINTED=true
fi

for dir in ${MODULES[@]+"${MODULES[@]}"}; do
	PACKAGES=()
	while IFS= read -r pkg; do
		[ -n "$pkg" ] || continue
		PACKAGES+=("$pkg")
	done < <(module_field "$dir" '.packages[] | select(.testable) | .importPath')

	PATHS=()
	while IFS= read -r relative; do
		[ -n "$relative" ] || continue
		PATHS+=("./$relative")
	done < <(module_field "$dir" '.packages[].dir')

	# A package every file of which is behind a build tag is linted under that tag and cannot
	# be tested without it, and the integration suite is not what this loop is for.
	if ((${#PACKAGES[@]} > 0)); then
		run_step "go test ($dir)" test_module "$dir" "${PACKAGES[@]}"
	fi

	if [ "$LINTED" = true ]; then
		run_step "go lint ($dir)" lint_module "$dir" "${PATHS[@]}"
	fi
done

if ((${#failed[@]} > 0)); then
	gum log --level error "check:quick failed: ${failed[*]}"
	exit 1
fi

echo
echo "check:quick passed. This is not 'mise run check'."
echo

echo "  built     every package"

if [ "$CHANGED_COUNT" = "0" ]; then
	echo "  tested    nothing: no Go package to run, either nothing Go changed"
	echo "            or what changed is no longer in the tree"
	echo "  linted    nothing, for the same reason"
else
	if [ "$TESTED_COUNT" = "0" ]; then
		echo "  tested    nothing: every package that changed builds only under a build"
		echo "            tag, which the full suite runs and this does not"
	else
		echo "  tested    $TESTED_COUNT changed package(s):"

		for dir in "${MODULES[@]}"; do
			module_field "$dir" '.packages[] | select(.testable) | .importPath' | while IFS= read -r pkg; do
				echo "              $pkg"
			done
		done
	fi

	if [ "$LINTED" = true ]; then
		TAG_ONLY=$((CHANGED_COUNT - TESTED_COUNT))

		if ((TAG_ONLY == 0)); then
			echo "  linted    the same packages"
		elif [ "$TESTED_COUNT" = "0" ]; then
			echo "  linted    $TAG_ONLY package(s), which is everything that changed"
		else
			echo "  linted    those and $TAG_ONLY more that only build under a build tag"
		fi
	else
		echo "  linted    nothing: local/custom-gcl is missing, run 'mise run go:build-linter'"
	fi

	if [ "$DEPENDENTS" != "0" ]; then
		echo "  untested  $DEPENDENTS package(s) import what you changed"
	fi
fi

if [ "$PROTO_LINTED" = true ]; then
	echo "  linted    the protobufs too, and checked their formatting, since your"
	echo "            branch changed one"
fi

echo "  formatted shell and Go, in reporting mode"
echo
echo "  not run   the full test suite, gen:check, db:validate"
echo
echo "Run 'mise run check' before you push."
