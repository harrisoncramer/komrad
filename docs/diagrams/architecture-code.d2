...@_theme

grid-rows: 4
grid-columns: 3
horizontal-gap: 200
vertical-gap: 60

blank1: {class: blank}

ui: UI {class: leaf}

blank2: {class: blank}

cli: CLI {class: leaf}
server: Server {class: leaf}

handlers: Handlers {class: leaf}

postgres: Postgres {class: store}
store: Store {class: leaf}

services: Services {class: leaf}

blank3: {class: blank}
world: The outside world {class: leaf; style.stroke-dash: 3}

adapters: Adapters {class: leaf}

cli -> server -> handlers -> services
services -> store -> postgres
services -> adapters -> world
ui -> server: Connect {class: dashed}
