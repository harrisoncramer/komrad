[Unit]
Description=komrade
After=network-online.target komrade-data-volume.service komrade-database-credentials.service
Wants=network-online.target komrade-manager-session.service
Requires=komrade-data-volume.service
RequiresMountsFor=/var/lib/komrade
ConditionPathExists=/etc/komrade/database.env
ConditionPathIsMountPoint=/var/lib/komrade

[Service]
Type=simple
User=komrade
Group=komrade
Environment=PATH=/opt/mise/data/shims:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
EnvironmentFile=-/etc/komrade/komrade.env
EnvironmentFile=/etc/komrade/database.env
ExecStart=/usr/local/bin/komrade serve
# The tmux server holding every agent is spawned by komrade and so lands in this service's
# cgroup, which systemd kills wholesale by default. Killing only komrade leaves the agents
# running, which is the property tmux is here for: the engine can be upgraded under them.
KillMode=process
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
