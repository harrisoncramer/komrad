schema "public" {
}

# pg_trgm backs the transcript search: it indexes every three-character run of
# the text, which is what makes a search match on any substring rather than on
# whole words only. The extension is not declared here because this Atlas edition
# does not manage extensions; it is created by the first migration, which the
# diff replays into its dev database before reaching the index that needs it.

# An agent.s editable configuration, split out of agents so it is a
# first-class record. Strict 1:1 with an agent; never shared between agents.
table "agent_configs" {
  schema  = schema.public
  comment = "Editable config (cwd, flags) owned by exactly one agent."
  column "id" {
    null    = false
    type    = uuid
    default = sql("uuidv7()")
  }
  column "cwd" {
    null    = false
    type    = text
    default = ""
  }
  column "flags" {
    null    = false
    type    = text
    default = ""
  }
  column "created_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  column "updated_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  primary_key {
    columns = [column.id]
  }
}

# A workflow's default configuration, used only as the blueprint prefilled into
# the new-agent form. Agents copy it into their own config; they never
# reference it at rest.
table "workflow_configs" {
  schema  = schema.public
  comment = "Default config (cwd, flags) seeded into new agents of a workflow."
  column "id" {
    null    = false
    type    = uuid
    default = sql("uuidv7()")
  }
  column "cwd" {
    null    = false
    type    = text
    default = ""
  }
  column "flags" {
    null    = false
    type    = text
    default = ""
  }
  column "created_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  column "updated_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  primary_key {
    columns = [column.id]
  }
}

table "workflows" {
  schema  = schema.public
  comment = "A named bucket of related agents. Pure organization; runs nothing."
  # uuidv7, generated by the database, same scheme as agents.id. Everything
  # keys on this id; the name is a mutable display label.
  column "id" {
    null    = false
    type    = uuid
    default = sql("uuidv7()")
  }
  column "name" {
    null = false
    type = text
  }
  # Free-text durable state for the workflow, edited by the user. Holds shared
  # context that agents in the workflow can read; empty until filled in.
  column "context" {
    null    = false
    type    = text
    default = ""
  }
  # The workflow's default config. References workflow_configs.id.
  column "workflow_config_id" {
    null = false
    type = uuid
  }
  # Soft-delete flag: a deleted workflow is hidden from the panel but kept.
  column "is_deleted" {
    null    = false
    type    = boolean
    default = false
  }
  column "created_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  column "updated_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  primary_key {
    columns = [column.id]
  }
  # A workflow always owns exactly one config, so the reference is never null and
  # the config is never removed out from under it.
  foreign_key "workflows_workflow_config_id_fkey" {
    columns     = [column.workflow_config_id]
    ref_columns = [table.workflow_configs.column.id]
    on_delete   = RESTRICT
    on_update   = NO_ACTION
  }
  index "workflows_workflow_config_id" {
    columns = [column.workflow_config_id]
  }
}

table "agent_transcripts" {
  schema  = schema.public
  comment = "Flattened transcript for an agent, synced from Claude's on-disk JSONL and indexed for search. Strict 1:1 with an agent."
  # Equals agents.id, so this is the one id the caller supplies rather than the
  # database: the agent owns exactly one transcript, and reusing its id makes
  # the 1:1 link implicit and keyless.
  column "agent_id" {
    null = false
    type = uuid
  }
  # The user and assistant turns flattened to plain text, the corpus search runs
  # over. Tool calls, tool results, and thinking are dropped so the index stays
  # lean and matches read as conversation.
  column "content" {
    null    = false
    type    = text
    default = ""
  }
  # How many bytes of the source JSONL have been folded into content already.
  # The syncer seeks here and reads only the appended tail, so a large transcript
  # is not re-parsed every pass. The JSONL is append-only, so the offset only
  # grows unless the file is rewritten, which the syncer detects and reindexes.
  column "synced_offset" {
    null    = false
    type    = bigint
    default = 0
  }
  column "synced_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  primary_key {
    columns = [column.agent_id]
  }
  foreign_key "agent_transcripts_agent_id_fkey" {
    columns     = [column.agent_id]
    ref_columns = [table.agents.column.id]
    on_delete   = CASCADE
    on_update   = NO_ACTION
  }
  # The search index. A GIN index over trigrams is what makes a substring match
  # across the whole corpus cheap; without it every search is a sequential scan
  # of every transcript.
  index "agent_transcripts_content_trgm" {
    type = GIN
    on {
      column = column.content
      ops    = gin_trgm_ops
    }
  }
}

table "agents" {
  schema  = schema.public
  comment = "One background Claude agent, everything needed to restore it."
  # uuidv7, time-ordered so it sorts chronologically. Postgres 18 generates it,
  # so an id is never invented by a caller and every row is stamped the same way
  # whichever process wrote it.
  column "id" {
    null    = false
    type    = uuid
    default = sql("uuidv7()")
  }
  column "name" {
    null = false
    type = text
  }
  # This agent's own config. References agent_configs.id. Set on insert and
  # never null: an agent always owns exactly one config row.
  column "agent_config_id" {
    null = false
    type = uuid
  }
  column "prompt" {
    null    = false
    type    = text
    default = ""
  }
  column "pane_id" {
    null    = false
    type    = text
    default = ""
  }
  column "state" {
    null    = false
    type    = text
    default = "new"
  }
  # Claude Code's own conversation id (from the hook payload), used to relaunch
  # with `claude --resume <id>` when restoring a dormant agent.
  column "claude_session_id" {
    null    = false
    type    = text
    default = ""
  }
  # The workflow this agent belongs to, and every agent has one. A workflow is
  # where the directory, flags, and shared context an agent starts from live, so an
  # agent outside one would have no defaults to inherit and nowhere to be listed.
  # References workflows.id.
  column "workflow_id" {
    null = false
    type = uuid
  }
  # The schedule that launched this agent, or null for one a person started.
  column "schedule_id" {
    null = true
    type = uuid
  }
  # A caller-supplied key that makes a create idempotent. A retried launch, from
  # a background job or a tool call, passes the same key and gets the agent that
  # already exists rather than a second Claude process on the same prompt. Null
  # for a create that makes no such claim, which is every create from the panel.
  column "idempotency_key" {
    null = true
    type = text
  }
  # Soft-delete flag: a deleted record is hidden from the panel but kept.
  column "is_deleted" {
    null    = false
    type    = boolean
    default = false
  }
  # Hidden keeps an agent out of the panel's list while leaving it running. It is
  # not a second soft delete: the agent is live, still reconciled, and still
  # counted, it just does not take a row until the panel is asked to show the
  # hidden ones. It is the user's own flag, so nothing but they ever sets it.
  column "is_hidden" {
    null    = false
    type    = boolean
    default = false
  }
  # The mark the user put on this agent, null when it carries none. It holds the
  # glyph itself, since which glyphs exist is their config and the glyph is the
  # whole meaning. Only the person writes it, never the reconciler, since what an
  # agent is doing is already in state.
  column "mark" {
    null = true
    type = text
  }
  column "created_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  column "updated_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  primary_key {
    columns = [column.id]
  }
  foreign_key "agents_agent_config_id_fkey" {
    columns     = [column.agent_config_id]
    ref_columns = [table.agent_configs.column.id]
    on_delete   = RESTRICT
    on_update   = NO_ACTION
  }
  foreign_key "agents_workflow_id_fkey" {
    columns     = [column.workflow_id]
    ref_columns = [table.workflows.column.id]
    on_delete   = RESTRICT
    on_update   = NO_ACTION
  }
  foreign_key "agents_schedule_id_fkey" {
    columns     = [column.schedule_id]
    ref_columns = [table.schedules.column.id]
    on_delete   = RESTRICT
    on_update   = NO_ACTION
  }
  # Unique on name only among live records. A soft-deleted row keeps its name,
  # so without the predicate a deleted agent would block ever reusing its name
  # and the upsert-by-name path would resurrect the dead row instead of creating
  # a fresh one. Scoping the constraint to live rows lets deleted rows retain
  # their name harmlessly while every name-keyed lookup still resolves to at
  # most one live agent.
  index "agents_name_active" {
    unique  = true
    columns = [column.name]
    where   = "is_deleted = false"
  }
  index "agents_agent_config_id" {
    columns = [column.agent_config_id]
  }
  # Scoped listings filter by workflow, so index the foreign key.
  index "agents_workflow_id" {
    columns = [column.workflow_id]
  }
  # A schedule's detail view lists what it has launched, so index that key too.
  index "agents_schedule_id" {
    columns = [column.schedule_id]
  }
  # One agent per key, across live and deleted rows alike. Unlike the name
  # index this is not scoped to live records: a retry must find the agent it
  # already created even if that agent has since been archived, or it would
  # spawn a duplicate. Partial on non-null so the ordinary create, which claims
  # no key, is unconstrained.
  index "agents_idempotency_key" {
    unique  = true
    columns = [column.idempotency_key]
    where   = "idempotency_key IS NOT NULL"
  }
}
