#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
set -euo pipefail
#MISE description="Put this checkout's weave on the remote engine and restart it."

usage() {
	echo "Usage: mise run remote:deploy [ssh-destination]"
	echo
	echo "Cross-compiles weave for the engine, installs it there, and restarts the service."
	echo "It also builds a local binary carrying the same version, because the panel refuses"
	echo "to talk to a server whose build string differs from its own."
	echo
	echo "With no argument the engine is the one connection.ssh names in your weave config,"
	echo "with the account WEAVE_ENGINE_ADMIN gives (ubuntu by default). That account needs"
	echo "sudo to replace the binary, which is why it is not the one the panel connects as."
	echo
	echo "Both binaries land in dist/."
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	esac
done

cd "$MISE_CONFIG_ROOT"

DESTINATION="${1:-}"

if [ -z "$DESTINATION" ]; then
	CONFIG="${WEAVE_CONFIG:-}"
	CONFIG="${CONFIG%%:*}"
	if [ -z "$CONFIG" ]; then
		CONFIG="$HOME/.config/weave/config.toml"
	fi

	if [ -f "$CONFIG" ]; then
		ENGINE="$(sed -n 's/^[[:space:]]*ssh[[:space:]]*=[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$CONFIG" | head -1)"
		if [ -n "$ENGINE" ]; then
			DESTINATION="${WEAVE_ENGINE_ADMIN:-ubuntu}@${ENGINE#*@}"
		fi
	fi
fi

if [ -z "$DESTINATION" ]; then
	echo "no engine to deploy to. Set connection.ssh in your weave config to the engine the" >&2
	echo "panel talks to, or pass an ssh destination." >&2
	exit 1
fi

gum log --level info "deploying to $DESTINATION"

REVISION="$(git rev-parse --short HEAD)"
DIRTY=""
if ! git diff --quiet || ! git diff --cached --quiet; then
	DIRTY="+dirty.$(date +%H%M%S)"
fi
VERSION="v0.0.0-engine.$REVISION$DIRTY"

mkdir -p dist
go_build_binary linux arm64 "$VERSION" dist/weave-linux-arm64
go_build_binary "$(go env GOOS)" "$(go env GOARCH)" "$VERSION" dist/weave-panel

# A fixed name in a sticky /tmp cannot be overwritten by a different account, so each run
# uploads to a path of its own and removes it afterwards.
STAGED="$(ssh "$DESTINATION" 'mktemp /tmp/weave-deploy.XXXXXX')"

scp -q dist/weave-linux-arm64 "$DESTINATION:$STAGED"

# The script goes over stdin with the path as a real argument, so nothing is expanded by the
# wrong shell on the way.
ssh "$DESTINATION" bash -s -- "$STAGED" <<'REMOTE'
set -euo pipefail

staged="$1"

sudo install -m 0755 "$staged" /usr/local/bin/weave
rm -f "$staged"
sudo systemctl restart weave.service
REMOTE

for _ in {1..20}; do
	if ssh "$DESTINATION" 'systemctl is-active --quiet weave.service'; then
		break
	fi
	sleep 2
done

if ! ssh "$DESTINATION" 'systemctl is-active --quiet weave.service'; then
	echo "weave did not come back up on $DESTINATION; check journalctl -u weave" >&2
	exit 1
fi

echo "engine: $(ssh "$DESTINATION" /usr/local/bin/weave version 2>&1 | head -1)"
echo "panel:  dist/weave-panel at $VERSION"
