schema "main" {
}

table "sessions" {
  schema  = schema.main
  comment = "One background Claude agent, everything needed to restore it."
  # uuidv7 as text: time-ordered, so it sorts chronologically. Generated by the
  # app on insert since SQLite has no native uuidv7().
  column "id" {
    null = false
    type = text
  }
  column "name" {
    null = false
    type = text
  }
  column "cwd" {
    null    = false
    type    = text
    default = ""
  }
  column "flags" {
    null    = false
    type    = text
    default = ""
  }
  column "prompt" {
    null    = false
    type    = text
    default = ""
  }
  column "pane_id" {
    null    = false
    type    = text
    default = ""
  }
  column "state" {
    null    = false
    type    = text
    default = "new"
  }
  # Claude Code's own conversation id (from the hook payload), used to relaunch
  # with `claude --resume <id>` when restoring a dormant agent.
  column "claude_session_id" {
    null    = false
    type    = text
    default = ""
  }
  column "created_at" {
    null    = false
    type    = datetime
    default = sql("CURRENT_TIMESTAMP")
  }
  column "updated_at" {
    null    = false
    type    = datetime
    default = sql("CURRENT_TIMESTAMP")
  }
  primary_key {
    columns = [column.id]
  }
  index "sessions_name" {
    unique  = true
    columns = [column.name]
  }
}
