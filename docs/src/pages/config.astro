---
import DocPage from "../layouts/DocPage.astro";
import Heading from "../components/reference/Heading.astro";
import Sidebar from "../components/Sidebar.astro";
import { config, prose } from "../reference";
import { codeLink } from "../reference/refs";
import type { Section } from "../reference/types";
import { configSidebar } from "../sidebar";

const flatten = (section: Section): Section[] => [section, ...section.sections.flatMap(flatten)];
const sections = flatten(config).filter((section) => section.settings.length > 0 || section.description);
const firstOf = new Map<string, string>();
for (const section of sections) {
  const table = section.path.split(".")[0] ?? "";
  if (!firstOf.has(table)) firstOf.set(table, section.path);
}
const tables = [...firstOf].map(([table, path]) => ({ id: path || "top-level", label: table || "top level" }));
---

<DocPage
  title="Configuration"
  description="Every key of ~/.config/komrad/config.toml with its built-in default. Write only the keys you are changing; an unknown key is an error."
>
  <Sidebar slot="sidebar" label="Configuration" groups={configSidebar(tables)} />
  {sections.map((section) => (
    <section class="type">
      <Heading id={section.path || "top-level"}>
        {section.path ? <code class="table-name">[{section.path}]</code> : "Top level"}
      </Heading>
      {section.description && <div set:html={prose(section.description, codeLink({}))} />}
      {section.settings.length > 0 && (
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Key</th>
                <th>Default</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              {section.settings.map((setting) => (
                <tr id={setting.path}>
                  <td>
                    <a class="row-anchor" href={`#${setting.path}`}>
                      <code>{setting.key}</code>
                    </a>
                  </td>
                  <td class="default-cell" data-sep="=">
                    <code class:list={{ long: setting.default.length > 24 }}>{setting.default}</code>
                  </td>
                  <td set:html={prose(setting.description, codeLink({}))} />
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  ))}
</DocPage>
