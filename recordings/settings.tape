# How every recording looks, sourced ahead of each script by mise run record and
# docs:recordings. The colours are the docs site's own, from docs/src/styles/global.css: the
# terminal is a shade darker than the page, with the page's text and accent blue.
#
# VHS writes frames out as if it captured every one on time, so a frame rate the machine cannot
# keep up with plays back faster than it happened. Ten a second is one it can.
Set Shell bash
Set FontFamily "JetBrainsMono Nerd Font"
Set FontSize 20
Set Width 1440
Set Height 920
Set Padding 24
Set TypingSpeed 50ms
Set CursorBlink false
Set Framerate 10
Set Theme {"name":"komrad","background":"#080d1a","foreground":"#c9d4e5","selection":"#1f2c47","cursor":"#9ec4ff","black":"#111a2e","brightBlack":"#7a879e","red":"#ff8a8a","brightRed":"#ffa8a8","green":"#8fd4a8","brightGreen":"#a9e4be","yellow":"#f5c26b","brightYellow":"#ffd58f","blue":"#9ec4ff","brightBlue":"#bcd6ff","magenta":"#c7a6ff","brightMagenta":"#d9c2ff","cyan":"#7fd6e0","brightCyan":"#a3e4ec","white":"#c9d4e5","brightWhite":"#ffffff"}
