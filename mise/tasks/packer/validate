#!/usr/bin/env bash
set -euo pipefail
#MISE description="Validate the Packer template."

cd "$MISE_CONFIG_ROOT/packer"

if [ ! -e ../dist/weave-linux-arm64 ]; then
	mkdir -p ../dist
	: >../dist/weave-linux-arm64
	trap 'rm -f "$MISE_CONFIG_ROOT/dist/weave-linux-arm64"' EXIT
fi

packer init .
packer validate .
