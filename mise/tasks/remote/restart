#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
source "$MISE_CONFIG_ROOT/mise/tasks/remote/_remote_utils"
set -euo pipefail
#MISE description="Restart an engine's server, and with --hard its tmux server and every agent."

usage() {
	echo "Usage: mise run remote:restart NAME [--hard]"
	echo
	echo "Restarts the server of the engine at /NAME. The agents keep running, because the"
	echo "service is stopped in a way that leaves the tmux server it forked alone."
	echo
	echo "With --hard the tmux server goes too, which is what picks up a change to the"
	echo "manager session itself. Every agent on the engine stops and does not come back."
	echo
	echo "A stopped engine is started instead, since booting it starts the server fresh."
	echo "NAME control-plane restarts the control plane's server."
	echo
	echo "The restart is sent through Systems Manager."
}

HARD=false
NAME=""

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	--hard)
		HARD=true
		;;
	-*)
		echo "unknown flag: $arg" >&2
		echo >&2
		usage >&2
		exit 1
		;;
	*)
		NAME="$arg"
		;;
	esac
done

if [ -z "$NAME" ]; then
	usage >&2
	exit 1
fi

cd "$MISE_CONFIG_ROOT"

use_komrad_aws_profile

INSTANCE="$(require_instance "$NAME")"
REGION="$(engine_region)"
STATE="$(instance_state "$INSTANCE" "$REGION")"

case "$STATE" in
"")
	echo "could not read the state of $NAME, so nothing was done to it." >&2
	exit 1
	;;
running) ;;
stopped | stopping | pending)
	if [ "$NAME" = control-plane ]; then
		echo "the control plane is $STATE, which is not a state to restart from" >&2
		exit 1
	fi

	gum log --level info "$NAME is $STATE, so starting it rather than restarting it"
	if [ "$STATE" = stopping ]; then
		aws ec2 wait instance-stopped --region "$REGION" --instance-ids "$INSTANCE"
	fi
	if [ "$STATE" != pending ]; then
		aws ec2 start-instances --region "$REGION" --instance-ids "$INSTANCE" >/dev/null
	fi
	aws ec2 wait instance-running --region "$REGION" --instance-ids "$INSTANCE"
	gum log --level info "$NAME is starting, and its server answers within a few minutes"
	exit 0
	;;
*)
	echo "$NAME is $STATE, which is not a state to restart from" >&2
	exit 1
	;;
esac

if [ "$NAME" = control-plane ]; then
	gum log --level info "restarting the control plane's server"
	run_on_instance "$INSTANCE" "$REGION" \
		"systemctl restart komrad-control-plane.service" \
		"sleep 3" \
		"systemctl is-active komrad-control-plane.service"
	exit
fi

if [ "$HARD" = true ]; then
	gum log --level info "restarting $NAME and its tmux server, which stops every agent"
	COMMANDS=(
		"systemctl restart komrad.service"
		"sleep 3"
		"sudo -u komrad tmux -L komrad kill-server 2>/dev/null || true"
		"systemctl restart komrad-manager-session.service"
		"sleep 4"
		"systemctl is-active komrad.service komrad-manager-session.service"
		"sudo -u komrad tmux -L komrad list-windows -a -F \"WIN #{window_id} panes=#{window_panes} #{window_name}\" 2>&1"
	)
else
	gum log --level info "restarting $NAME, leaving its agents running"
	COMMANDS=(
		"systemctl restart komrad.service"
		"sleep 4"
		"systemctl is-active komrad.service"
		"sudo -u komrad tmux -L komrad list-windows -a -F \"WIN #{window_id} panes=#{window_panes} #{window_name}\" 2>&1"
	)
fi

run_on_instance "$INSTANCE" "$REGION" "${COMMANDS[@]}"
