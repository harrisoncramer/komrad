#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
set -euo pipefail
#MISE description="Run every check: shell, formatting, lint, and tests."

usage() {
	echo "Usage: mise run check [--kind all|unit|integration]"
	echo
	echo "Runs the whole suite and reports which steps failed rather than stopping at"
	echo "the first, so one run tells you everything that is wrong. The formatters are"
	echo "called in their reporting mode, though gen:check rewrites what drifted"
	echo "and fails so you can see what it had to do. Struct formatting is not"
	echo "here: run 'go-structs' from the dotfiles, which touches only the files"
	echo "your branch changes."
	echo
	echo "The tests need Postgres, so run 'mise run docker:up' first. Drift in"
	echo "config.toml is caught by the config tests, which regenerate it in memory"
	echo "and compare, so a stale file fails here without needing a clean git tree."
	echo "gen:check covers the sqlc and buf output too, but only when those paths"
	echo "have no uncommitted edits."
	echo
	echo "--kind is handed to go:test. Everything else here runs whichever kind you"
	echo "name, since formatting and linting are not split."
}

KIND="all"
while (($#)); do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--kind)
		KIND="${2:-}"
		if [ -z "$KIND" ]; then
			echo "check: --kind takes all, unit or integration" >&2
			usage >&2
			exit 1
		fi
		shift 2
		;;
	*)
		echo "check: unknown argument $1" >&2
		usage >&2
		exit 1
		;;
	esac
done

case "$KIND" in
all | unit | integration) ;;
*)
	echo "check: no kind of test called $KIND" >&2
	usage >&2
	exit 1
	;;
esac

cd "$MISE_CONFIG_ROOT"

STEPS=(
	"bash:check"
	"bash:fmt --check"
	"go:fmt --check"
	"db:fmt --check"
	"proto:fmt --check"
	"db:validate"
	"go:lint"
	"proto:lint"
	"go:test --kind $KIND"
	"gen:check"
)

failed=()
for STEP in "${STEPS[@]}"; do
	gum log --level info "running $STEP"

	# shellcheck disable=SC2086
	if ! mise run $STEP; then
		failed+=("$STEP")
	fi
done

if ((${#failed[@]} > 0)); then
	gum log --level error "failed: ${failed[*]}"
	exit 1
fi

gum log --level info "all checks passed"
