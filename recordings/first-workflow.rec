# The first run in the install guide (docs/public/guides/first-workflow), recorded from an
# empty throwaway instance: the welcome screen, then a first workflow made from it. It stops on
# the folder-trust question the workflow's orchestrator asks, since answering it starts a real
# Claude session.
#
# To remake it, make an empty git repo at /private/tmp/komrad-demo/my-app, then drop the
# instance's database and bring it back up empty:
#   MISE_ENV=test mise run docker:down -v
#   MISE_ENV=test mise run docker:up
#   MISE_ENV=test mise run restart
#   MISE_ENV=test mise run record recordings/first-workflow.rec --pause 0.9s
# then crop the recorder's step bar off the top and encode the gif to webm and mp4.
key Escape
sleep 300ms
key w
sleep 800ms
type my-app
sleep 600ms
key Enter
key Enter
key Enter
type /private/tmp/komrad-demo/my-app
sleep 800ms
key C-s
sleep 2500ms
