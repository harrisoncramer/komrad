#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
source "$MISE_CONFIG_ROOT/mise/tasks/remote/_remote_utils"
set -euo pipefail
#MISE description="Open a shell on the remote engine, or run one command there."

usage() {
	echo "Usage: mise run remote:connect [-- command...]"
	echo
	echo "Opens a shell on the engine as the komrad account through Systems Manager. With a"
	echo "command after -- it runs that instead and prints what it printed, which is what a"
	echo "script wants."
	echo
	echo "The instance comes from Terraform, or from KOMRAD_ENGINE_INSTANCE. The shell needs"
	echo "the Session Manager plugin for the AWS CLI."
	echo
	echo "  mise run remote:connect"
	echo "  mise run remote:connect -- systemctl status komrad"
	echo "  mise run remote:connect -- tmux -L komrad list-sessions"
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	esac
done

cd "$MISE_CONFIG_ROOT"

use_komrad_aws_profile

INSTANCE="$(require_instance "")"
REGION="$(engine_region)"

if [ "$#" -gt 0 ]; then
	ENCODED="$(printf '%s' "$*" | base64 | tr -d '\n')"
	run_on_engine "$INSTANCE" "$REGION" "echo $ENCODED | base64 -d | sudo -iu komrad bash"
	exit
fi

exec aws ssm start-session \
	--region "$REGION" \
	--target "$INSTANCE" \
	--document-name AWS-StartInteractiveCommand \
	--parameters command="sudo -iu komrad"
