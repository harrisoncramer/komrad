schema "main" {
}

# A session's editable configuration, split out of sessions so it is a
# first-class record. Strict 1:1 with a session; never shared between sessions.
table "session_configs" {
  schema  = schema.main
  comment = "Editable config (cwd, flags) owned by exactly one session."
  column "id" {
    null = false
    type = text
  }
  column "cwd" {
    null    = false
    type    = text
    default = ""
  }
  column "flags" {
    null    = false
    type    = text
    default = ""
  }
  column "created_at" {
    null    = false
    type    = datetime
    default = sql("CURRENT_TIMESTAMP")
  }
  column "updated_at" {
    null    = false
    type    = datetime
    default = sql("CURRENT_TIMESTAMP")
  }
  primary_key {
    columns = [column.id]
  }
}

# A workflow's default configuration, used only as the blueprint prefilled into
# the new-chat form. Sessions copy it into their own config; they never
# reference it at rest.
table "workflow_configs" {
  schema  = schema.main
  comment = "Default config (cwd, flags) seeded into new chats of a workflow."
  column "id" {
    null = false
    type = text
  }
  column "cwd" {
    null    = false
    type    = text
    default = ""
  }
  column "flags" {
    null    = false
    type    = text
    default = ""
  }
  column "created_at" {
    null    = false
    type    = datetime
    default = sql("CURRENT_TIMESTAMP")
  }
  column "updated_at" {
    null    = false
    type    = datetime
    default = sql("CURRENT_TIMESTAMP")
  }
  primary_key {
    columns = [column.id]
  }
}

table "workflows" {
  schema  = schema.main
  comment = "A named bucket of related chats. Pure organization; runs nothing."
  # uuidv7 as text, generated by the app, same scheme as sessions.id. Everything
  # keys on this id; the name is a mutable display label.
  column "id" {
    null = false
    type = text
  }
  column "name" {
    null = false
    type = text
  }
  # Free-text durable state for the workflow, edited by the user. Holds shared
  # context that agents in the workflow can read; empty until filled in.
  column "context" {
    null    = false
    type    = text
    default = ""
  }
  # The workflow's default config. References workflow_configs.id.
  column "workflow_config_id" {
    null = false
    type = text
  }
  # Soft-delete flag: a deleted workflow is hidden from the panel but kept.
  column "is_deleted" {
    null    = false
    type    = integer
    default = 0
  }
  column "created_at" {
    null    = false
    type    = datetime
    default = sql("CURRENT_TIMESTAMP")
  }
  column "updated_at" {
    null    = false
    type    = datetime
    default = sql("CURRENT_TIMESTAMP")
  }
  primary_key {
    columns = [column.id]
  }
}

table "sessions" {
  schema  = schema.main
  comment = "One background Claude agent, everything needed to restore it."
  # uuidv7 as text: time-ordered, so it sorts chronologically. Generated by the
  # app on insert since SQLite has no native uuidv7().
  column "id" {
    null = false
    type = text
  }
  column "name" {
    null = false
    type = text
  }
  # This session's own config. References session_configs.id. Set on insert and
  # never null: a session always owns exactly one config row.
  column "session_config_id" {
    null = false
    type = text
  }
  column "prompt" {
    null    = false
    type    = text
    default = ""
  }
  column "pane_id" {
    null    = false
    type    = text
    default = ""
  }
  column "state" {
    null    = false
    type    = text
    default = "new"
  }
  # Claude Code's own conversation id (from the hook payload), used to relaunch
  # with `claude --resume <id>` when restoring a dormant agent.
  column "claude_session_id" {
    null    = false
    type    = text
    default = ""
  }
  # The workflow this chat belongs to, or null when unassigned. Null, not an
  # empty sentinel, so unassigned reads as the genuine absence of a workflow and
  # needs no backfill. References workflows.id.
  column "workflow_id" {
    null = true
    type = text
  }
  # Soft-delete flag: a deleted record is hidden from the panel but kept.
  column "is_deleted" {
    null    = false
    type    = integer
    default = 0
  }
  column "created_at" {
    null    = false
    type    = datetime
    default = sql("CURRENT_TIMESTAMP")
  }
  column "updated_at" {
    null    = false
    type    = datetime
    default = sql("CURRENT_TIMESTAMP")
  }
  primary_key {
    columns = [column.id]
  }
  # Unique on name only among live records. A soft-deleted row keeps its name,
  # so without the predicate a deleted agent would block ever reusing its name
  # and the upsert-by-name path would resurrect the dead row instead of creating
  # a fresh one. Scoping the constraint to is_deleted = 0 lets deleted rows
  # retain their name harmlessly while every name-keyed lookup still resolves to
  # at most one live agent.
  index "sessions_name_active" {
    unique  = true
    columns = [column.name]
    where   = "is_deleted = 0"
  }
  # Scoped listings filter by workflow, so index the foreign key.
  index "sessions_workflow_id" {
    columns = [column.workflow_id]
  }
}
