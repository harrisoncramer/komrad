#!/usr/bin/env bash

# Explainer: what every remote task needs to know, asked of the thing that knows it.
#
# Terraform built the engine, so Terraform is what says where it is. Reading its outputs keeps
# these tasks agreeing with the infrastructure rather than with a copy of it, and means none of
# them has to read the files an operator edits.
#
# The AWS profile is not one of those things. It is a credential choice belonging to whoever is
# running the command, so it comes from the environment like it does for every other AWS tool.

require_aws_profile() {
	if [ -n "${AWS_PROFILE:-}" ] || [ -n "${AWS_ACCESS_KEY_ID:-}" ] || [ -n "${AWS_SESSION_TOKEN:-}" ]; then
		return 0
	fi

	echo "no AWS credentials in the environment." >&2
	echo >&2
	echo "Export AWS_PROFILE, or whichever of AWS_ACCESS_KEY_ID and friends you use:" >&2
	echo >&2
	echo "  export AWS_PROFILE=your-profile" >&2
	exit 1
}

terraform_output() {
	local name=$1

	if [ ! -d infra/terraform/.terraform ] && [ -f infra/terraform/backend.hcl ]; then
		terraform -chdir=infra/terraform init \
			-backend-config=backend.hcl -input=false -lockfile=readonly >/dev/null 2>&1 || true
	fi

	terraform -chdir=infra/terraform output -raw "$name" 2>/dev/null
}

# require_output reads one output, and says what to do when there is no infrastructure to read.
require_output() {
	local name=$1 value

	value="$(terraform_output "$name")"

	if [ -z "$value" ]; then
		echo "could not read $name from Terraform, so there is no engine to work with." >&2
		echo >&2
		echo "Run 'mise run terraform:apply' to build one, or set the matching WEAVE_ENGINE_*" >&2
		echo "variable to skip Terraform entirely." >&2
		exit 1
	fi

	echo "$value"
}

engine_region() {
	echo "${AWS_REGION:-$(terraform_output aws_region)}"
}

# require_instance names the engine's instance, taking an argument over the environment over state.
require_instance() {
	local instance=${1:-${WEAVE_ENGINE_INSTANCE:-}}

	if [ -z "$instance" ]; then
		instance="$(terraform_output instance_id)"
	fi

	if [ -z "$instance" ]; then
		echo "could not read the engine's instance from Terraform." >&2
		echo >&2
		echo "Run 'mise run terraform:apply' to build one, or set WEAVE_ENGINE_INSTANCE." >&2
		exit 1
	fi

	echo "$instance"
}

# ssm_run sends one command to the engine and prints what it wrote, which is the way in that does
# not need the caller to have an address the security group allows.
ssm_run() {
	local instance=$1 region=$2 commands=$3 command_id outcome

	command_id="$(aws ssm send-command \
		--region "$region" \
		--instance-ids "$instance" \
		--document-name AWS-RunShellScript \
		--parameters "commands=$commands" \
		--query 'Command.CommandId' --output text)" || return 1

	for _ in $(seq 1 60); do
		outcome="$(aws ssm get-command-invocation --region "$region" --command-id "$command_id" \
			--instance-id "$instance" --query 'Status' --output text 2>/dev/null || echo Pending)"

		case "$outcome" in
		Success)
			aws ssm get-command-invocation --region "$region" --command-id "$command_id" \
				--instance-id "$instance" --query 'StandardOutputContent' --output text
			return 0
			;;
		Failed | Cancelled | TimedOut)
			aws ssm get-command-invocation --region "$region" --command-id "$command_id" \
				--instance-id "$instance" --query 'StandardErrorContent' --output text >&2
			return 1
			;;
		esac

		sleep 2
	done

	echo "the command sent to $instance was still running after two minutes" >&2

	return 1
}

# engine_agents prints one "state<tab>name" line per agent the engine holds, and nothing when it
# cannot be asked.
engine_agents() {
	local instance=$1 region=$2 payload

	payload="$(ssm_run "$instance" "$region" \
		'["sudo -u weave --set-home weave rpc list-agents --compact 2>/dev/null || true"]' 2>/dev/null)" || return 0

	jq -r '.agents // [] | .[] | "\(.state)\t\(.name)"' <<<"$payload" 2>/dev/null || true
}

# engine_address prints the address the instance answers on, which is the Elastic IP for as long
# as one is associated.
engine_address() {
	local instance=$1 region=$2 address

	address="$(aws ec2 describe-instances --region "$region" --instance-ids "$instance" \
		--query 'Reservations[0].Instances[0].PublicIpAddress' --output text 2>/dev/null)"

	if [ "$address" = "None" ]; then
		return 0
	fi

	echo "$address"
}

engine_state() {
	local instance=$1 region=$2

	aws ec2 describe-instances --region "$region" --instance-ids "$instance" \
		--query 'Reservations[0].Instances[0].State.Name' --output text 2>/dev/null
}
