#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
set -euo pipefail
#MISE description="Regenerate the watch trigger attachments from the resources in internal/watch."

usage() {
	echo "Usage: mise run gen:triggers"
	echo
	echo "Rewrites the migration that attaches a watch trigger to every table a"
	echo "resource is the rows of, from the resources declared in internal/watch,"
	echo "and rehashes atlas.sum. The Go list is the source of truth; the migration"
	echo "is output, so edit the list and run this rather than the other way around."
	echo "The trigger functions themselves are hand-written, one migration earlier."
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	esac
done

cd "$MISE_CONFIG_ROOT"

go generate ./internal/watch/...
