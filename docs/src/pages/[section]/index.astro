---
import Layout from "../../layouts/Layout.astro";
import { SECTIONS } from "../../consts";
import { getPages } from "../../pages";

export function getStaticPaths() {
  return SECTIONS.map((section) => ({
    params: { section: section.id },
    props: { section },
  }));
}

const { section } = Astro.props;
const pages = await getPages(section.id);
---

<Layout title={section.title}>
  <h1 class="mb-8 leading-tight">{section.title}</h1>
  {
    pages.length === 0 ? (
      <p class="text-app-gray-dim">Nothing here yet.</p>
    ) : (
      <ul class="flex flex-col gap-6">
        {pages.map((page) => (
          <li class="list-none">
            <a href={`/${section.id}/${page.id}`} class="font-['Playfair_Display'] text-xl">
              {page.data.title}
            </a>
            {page.data.description && <p class="mt-1 text-app-gray-light">{page.data.description}</p>}
          </li>
        ))}
      </ul>
    )
  }
</Layout>
