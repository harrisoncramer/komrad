#!/usr/bin/env bash
#MISE description="Run weave doctor on a container that has just installed it."
set -euo pipefail
source "$MISE_CONFIG_ROOT/mise/tasks/_"

usage() {
	echo "Usage: mise run doctor:sandbox [stage] [-- args...]"
	echo
	echo "Runs the doctor against a machine with nothing set up on it, which is the"
	echo "only way to see what a first run looks like from a checkout that has"
	echo "everything already. The stage says how much of what weave needs is there:"
	echo
	echo "  bare       the binary and nothing else (default)"
	echo "  tmux-old   a tmux below the version the panel's key binding needs"
	echo "  tmux       a tmux new enough"
	echo "  postgres   a tmux new enough, beside an empty Postgres of its own"
	echo
	echo "Anything after -- is passed to the binary, so 'sh' opens a shell on the"
	echo "same machine to set something up by hand."
	echo
	echo "  clean      remove the sandbox containers and their Postgres"
	echo
	echo "Never tear these down with 'docker compose down -v'. From this directory"
	echo "that also removes the db service and the volume holding your agents."
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	esac
done

cd "$MISE_CONFIG_ROOT"

stage="${1:-bare}"
shift || true
if [ "${1:-}" = "--" ]; then
	shift
fi

if [ "$stage" = "clean" ]; then
	docker compose --profile doctor rm --stop --force \
		doctor-bare doctor-tmux-old doctor-tmux doctor-postgres doctor-db
	exit 0
fi

case "$(docker info --format '{{.Architecture}}')" in
aarch64 | arm64) arch=arm64 ;;
x86_64 | amd64) arch=amd64 ;;
*)
	echo "unsupported docker architecture: $(docker info --format '{{.Architecture}}')" >&2
	exit 1
	;;
esac

CGO_ENABLED=0 GOOS=linux GOARCH="$arch" go build -o bin/weave-linux .

service="doctor-$stage"

docker compose --profile doctor build --quiet "$service"

exec docker compose --profile doctor run --rm "$service" "$@"
