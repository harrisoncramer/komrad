#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
source "$MISE_CONFIG_ROOT/mise/tasks/remote/_remote_utils"
set -euo pipefail
#MISE description="Put this checkout's weave on the remote engine and restart it."

usage() {
	echo "Usage: mise run remote:deploy [instance-id]"
	echo
	echo "Cross-compiles weave for the engine, installs it there, and restarts the service."
	echo "A clean deploy carries this checkout's commit, which is what the panel compares"
	echo "against, so a panel built from the same commit needs nothing further. A deploy"
	echo "from a dirty tree names no commit, so it also builds a local binary at the same"
	echo "version for you to put in place of your own weave."
	echo
	echo "WEAVE_VERSION names the version the binary reports, which is how a release deploy"
	echo "puts its own tag on the engine. It is refused from a dirty tree."
	echo
	echo "With no argument the instance is whichever one Terraform last built."
	echo "The binaries land in dist/."
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	esac
done

cd "$MISE_CONFIG_ROOT"

require_aws_profile

INSTANCE="${1:-${WEAVE_ENGINE_INSTANCE:-}}"

if [ -z "$INSTANCE" ]; then
	# A checkout that has never run Terraform has no state to read the instance from, and
	# initialising is idempotent, so it is done here rather than asked for.
	INSTANCE="$(terraform_output instance_id)"
fi

if [ -z "$INSTANCE" ]; then
	echo "could not read the engine's instance from Terraform." >&2
	echo >&2
	echo "Run 'mise run terraform:apply' to build one, or set WEAVE_ENGINE_INSTANCE." >&2
	exit 1
fi

REGION="${AWS_REGION:-us-east-1}"
BUCKET="$(require_output state_bucket)"
if [ -z "$BUCKET" ]; then
	echo "no state bucket to stage the binary through" >&2
	exit 1
fi

gum log --level info "deploying to $INSTANCE in $REGION"

REVISION="$(git rev-parse --short HEAD)"
DIRTY=""
if tree_is_dirty; then
	DIRTY="+dirty.$(date +%H%M%S)"
fi

# A dirty build carries no commit, so its version string is the only thing anybody has to go on.
# Letting a caller name that version would put a binary on the engine that answers v0.3.0 and is
# not v0.3.0, which is why this refuses rather than annotating what it was given.
if [ -n "${WEAVE_VERSION:-}" ] && [ -n "$DIRTY" ]; then
	echo "WEAVE_VERSION names $WEAVE_VERSION, and this tree has uncommitted changes." >&2
	echo >&2
	echo "Commit them, or unset WEAVE_VERSION and deploy under the engine stamp." >&2
	exit 1
fi

VERSION="${WEAVE_VERSION:-v0.0.0-engine.$REVISION$DIRTY}"

mkdir -p dist
go_build_binary linux arm64 "$VERSION" dist/weave-linux-arm64
if [ -n "$DIRTY" ]; then
	go_build_binary "$(go env GOOS)" "$(go env GOARCH)" "$VERSION" dist/weave-panel
else
	rm -f dist/weave-panel
fi

KEY="deploy/weave-linux-arm64-$VERSION"
aws s3 cp dist/weave-linux-arm64 "s3://$BUCKET/$KEY" --only-show-errors
URL="$(aws s3 presign "s3://$BUCKET/$KEY" --expires-in 900 --region "$REGION")"

# The instance fetches the binary itself, so nothing large travels through the command and the
# instance needs no permission on the bucket.
COMMAND_ID="$(aws ssm send-command \
	--region "$REGION" \
	--instance-ids "$INSTANCE" \
	--document-name AWS-RunShellScript \
	--parameters "commands=[\"set -e\",\"curl -fsSL -o /tmp/weave-new '$URL'\",\"install -m 0755 /tmp/weave-new /usr/local/bin/weave\",\"rm -f /tmp/weave-new\",\"systemctl restart weave.service\"]" \
	--query Command.CommandId \
	--output text)"

for _ in {1..30}; do
	STATUS="$(aws ssm get-command-invocation --region "$REGION" --command-id "$COMMAND_ID" \
		--instance-id "$INSTANCE" --query Status --output text 2>/dev/null || echo Pending)"
	case "$STATUS" in
	Success) break ;;
	Failed | Cancelled | TimedOut)
		aws ssm get-command-invocation --region "$REGION" --command-id "$COMMAND_ID" \
			--instance-id "$INSTANCE" --query StandardErrorContent --output text >&2
		exit 1
		;;
	esac
	sleep 4
done

aws s3 rm "s3://$BUCKET/$KEY" --only-show-errors

if [ "$STATUS" != "Success" ]; then
	echo "the install did not finish on $INSTANCE; it was last $STATUS" >&2
	exit 1
fi

echo "engine: $VERSION on $INSTANCE"
if [ -n "$DIRTY" ]; then
	echo "panel:  dist/weave-panel at $VERSION, since a dirty build is known by its version alone"
fi
