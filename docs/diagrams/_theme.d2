vars: {
  d2-config: {
    theme-id: 200
    layout-engine: elk
    pad: 32
    theme-overrides: {
      N1: "#ffffff"
      N2: "#c9d4e5"
      N3: "#a8b5cb"
      N4: "#7a879e"
      N5: "#1f2c47"
      N6: "#152038"
      N7: "#0c1322"
      B1: "#9ec4ff"
      B2: "#9ec4ff"
      B3: "#1f2c47"
      B4: "#152038"
      B5: "#111a2e"
      B6: "#0c1322"
      AA2: "#f5c26b"
      AA4: "#1f2c47"
      AA5: "#111a2e"
      AB4: "#1f2c47"
      AB5: "#111a2e"
    }
  }
}

classes: {
  leaf: {
    width: 178
    height: 60
    style: {bold: true; font-size: 16; fill: "#0c1322"}
  }
  more: {
    label: "..."
    width: 178
    height: 40
    style: {stroke-dash: 3; bold: true; font-size: 16; fill: "#0c1322"}
  }
  store: {
    shape: cylinder
    width: 178
    height: 90
    style: {bold: true; font-size: 16}
  }
  blank: {
    label: ""
    width: 178
    height: 60
    style.opacity: 0
  }
  group: {
    style: {bold: false; font-size: 16; font-color: "#c9d4e5"}
  }
  dashed: {
    style.stroke-dash: 3
  }
}
