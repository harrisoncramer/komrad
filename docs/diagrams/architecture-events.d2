...@_theme

grid-rows: 2
grid-columns: 3
horizontal-gap: 180
vertical-gap: 80

commit: Write commits {class: leaf}

trigger: Trigger {class: leaf}

listener: Listener {class: leaf}

panel: Panel {class: leaf}

render: Render pass {class: leaf}

pending: Pending set {class: leaf}

commit -> trigger -> listener -> pending -> render
render -> panel: stream
