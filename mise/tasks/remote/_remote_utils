#!/usr/bin/env bash

# Explainer: what every remote task needs to know, asked of the thing that knows it.
#
# Terraform built the control plane and the engines, so Terraform is what says where they are.
# Reading its outputs keeps these tasks agreeing with the infrastructure rather than with a copy
# of it, and means none of them has to read the files an operator edits.
#
# The AWS profile is komrad. Credentials already in the environment, such as CI's, win over it.

use_komrad_aws_profile() {
	if [ -n "${AWS_PROFILE:-}" ] || [ -n "${AWS_ACCESS_KEY_ID:-}" ] || [ -n "${AWS_SESSION_TOKEN:-}" ]; then
		return 0
	fi

	export AWS_PROFILE=komrad
}

init_terraform() {
	if [ ! -d infra/engine/.terraform ] && [ -f infra/engine/backend.hcl ]; then
		terraform -chdir=infra/engine init \
			-backend-config=backend.hcl -input=false -lockfile=readonly >/dev/null 2>&1 || true
	fi
}

terraform_output() {
	local name=$1

	init_terraform
	terraform -chdir=infra/engine output -raw "$name" 2>/dev/null
}

# require_output reads one output, and says what to do when there is no infrastructure to read.
require_output() {
	local name=$1 value

	value="$(terraform_output "$name")"

	if [ -z "$value" ]; then
		echo "could not read $name from Terraform, so there is no engine to work with." >&2
		echo >&2
		echo "Run 'mise run infra:engine:apply' to build one." >&2
		exit 1
	fi

	echo "$value"
}

engine_region() {
	echo "${AWS_REGION:-$(terraform_output aws_region)}"
}

# instances prints a line for each instance with its name and id, the control plane's first.
instances() {
	init_terraform
	terraform -chdir=infra/engine output -json instance_ids 2>/dev/null |
		jq -r 'to_entries | sort_by(.key != "control-plane") | .[] | "\(.key) \(.value)"'
}

# require_instance names the instance of the control plane, or of the engine at /NAME.
require_instance() {
	local name=$1 listed instance

	listed="$(instances)"

	if [ -z "$listed" ]; then
		echo "could not read the instances from Terraform." >&2
		echo >&2
		echo "Run 'mise run infra:engine:apply' to build them." >&2
		exit 1
	fi

	instance="$(awk -v name="$name" '$1 == name { print $2 }' <<<"$listed")"

	if [ -z "$instance" ]; then
		echo "Terraform built no instance named '$name'. Name one of these:" >&2
		awk '{ print "  " $1 }' <<<"$listed" >&2
		exit 1
	fi

	echo "$instance"
}

# instance_state answers with nothing rather than failing, so that a caller reading it into a
# variable under set -e reaches its own check instead of dying at the assignment.
instance_state() {
	local instance=$1 region=$2

	aws ec2 describe-instances --region "$region" --instance-ids "$instance" \
		--query 'Reservations[0].Instances[0].State.Name' --output text 2>/dev/null || true
}

run_on_instance() {
	local instance=$1 region=$2 command_id status
	shift 2

	command_id="$(aws ssm send-command \
		--region "$region" \
		--instance-ids "$instance" \
		--document-name AWS-RunShellScript \
		--parameters "$(jq -n '{commands: $ARGS.positional}' --args "$@")" \
		--query Command.CommandId \
		--output text)"

	for _ in {1..60}; do
		status="$(aws ssm get-command-invocation --region "$region" --command-id "$command_id" \
			--instance-id "$instance" --query Status --output text 2>/dev/null || echo Pending)"

		case "$status" in
		Success)
			aws ssm get-command-invocation --region "$region" --command-id "$command_id" \
				--instance-id "$instance" --query StandardOutputContent --output text
			return 0
			;;
		Failed | Cancelled | TimedOut)
			echo "the command did not finish on $instance: $status" >&2
			aws ssm get-command-invocation --region "$region" --command-id "$command_id" \
				--instance-id "$instance" --query StandardOutputContent --output text
			aws ssm get-command-invocation --region "$region" --command-id "$command_id" \
				--instance-id "$instance" --query StandardErrorContent --output text >&2
			return 1
			;;
		esac

		sleep 2
	done

	echo "the command was still running on $instance after two minutes, so it is left to finish on its own" >&2
	return 1
}
