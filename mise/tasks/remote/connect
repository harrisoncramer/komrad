#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
source "$MISE_CONFIG_ROOT/mise/tasks/remote/_remote_utils"
set -euo pipefail
#MISE description="Open a shell on the control plane or an engine, or run one command there."

usage() {
	echo "Usage: mise run remote:connect NAME [-- command...]"
	echo
	echo "Opens a shell through Systems Manager on the engine at /NAME, as the komrad account,"
	echo "or on the control plane when NAME is control-plane, as root. With a command after --"
	echo "it runs that instead and prints what it printed, which is what a script wants."
	echo
	echo "The shell needs the Session Manager plugin for the AWS CLI."
	echo
	echo "  mise run remote:connect harry"
	echo "  mise run remote:connect harry -- systemctl status komrad"
	echo "  mise run remote:connect control-plane -- journalctl -u komrad-control-plane -n 50"
}

NAME=""
COMMAND=()

while [ "$#" -gt 0 ]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--)
		shift
		COMMAND=("$@")
		break
		;;
	*)
		if [ -n "$NAME" ]; then
			usage >&2
			exit 1
		fi
		NAME="$1"
		;;
	esac
	shift
done

if [ -z "$NAME" ]; then
	usage >&2
	exit 1
fi

cd "$MISE_CONFIG_ROOT"

use_komrad_aws_profile

INSTANCE="$(require_instance "$NAME")"
REGION="$(engine_region)"

LOGIN="sudo -iu komrad"
if [ "$NAME" = control-plane ]; then
	LOGIN="sudo -i"
fi

if [ "${#COMMAND[@]}" -gt 0 ]; then
	ENCODED="$(printf '%s' "${COMMAND[*]}" | base64 | tr -d '\n')"
	run_on_instance "$INSTANCE" "$REGION" "echo $ENCODED | base64 -d | $LOGIN bash"
	exit
fi

exec aws ssm start-session \
	--region "$REGION" \
	--target "$INSTANCE" \
	--document-name AWS-StartInteractiveCommand \
	--parameters command="$LOGIN"
