#!/usr/bin/env bash
set -euo pipefail
source "$MISE_CONFIG_ROOT/mise/tasks/infra/dev/_terraform_utils"

backend="$MISE_CONFIG_ROOT/infra/dev/backend.hcl"

if [ ! -f "$backend" ]; then
	echo "create infra/dev/backend.hcl from backend.hcl.example before initializing" >&2
	exit 1
fi

run_terraform init -backend-config="$backend" "$@"
