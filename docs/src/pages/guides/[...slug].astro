---
import { render } from "astro:content";
import DocPage from "../../layouts/DocPage.astro";
import Sidebar from "../../components/Sidebar.astro";
import { getGuides } from "../../guides";
import { link } from "../../site";
import { guideSidebar } from "../../sidebar";

export async function getStaticPaths() {
  const guides = await getGuides();
  return guides.map((guide, index) => ({
    params: { slug: guide.id },
    props: { guide, prev: guides[index - 1], next: guides[index + 1] },
  }));
}

const { guide, prev, next } = Astro.props;
const { Content, headings } = await render(guide);
const sidebar = await guideSidebar(guide.id, headings);
const neighbour = (entry: typeof guide | undefined) =>
  entry && { title: entry.data.title, href: link(`/guides/${entry.id}`) };
---

<DocPage
  title={guide.data.title}
  description={guide.data.description}
  filePath={guide.filePath}
  prev={neighbour(prev)}
  next={neighbour(next)}
>
  <Sidebar slot="sidebar" label="Guides" groups={sidebar} />
  <Content />
</DocPage>
