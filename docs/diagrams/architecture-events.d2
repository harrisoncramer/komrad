...@_theme

grid-rows: 2
grid-columns: 3
grid-gap: 80

commit: write commits
trigger: "trigger\npg_notify(\"agents <key>\")"
listener: "listener\none dedicated\nconnection"
panel
render: "render pass\nread rows back,\ndiff per subscriber"
pending: "pending set\nkeys to re-read"

commit -> trigger -> listener -> pending -> render
render -> panel: stream
