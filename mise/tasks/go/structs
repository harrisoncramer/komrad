#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
set -euo pipefail
#MISE description="Hold struct declarations and literals to one field per line, with no blank lines between them."

usage() {
	echo "Usage: mise run go:structs [--fix] [--min N] [--no-tests]"
	echo
	echo "Reports keyed struct literals written on a single line, which read worse"
	echo "than one field per line, and blank lines between the fields of a struct,"
	echo "which read as a grouping nobody meant. Without --fix it only reports and"
	echo "exits non-zero, so the check task can call it without rewriting the tree."
	echo
	echo "Both codemods run even when the first has something to say, so one run"
	echo "lists everything that is wrong."
}

WRITE=()
TESTS=true
MIN=3
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--fix)
		WRITE=(-w)
		;;
	--no-tests)
		TESTS=false
		;;
	--min)
		if [ $# -lt 2 ]; then
			echo "--min needs a number" >&2
			exit 1
		fi
		shift
		MIN="$1"
		;;
	*)
		echo "unknown flag: $1" >&2
		usage >&2
		exit 1
		;;
	esac
	shift
done

cd "$MISE_CONFIG_ROOT"

failed=()

if ! go run ./cmd/structexpand -min "$MIN" -tests="$TESTS" ${WRITE[@]+"${WRITE[@]}"} .; then
	failed+=("structexpand")
fi

if ! go run ./cmd/structgap -tests="$TESTS" ${WRITE[@]+"${WRITE[@]}"} .; then
	failed+=("structgap")
fi

if ((${#failed[@]} > 0)); then
	gum log --level error "failed: ${failed[*]}"
	exit 1
fi
