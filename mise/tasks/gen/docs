#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
set -euo pipefail
#MISE description="Regenerate the reference data the docs site renders."

usage() {
	echo "Usage: mise run gen:docs"
	echo
	echo "Writes api.json, cli.json and config.json under docs/src/data from the proto"
	echo "descriptors, the cobra command tree and the Config struct. Those sources are"
	echo "the truth; the files are output, so a thin description is fixed at its source"
	echo "and regenerated rather than edited here."
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	esac
done

cd "$MISE_CONFIG_ROOT"

go run ./cmd/gen-docs
