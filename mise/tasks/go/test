#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
set -euo pipefail
#MISE description="Run the Go tests, the unit ones or those plus the integration ones."

usage() {
	echo "Usage: mise run go:test [--kind unit|integration|all]"
	echo
	echo "Runs both kinds by default. A test that drives a real git, a real tmux or a"
	echo "real komrad carries the integration build tag, so it is compiled out of a"
	echo "unit run rather than skipped inside one."
	echo
	echo "Every test in a tagged file is named TestIntegration, which is how an"
	echo "integration run picks out only those and leaves the unit tests alone."
	echo
	echo "Which tests a pull request runs is decided in .github/workflows/ci.yml,"
	echo "since that is where the files a branch changed are already known."
	echo
	echo "A package with no test files is not printed, which is most of proto/gen"
	echo "and db/models."
}

KIND="all"

while (($#)); do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--kind)
		KIND="${2:-}"
		if [ -z "$KIND" ]; then
			echo "go:test: --kind takes unit, integration or all" >&2
			usage >&2
			exit 1
		fi
		shift 2
		;;
	*)
		echo "go:test: unknown argument $1" >&2
		usage >&2
		exit 1
		;;
	esac
done

TAGS=()
case "$KIND" in
unit) ;;
integration)
	TAGS=(-tags integration -run '^TestIntegration')
	;;
all)
	TAGS=(-tags integration)
	;;
*)
	echo "go:test: no kind of test called $KIND" >&2
	usage >&2
	exit 1
	;;
esac

cd "$MISE_CONFIG_ROOT"

# The tools are modules of their own, so the suite below does not see them. They run
# first because a red suite under set -e would otherwise mean they never run at all.
for TOOL in komradlint komradpkg; do
	(cd "$MISE_CONFIG_ROOT/tools/$TOOL" && gotestsum --format pkgname --format-hide-empty-pkg -- "${TAGS[@]}" ./...)
done

gotestsum --format pkgname --format-hide-empty-pkg -- "${TAGS[@]}" ./...
