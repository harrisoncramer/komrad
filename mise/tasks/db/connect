#!/usr/bin/env bash
#MISE description="Open a psql shell to the embedded Postgres, the throwaway instance's under MISE_ENV=test."
set -euo pipefail
source "$MISE_CONFIG_ROOT/mise/tasks/_"

dir="${KOMRAD_STATE_DIR:-$HOME/.local/state/komrad}/postgres"
programs=("$dir"/*/bin/psql)
psql="${programs[${#programs[@]} - 1]}"
if [ ! -x "$psql" ]; then
	psql=psql
fi

exec "$psql" "host=$dir port=5432 user=komrad dbname=komrad"
