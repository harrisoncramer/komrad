#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
set -euo pipefail
#MISE description="Serve the built docs site from docs/dist."

usage() {
	echo "Usage: mise run docs:preview"
	echo
	echo "Serves docs/dist as it would be deployed. Run docs:build first, with the same"
	echo "DOCS_VERSION, since the base path the site links under is fixed at build time."
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	esac
done

cd "$MISE_CONFIG_ROOT/docs"

if [ ! -f node_modules/.package-lock.json ] || [ package-lock.json -nt node_modules/.package-lock.json ]; then
	npm ci
fi

PUBLIC_DOCS_VERSION="$(docs_version)"
PUBLIC_DOCS_COMMIT="$(build_commit)"
export PUBLIC_DOCS_VERSION PUBLIC_DOCS_COMMIT

gum log --level info "docs at $PUBLIC_DOCS_VERSION, commit ${PUBLIC_DOCS_COMMIT:-none, the tree is dirty}"

npm run preview
