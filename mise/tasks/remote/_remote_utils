#!/usr/bin/env bash

# Explainer: what every remote task needs to know, asked of the thing that knows it.
#
# Terraform built the engine, so Terraform is what says where it is. Reading its outputs keeps
# these tasks agreeing with the infrastructure rather than with a copy of it, and means none of
# them has to read the files an operator edits.
#
# The AWS profile is not one of those things. It is a credential choice belonging to whoever is
# running the command, so it comes from the environment like it does for every other AWS tool.

require_aws_profile() {
	if [ -n "${AWS_PROFILE:-}" ] || [ -n "${AWS_ACCESS_KEY_ID:-}" ] || [ -n "${AWS_SESSION_TOKEN:-}" ]; then
		return 0
	fi

	echo "no AWS credentials in the environment." >&2
	echo >&2
	echo "Export AWS_PROFILE, or whichever of AWS_ACCESS_KEY_ID and friends you use:" >&2
	echo >&2
	echo "  export AWS_PROFILE=your-profile" >&2
	exit 1
}

terraform_output() {
	local name=$1

	if [ ! -d infra/terraform/.terraform ] && [ -f infra/terraform/backend.hcl ]; then
		terraform -chdir=infra/terraform init \
			-backend-config=backend.hcl -input=false >/dev/null 2>&1 || true
	fi

	terraform -chdir=infra/terraform output -raw "$name" 2>/dev/null
}

# terraform_output_list reads an output holding a list, which -raw refuses to print.
terraform_output_list() {
	local name=$1

	terraform -chdir=infra/terraform output -json "$name" 2>/dev/null |
		jq -r 'join(" ")' 2>/dev/null || true
}

# explain_unreachable says why ssh could not get through, which is worth saying because a
# firewall dropping a packet looks the same from here as a box that is not running.
#
# It reports rather than decides, so a probe it cannot run leaves ssh to try anyway.
explain_unreachable() {
	local host=$1 mine allowed

	mine="$(public_address)"
	allowed="$(terraform_output_list ssh_allowed_cidrs)"

	echo >&2
	echo "  this machine looks like  ${mine:-could not tell}" >&2
	echo "  the firewall allows      ${allowed:-could not tell}" >&2
	echo >&2

	if [ -z "$mine" ]; then
		echo "Could not work out how this machine appears from outside, so whether the firewall" >&2
		echo "is the problem is unknown." >&2

		return 0
	fi

	if [ -z "$allowed" ]; then
		echo "Could not read which addresses are allowed, so whether yours is among them is" >&2
		echo "unknown. An output that Terraform has not applied yet reads as nothing here." >&2

		return 0
	fi

	if allows_address "$allowed" "$mine"; then
		echo "Your address is listed, so the firewall is not what is stopping you. Check the" >&2
		echo "engine is running." >&2

		return 0
	fi

	echo "Your address is not listed as an exact entry, which is what happens after you change" >&2
	echo "network. A range among those may still cover it. Add yours with:" >&2
	echo >&2
	echo "  mise run remote:allow" >&2
}

# allows_address reports whether an address is one of the entries, comparing whole entries so
# that 203.0.113.4 is not read as covered by 203.0.113.40.
allows_address() {
	local allowed=$1 mine=$2 entry

	for entry in $allowed; do
		if [ "$entry" = "$mine" ] || [ "$entry" = "$mine/32" ]; then
			return 0
		fi
	done

	return 1
}

# reachable reports whether anything answers ssh, using bash's own tcp support so that no
# external command has to be present or spell its timeout a particular way.
reachable() {
	local host=$1

	timeout_connect "$host" 22
}

timeout_connect() {
	local host=$1 port=$2

	(
		exec 3<>"/dev/tcp/$host/$port"
	) 2>/dev/null
}

# require_output reads one output, and says what to do when there is no infrastructure to read.
require_output() {
	local name=$1 value

	value="$(terraform_output "$name")"

	if [ -z "$value" ]; then
		echo "could not read $name from Terraform, so there is no engine to work with." >&2
		echo >&2
		echo "Run 'mise run terraform:apply' to build one, or set the matching WEAVE_ENGINE_*" >&2
		echo "variable to skip Terraform entirely." >&2
		exit 1
	fi

	echo "$value"
}
