#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
set -euo pipefail
#MISE description="Run the Go tests, all of them or one kind."

usage() {
	echo "Usage: mise run go:test [--kind all|unit|integration] [--changed-since REF]"
	echo
	echo "Runs every test by default. The line between the two kinds is a real git:"
	echo "seven packages drive one, which is slow and flakes when the machine is"
	echo "busy, and they are the integration tests. The same split is written into"
	echo ".golangci.yaml, which forbids a unit test from reaching for git at all."
	echo
	echo "The unit tests are not free of everything external. They reach a real"
	echo "Postgres, and the panel and the agents reconciler drive a real tmux, which"
	echo "is the next line to draw."
	echo
	echo "--changed-since takes a git ref and drops the integration packages that"
	echo "cannot be affected by what changed since it. A package is kept when the"
	echo "change touched something it imports, counting the imports of its tests, and"
	echo "when anything outside Go changed at all. internal/e2e and internal/cli"
	echo "import most of the module, so in practice they run whenever any Go file does."
}

KIND="all"
SINCE=""

while (($#)); do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--kind)
		KIND="${2:-}"
		if [ -z "$KIND" ]; then
			echo "go:test: --kind takes all, unit or integration" >&2
			usage >&2
			exit 1
		fi
		shift 2
		;;
	--changed-since)
		SINCE="${2:-}"
		if [ -z "$SINCE" ]; then
			echo "go:test: --changed-since takes a git ref" >&2
			usage >&2
			exit 1
		fi
		shift 2
		;;
	*)
		echo "go:test: unknown argument $1" >&2
		usage >&2
		exit 1
		;;
	esac
done

case "$KIND" in
all | unit | integration) ;;
*)
	echo "go:test: no kind of test called $KIND" >&2
	usage >&2
	exit 1
	;;
esac

if [ -n "$SINCE" ] && [ "$KIND" != "integration" ]; then
	echo "go:test: --changed-since narrows the integration tests, and this run is $KIND" >&2
	exit 1
fi

cd "$MISE_CONFIG_ROOT"

# The integration packages, as directories. .golangci.yaml excuses the same set
# from the rule against driving a real git, so a package added here belongs
# there too.
INTEGRATION_DIRS=(
	internal/git
	internal/diff
	internal/scripts
	internal/e2e
	internal/tmux
	internal/cli
	cmd/paneldemo
)

MODULE="$(go list -m)"

# The base is resolved here rather than inside a pipeline, where errexit does
# not reach and an unresolvable ref would read as a branch that changed nothing.
BASE=""
if [ -n "$SINCE" ]; then
	if ! BASE="$(git merge-base "$SINCE" HEAD)"; then
		echo "go:test: $SINCE names no commit this branch shares history with" >&2
		exit 1
	fi
fi

integrationPackages() {
	local dir
	for dir in "${INTEGRATION_DIRS[@]}"; do
		echo "$MODULE/$dir"
	done
}

unitPackages() {
	go list ./... | grep -vxF -f <(integrationPackages)
}

# changedFiles is what the branch has written since the base, counting the files
# git has not been told about yet.
changedFiles() {
	git diff --name-only "$BASE"
	git ls-files --others --exclude-standard
}

# changedPackages is the packages holding a Go file that changed since the ref,
# and nothing for a change outside Go.
changedPackages() {
	local file dir

	changedFiles | while IFS= read -r file; do
		case "$file" in
		*.go) ;;
		*) continue ;;
		esac

		dir="$(dirname "$file")"
		[ -d "$dir" ] || continue

		go list "./$dir" 2>/dev/null || true
	done | sort -u
}

# doesChangeReachOnlyGo reports whether everything that changed since the ref is
# a Go file, since anything else can reach a test in ways nothing here models.
doesChangeReachOnlyGo() {
	! changedFiles | grep -qv '\.go$'
}

# affectedIntegrationPackages is the integration packages that import something
# the change touched, reading the imports of their tests as well as their own.
affectedIntegrationPackages() {
	local changed pkg
	changed="$(changedPackages)"

	if [ -z "$changed" ]; then
		return 0
	fi

	while IFS= read -r pkg; do
		if go list -deps -test "$pkg" 2>/dev/null | grep -qxF -f <(echo "$changed"); then
			echo "$pkg"
		fi
	done < <(integrationPackages)
}

case "$KIND" in
all)
	PACKAGES=(./...)
	;;
unit)
	mapfile -t PACKAGES < <(unitPackages)
	;;
integration)
	if [ -n "$SINCE" ] && doesChangeReachOnlyGo; then
		mapfile -t PACKAGES < <(affectedIntegrationPackages)

		# Selecting nothing is the answer here rather than a symptom, and it is
		# the only arm where that is true.
		if ((${#PACKAGES[@]} == 0)); then
			echo "no integration test can be reached by what changed since $SINCE"
			exit 0
		fi
	else
		mapfile -t PACKAGES < <(integrationPackages)
	fi
	;;
esac

gotestsum --format pkgname -- "${PACKAGES[@]}"
