aws_region                      = "us-east-1"
aws_account_id                  = "123456789012"
aws_profile                     = "komrad"
aws_config_file                 = "/absolute/path/to/aws/config"
aws_shared_credentials_file     = "/absolute/path/to/aws/credentials"
ami_id                          = "ami-0123456789abcdef0"  # arm64 (Graviton) image, must match instance_type
availability_zone               = "us-east-1a"

domain_name           = "komrad.example.com"
sign_in_issuer        = "https://accounts.google.com"
sign_in_client_id     = "0000000000-abc.apps.googleusercontent.com"
sign_in_client_secret = "GOCSPX-..."

github_repository    = "owner/repo"
github_owner_id      = "0000000"
github_repository_id = "000000000"
state_bucket         = "your-terraform-state-bucket"
