...@_theme

direction: right

secrets: Secrets Manager {class: store}

host: Engine host {
  class: group

  key: "App key, tmpfs" {class: store}
  helper: Credential helper {class: leaf}
  connection: Forge connection {class: store}
  git: git and glab {class: leaf}

  key -> helper: GitHub
  connection -> helper: GitLab
  helper -> git: short token
}

github: GitHub {class: leaf}
gitlab: GitLab {class: leaf}

secrets -> host.key: boot
host.git -> github
host.git -> gitlab
