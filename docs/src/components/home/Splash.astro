---
import { REPO_URL } from "../../consts";
import { link } from "../../site";
---

<figure class="splash">
  <picture>
    <source media="(max-width: 767.98px)" srcset={link("/splash/splash-960.webp")} />
    <img
      src={link("/splash/splash.webp")}
      alt="The weave panel: a list of agents grouped by project beside a live Claude session."
      width="1920"
      height="930"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <video
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    data-webm={link("/splash/splash.webm")}
    data-mp4={link("/splash/splash.mp4")}
  ></video>
  <div class="scrim" aria-hidden="true"></div>
  <div class="overlay">
    <h1>A terminal-based agent manager</h1>
    <p>
      Run Claude and Codex agents side by side in tmux. Weave keeps them organised, lets them talk, and remembers what
      they did.
    </p>
    <div class="actions">
      <a class="primary" href={link("/guides/install")}>
        Get started
      </a>
      <a class="secondary" href={REPO_URL} target="_blank" rel="noreferrer">
        GitHub
      </a>
    </div>
  </div>
</figure>

<style>
  @reference "../../styles/global.css";

  .splash {
    @apply relative mx-auto w-full max-w-[1920px] overflow-hidden;
    aspect-ratio: 1920 / 930;
    mask-image:
      linear-gradient(to right, transparent, #000 5%, #000 95%, transparent),
      linear-gradient(to bottom, #000 55%, transparent);
    mask-composite: intersect;
  }

  @media (max-width: 767.98px) {
    .splash {
      aspect-ratio: 1 / 1;
      mask-image: linear-gradient(to right, #000 70%, transparent), linear-gradient(to bottom, #000 60%, transparent);
    }
  }

  .splash img,
  .splash video {
    @apply absolute inset-0 h-full w-full object-cover object-left-top;
  }

  .splash video {
    @apply opacity-0 transition-opacity duration-500;
  }

  .splash video[data-playing] {
    @apply opacity-100;
  }

  .scrim {
    @apply absolute inset-0;
    background:
      radial-gradient(ellipse 60% 70% at 50% 45%, rgba(8, 13, 26, 0.88), rgba(8, 13, 26, 0.55) 70%),
      rgba(8, 13, 26, 0.25);
  }

  .overlay {
    @apply absolute inset-0 flex flex-col items-center justify-center px-6 text-center;
  }

  .overlay h1 {
    @apply text-2xl leading-tight font-semibold tracking-tight text-app-white md:text-4xl;
  }

  .overlay p {
    @apply mt-3 max-w-md text-sm leading-relaxed text-app-gray md:max-w-xl md:text-base;
  }

  .actions {
    @apply mt-6 flex gap-2.5;
  }

  .actions a {
    @apply rounded-md px-4 py-2 text-sm font-medium no-underline transition-colors duration-200;
  }

  .primary {
    @apply bg-app-blue text-app-black hover:bg-app-white;
  }

  .secondary {
    @apply border border-app-gray/30 bg-app-black/40 text-app-white backdrop-blur-sm hover:border-app-blue/60;
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>(".splash video");
  const wide = window.matchMedia("(min-width: 768px)");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (video && wide.matches && !still.matches) {
    for (const [type, attribute] of [
      ["video/webm", "webm"],
      ["video/mp4", "mp4"],
    ] as const) {
      const source = document.createElement("source");
      source.type = type;
      source.src = video.dataset[attribute] ?? "";
      video.append(source);
    }

    video.addEventListener(
      "playing",
      () => {
        video.dataset.playing = "";
      },
      { once: true },
    );
    video.load();
    void video.play().catch(() => undefined);
  }
</script>
