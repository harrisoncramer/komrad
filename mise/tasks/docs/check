#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
set -euo pipefail
#MISE description="Type-check the docs site."

usage() {
	echo "Usage: mise run docs:check"
	echo
	echo "Runs astro check over the pages, components and content schema under docs/, then"
	echo "fails on a guide that writes a keybinding by hand rather than through <Key>."
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	esac
done

cd "$MISE_CONFIG_ROOT/docs"

docs_install

npm run check
node scripts/check-keys.mjs
