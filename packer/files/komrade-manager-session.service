[Unit]
Description=Create the tmux session komrade holds its agents in
After=komrade.service

[Service]
Type=oneshot
RemainAfterExit=yes
# komrade forks the tmux server holding every agent, so it lands in this unit's cgroup and the
# default KillMode would take it down with this unit.
KillMode=process
User=komrade
Group=komrade
Environment=PATH=/opt/mise/data/shims:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
EnvironmentFile=-/etc/komrade/komrade.env
EnvironmentFile=/etc/komrade/database.env
ExecStart=/usr/local/sbin/komrade-manager-session

[Install]
WantedBy=multi-user.target
