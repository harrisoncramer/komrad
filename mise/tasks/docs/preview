#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
set -euo pipefail
#MISE description="Serve the built docs site from docs/dist."

usage() {
	echo "Usage: mise run docs:preview"
	echo
	echo "Serves docs/dist under the version it was built as. Run docs:build first."
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	esac
done

cd "$MISE_CONFIG_ROOT/docs"

if [ ! -f node_modules/.package-lock.json ] || [ package-lock.json -nt node_modules/.package-lock.json ]; then
	npm ci
fi

if [ ! -f dist/.docs-version ]; then
	echo "nothing is built yet, run mise run docs:build first." >&2
	exit 1
fi

PUBLIC_DOCS_VERSION="$(cat dist/.docs-version)"
export PUBLIC_DOCS_VERSION

gum log --level info "serving docs/dist at http://localhost:4321/$PUBLIC_DOCS_VERSION/"

npm run preview
