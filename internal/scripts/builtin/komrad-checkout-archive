#!/bin/sh
#KOMRAD description="Shrink a komrad checkout whose task archived back to its work: give back its throwaway test instance and drop the installs and builds any checkout makes again when it needs them. Does nothing in any other checkout."
#KOMRAD timeout="2m"
set -eu

if [ -z "${KOMRAD_WORKTREE_NAME:-}" ]; then
	exit 0
fi

tree="$KOMRAD_AGENT_CWD"

if [ ! -x "$tree/mise/tasks/_test_instance" ]; then
	exit 0
fi

name="${KOMRAD_WORKTREE_NAME:-}"

if [ "$(basename "$tree")" != "$name" ]; then
	echo "archive: $tree is not named $name, so it is not this agent's to shrink" >&2
	exit 0
fi

"$tree/mise/tasks/_test_instance" down --root "$tree"

rm -rf "$tree/docs/node_modules" "$tree/local/custom-gcl" "$tree/local/custom-gcl.sum" "$tree/local/komradslot" "$tree"/local/buf-plugin-*
