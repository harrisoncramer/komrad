#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
set -euo pipefail
#MISE description="Build the control plane and engine AMIs with Packer."

usage() {
	echo "Usage: mise run packer:build [-- <packer args>]"
	echo
	echo "Builds the control plane image and the engine image in AWS and prints each one's id."
	echo "Each image is tagged with the revision baked into it, and with KOMRAD_VERSION when"
	echo "one is set. Neither says what the instance ends up running: the binary is replaced"
	echo "on the next deploy. dist/packer-manifest.json records both ids."
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	esac
done

cd "$MISE_CONFIG_ROOT"

REVISION="$(git rev-parse --short HEAD)"
VERSION="${KOMRAD_VERSION:-v0.0.0-ami.$REVISION}"
MANIFEST="$MISE_CONFIG_ROOT/dist/packer-manifest.json"

go_build_binary linux arm64 "$VERSION" dist/komrad-linux-arm64
rm -f "$MANIFEST"

cd packer

packer init .
packer build \
	-var "komrad_revision=$REVISION" \
	-var "komrad_version=$VERSION" \
	"$@" \
	.

jq -r '.builds[] | "\(.custom_data.image): \(.artifact_id | split(":") | last)"' "$MANIFEST"
