...@_theme

direction: right

local: On your laptop {
  class: group

  panel: Panel {class: leaf}
  serve: Server {class: leaf}
  agents: Agents {class: leaf}
  postgres: Postgres {class: store}

  panel -> serve
  serve -> agents
  serve -> postgres
}

remote: On a remote engine {
  class: group

  panel: Panel {class: leaf}

  host: Engine host {
    class: group
    serve: Server {class: leaf}
    agents: Agents {class: leaf}
    serve -> agents
  }

  postgres: Postgres {class: store}

  panel -> host.serve: HTTPS
  host.serve -> postgres
}

local -> remote {style.opacity: 0}
