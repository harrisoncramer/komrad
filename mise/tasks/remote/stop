#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
source "$MISE_CONFIG_ROOT/mise/tasks/remote/_remote_utils"
set -euo pipefail
#MISE description="Stop every running engine, which stops every agent on them and stops the bill."

usage() {
	echo "Usage: mise run remote:stop [--yes]"
	echo
	echo "Stops every engine's instance that is running. Every agent on them stops too, and"
	echo "the turn each one was part way through is lost. The data volumes, the database and"
	echo "the addresses all survive, so each person starts their engine again from the panel."
	echo "The control plane keeps running."
	echo
	echo "It asks first. Pass --yes to skip the question, which is what the schedule does."
	echo
	echo "Uses the komrad AWS profile, unless the environment already carries credentials."
}

ASSUME_YES=false

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	--yes | -y)
		ASSUME_YES=true
		;;
	*)
		usage >&2
		exit 1
		;;
	esac
done

cd "$MISE_CONFIG_ROOT"

use_komrad_aws_profile

REGION="$(engine_region)"
LISTED="$(instances)"

if [ -z "$LISTED" ]; then
	echo "could not read the instances from Terraform, so nothing was stopped." >&2
	exit 1
fi

RUNNING=()
NAMES=()

while read -r name instance; do
	if [ "$(instance_state "$instance" "$REGION")" = running ]; then
		RUNNING+=("$instance")
		NAMES+=("$name")
	fi
done < <(engines)

if [ "${#RUNNING[@]}" -eq 0 ]; then
	gum log --level info "no engine is running"
	exit 0
fi

if [ "$ASSUME_YES" != true ]; then
	gum confirm "Stop ${NAMES[*]}? Whatever agents are running on them stop too." || {
		gum log --level info "left the engines running"
		exit 0
	}
fi

gum log --level info "stopping ${NAMES[*]}"

aws ec2 stop-instances --region "$REGION" --instance-ids "${RUNNING[@]}" >/dev/null
aws ec2 wait instance-stopped --region "$REGION" --instance-ids "${RUNNING[@]}"

gum log --level info "stopped ${NAMES[*]}"
