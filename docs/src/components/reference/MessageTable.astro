---
import Heading from "./Heading.astro";
import Required from "./Required.astro";
import { anchor, api, prose } from "../../reference";
import { codeLink } from "../../reference/refs";
import { describeConstraints } from "../../reference/constraints";
import type { Field, Message, Oneof } from "../../reference/types";

type Props = {
  name: string;
  message: Message;
};

type Row = { field: Field; member: boolean } | { oneof: Oneof };

const { name, message } = Astro.props;
const id = anchor(name);
const tone = (type: string) => (/int|fixed|float|double/.test(type) ? "number" : type);
const typeName = (field: Field) => (field.repeated && !field.map ? `${field.type}[]` : field.type);
const rules = (field: Field) => describeConstraints(field.constraints, field.required);
const inMessage = codeLink({ messages: [name] });
const forField = (field: Field) => codeLink({ messages: [name], enum: api.enums[field.ref] ? field.ref : undefined });

const rows: Row[] = [];
const drawn = new Set<string>();
for (const field of message.fields) {
  if (!field.oneof) {
    rows.push({ field, member: false });
    continue;
  }
  if (drawn.has(field.oneof)) continue;
  drawn.add(field.oneof);

  const oneof = message.oneofs.find((candidate) => candidate.name === field.oneof);
  if (!oneof) throw new Error(`api.json has no oneof ${field.oneof} on ${name}`);
  rows.push({ oneof });
  for (const member of message.fields.filter((candidate) => candidate.oneof === field.oneof)) {
    rows.push({ field: member, member: true });
  }
}
---

<section class="type">
  <Heading id={id} level={3}>
    {message.name}
  </Heading>
  {message.description && <div class="type-description" set:html={prose(message.description, inMessage)} />}
  {message.fields.length === 0 ? (
    <p class="empty">No fields.</p>
  ) : (
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Field</th>
            <th>Type</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) =>
            "oneof" in row ? (
              <tr id={`${id}-${row.oneof.name}`} class="oneof">
                <td>
                  <a class="row-anchor oneof-name" href={`#${id}-${row.oneof.name}`}>
                    one of
                  </a>
                  {row.oneof.required && <Required />}
                </td>
                <td></td>
                <td>{row.oneof.description && <Fragment set:html={prose(row.oneof.description, inMessage)} />}</td>
              </tr>
            ) : (
              <tr id={`${id}-${row.field.name}`} class={row.member ? "oneof-member" : undefined}>
                <td>
                  <a class="row-anchor" href={`#${id}-${row.field.name}`}>
                    <code>{row.field.name}</code>
                  </a>
                </td>
                <td class="type-cell" data-sep="">
                  {row.field.map && "map of "}
                  {row.field.ref ? (
                    <a href={`#${anchor(row.field.ref)}`}>{typeName(row.field)}</a>
                  ) : (
                    <span class="type-name" data-tone={tone(row.field.type)}>
                      {typeName(row.field)}
                    </span>
                  )}
                  {row.field.required && <Required />}
                  {rules(row.field).map((rule) => (
                    <p class="rules">{rule}</p>
                  ))}
                </td>
                <td>
                  {row.field.description && <Fragment set:html={prose(row.field.description, forField(row.field))} />}
                </td>
              </tr>
            ),
          )}
        </tbody>
      </table>
    </div>
  )}
</section>
