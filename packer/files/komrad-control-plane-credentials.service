[Unit]
Description=Make each engine's login and grant, and write the control plane's config
Before=komrad-control-plane.service
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/komrad/control-plane.env

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/komrad-control-plane-credentials

[Install]
WantedBy=multi-user.target
