#!/usr/bin/env bash
# Building weave, with nothing exported, so a task that starts a server can source it too.

tree_is_dirty() {
	[ -n "$(git status --porcelain)" ]
}

# The toolchain records no revision when it is built from a git worktree, so the commit is
# stamped in the same way the version is.
build_commit() {
	if ! git rev-parse --git-dir >/dev/null 2>&1 || tree_is_dirty; then
		return 0
	fi

	git rev-parse HEAD
}

# admin is weave's internal tooling, built on demand because it is part of this repository
# rather than a pinned tool. It is a module of its own, so nothing in it reaches the binary
# people install.
admin() {
	local bin="$MISE_CONFIG_ROOT/local/admin"
	local src="$MISE_CONFIG_ROOT/tools/admin"

	if [ ! -x "$bin" ] || [ -n "$(find "$src" -type f -newer "$bin" -print -quit 2>/dev/null)" ]; then
		mkdir -p "$MISE_CONFIG_ROOT/local"
		(cd "$src" && go build -o "$bin" .)
	fi

	"$bin" "$@"
}

go_build_binary() {
	local os="$1" arch="$2" version="$3" out="$4"
	local commit
	commit="$(build_commit)"

	CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" go build \
		-trimpath \
		-ldflags "-s -w -X weave/internal/version.stamped=$version -X weave/internal/version.stampedCommit=$commit" \
		-o "$out" .
}

# A build for this machine, which takes its version from the toolchain and only its commit
# from here.
go_build_local() {
	local out="$1"
	local commit
	commit="$(build_commit)"

	go build -ldflags "-X weave/internal/version.stampedCommit=$commit" -o "$out" .
}
