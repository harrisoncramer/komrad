#!/usr/bin/env bash
#MISE description="Start the local Postgres, apply migrations, and give the default engine its logins."
set -euo pipefail
source "$MISE_CONFIG_ROOT/mise/tasks/_"

cd "$MISE_CONFIG_ROOT"
if [ "${MISE_ENV:-}" = test ]; then
	docker compose -f docker-compose.yml -f docker-compose.test.yml up -d --wait --no-recreate db dex
	test_database_create
else
	docker compose up -d --wait db
fi
mise run db:apply

KOMRAD_ENGINE_PASSWORD=komrad go run . engine ensure "${KOMRAD_TEST_ENGINE:-default}" >/dev/null
