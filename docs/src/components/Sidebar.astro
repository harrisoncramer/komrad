---
import { SECTIONS } from "../consts";
import { getPages } from "../pages";

const current = Astro.url.pathname.replace(/\/+$/, "");

const sections = await Promise.all(
  SECTIONS.map(async (section) => ({
    ...section,
    pages: await getPages(section.id),
  })),
);
---

<aside class="sidebar" data-pagefind-ignore>
  <nav aria-label="Sections">
    {
      sections.map((section) => (
        <div class="section">
          <a
            href={`/${section.id}`}
            class="heading"
            aria-current={current === `/${section.id}` ? "page" : undefined}
          >
            {section.title}
          </a>
          {section.pages.length > 0 && (
            <ul class="pages">
              {section.pages.map((page) => {
                const href = `/${section.id}/${page.id}`;
                return (
                  <li>
                    <a href={href} class="page" aria-current={current === href ? "page" : undefined}>
                      {page.data.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
        </div>
      ))
    }
  </nav>
</aside>

<style>
  @reference "../styles/global.css";

  .sidebar {
    @apply sticky top-20 hidden h-[calc(100vh-6rem)] w-52 shrink-0 overflow-y-auto pt-4 md:block;
  }

  .section + .section {
    @apply mt-8;
  }

  .heading {
    @apply block text-base text-app-white;
    font-family: var(--font-playfair);
  }

  .heading[aria-current="page"] {
    @apply text-app-blue;
  }

  .pages {
    @apply mt-3 flex flex-col gap-1 border-l border-app-background-medium;
  }

  .pages li {
    font-size: inherit;
  }

  .page {
    @apply -ml-px block border-l-2 border-transparent py-1 pl-3 text-sm text-app-gray-light transition-colors duration-200;
    font-family: var(--font-lora);
  }

  .page:hover,
  .page:focus-visible {
    @apply text-app-white;
  }

  .page[aria-current="page"] {
    @apply border-app-blue text-app-blue;
  }
</style>
