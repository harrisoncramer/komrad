#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_build"
#MISE description="Rebuild, then kill and restart the server and the panel, leaving agents stopped."
set -euo pipefail
cd "$MISE_CONFIG_ROOT"

weave="$MISE_CONFIG_ROOT/bin/weave"

socket="${WEAVE_TMUX_SOCKET:-weave}"
addr="${WEAVE_ADDR:-127.0.0.1:8787}"

go_build_local "$weave"

agents="$( (tmux -L "$socket" list-panes -a -F x 2>/dev/null || true) | wc -l | tr -d ' ')"

tmux -L "$socket" kill-server 2>/dev/null || true

if ! "$weave" stop; then
	pkill -f "weave serve --addr $addr" 2>/dev/null || true
fi

"$weave" migrate

case "${WEAVE_DATABASE_URL:-weave_engine_default:weave@}" in
*weave_engine_default:weave@*) WEAVE_ENGINE_PASSWORD=weave "$weave" engine ensure default >/dev/null ;;
esac

if ! "$weave" start; then
	echo "warning: the server did not come up, so open the panel to see why" >&2
	echo "killed $agents panes; the server is not running"
	exit 1
fi

if ! "$weave" open --detach; then
	echo "warning: the panel session did not come up" >&2
	exit 1
fi

bind_panel_key "$weave"

# Runs weave with the connection read from the engine file alone.
engine_weave() {
	env -u WEAVE_ADDR -u WEAVE_TMUX_SOCKET -u WEAVE_DATABASE_URL -u WEAVE_READONLY_DATABASE_URL \
		-u WEAVE_OWNER_DATABASE_URL -u WEAVE_CACHE_DIR -u WEAVE_DATABASE_PASSWORD_COMMAND \
		"$weave" "$@"
}

# Replaces the server of every other engine on this machine.
engines_dir="$HOME/.config/weave/engines"
if [ "${MISE_ENV:-}" != test ] && [ -d "$engines_dir" ]; then
	for file in "$engines_dir"/*.toml; do
		[ -e "$file" ] || continue
		if grep -Eq '^[[:space:]]*(ssh|exec)[[:space:]]*=' "$file"; then
			continue
		fi

		name="$(basename "$file" .toml)"
		engine_weave stop --engine "$name" 2>/dev/null || true
		if ! engine_weave start --engine "$name"; then
			echo "warning: the $name engine's server did not come up" >&2
		fi
	done
fi

echo "killed $agents panes and restarted the server; press prefix+g for the panel"
