#!/usr/bin/env bash
set -euo pipefail

# Explainer: this is everything the host cannot know until Terraform has built it.
#
# The machine image carries the scripts, the units and the toolchain, so almost nothing
# is installed at boot. What the image cannot contain is the identity of the volume and
# the database this particular instance was given, because those are created by the same
# Terraform run that creates the instance. Writing them here is the handover.
#
# The units below are enabled in the image, so they also try to run earlier in the boot,
# before these files exist. They are written to skip cleanly in that case, and starting
# them here is what actually runs them once the files are in place.

mkdir -p /etc/komrad

echo "KOMRAD_DATA_VOLUME_ID=${data_volume_id}" >/etc/komrad/data-volume.env

# Only the name of the secret travels here, never its value. User data is readable by anything
# on the instance that can reach the metadata service, so it carries nothing that has to stay secret.
cat >/etc/komrad/database-source.env <<ENV
KOMRAD_DATABASE_SECRET_ARN=${database_secret_arn}
KOMRAD_DATABASE_HOST=${database_host}
KOMRAD_DATABASE_NAME=${database_name}
AWS_REGION=${aws_region}
ENV

# Order matters. The volume has to be mounted before komrad can use it, and the password
# has to be fetched before komrad can start, so each is started in turn rather than left
# to systemd's own ordering.
systemctl start komrad-data-volume.service

%{ if sign_in_issuer != "" ~}
cat >/etc/komrad/sign-in.toml <<'TOML'
[sign_in]
issuer = ${jsonencode(sign_in_issuer)}
client_id = ${jsonencode(sign_in_client_id)}
client_secret = ${jsonencode(sign_in_client_secret)}
TOML
%{ else ~}
: >/etc/komrad/sign-in.toml
%{ endif ~}

systemctl start komrad-database-credentials.service
systemctl start komrad.service

cat >/etc/komrad/tailscale.env <<ENV
KOMRAD_TAILSCALE_STATE=${tailscale_state_arn}
KOMRAD_TAILSCALE_HOSTNAME=${tailscale_hostname}
KOMRAD_TAILSCALE_NAME=${tailscale_name}
KOMRAD_TAILSCALE_SECRET_ID=${tailscale_auth_key_secret}
AWS_REGION=${aws_region}
ENV

systemctl start komrad-tailscale.service

install -d -m 700 /var/lib/komrad/caddy
chown -R caddy:caddy /var/lib/komrad/caddy
cat >/etc/caddy/Caddyfile <<CADDYFILE
{
	storage file_system /var/lib/komrad/caddy
	grace_period 10s
}

${tailscale_name} {
	reverse_proxy h2c://127.0.0.1:8788
}
CADDYFILE
systemctl enable --now caddy.service
