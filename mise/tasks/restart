#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_build"
#MISE description="Rebuild, then kill and restart the server and the panel, leaving agents stopped."
set -euo pipefail
cd "$MISE_CONFIG_ROOT"

komrade="$MISE_CONFIG_ROOT/bin/komrade"

socket="${KOMRADE_TMUX_SOCKET:-komrade}"
addr="${KOMRADE_ADDR:-127.0.0.1:8787}"

go_build_local "$komrade"

agents="$( (tmux -L "$socket" list-panes -a -F x 2>/dev/null || true) | wc -l | tr -d ' ')"

tmux -L "$socket" kill-server 2>/dev/null || true

if ! "$komrade" stop; then
	pkill -f "komrade serve --addr $addr" 2>/dev/null || true
fi

"$komrade" migrate

case "${KOMRADE_DATABASE_URL:-komrade_engine_default:komrade@}" in
*komrade_engine_default:komrade@*) KOMRADE_ENGINE_PASSWORD=komrade "$komrade" engine ensure default >/dev/null ;;
esac

if ! "$komrade" start; then
	echo "warning: the server did not come up, so open the panel to see why" >&2
	echo "killed $agents panes; the server is not running"
	exit 1
fi

if ! "$komrade" open --detach; then
	echo "warning: the panel session did not come up" >&2
	exit 1
fi

bind_panel_key "$komrade"

# Runs komrade with the connection read from the engine file alone.
engine_komrade() {
	env -u KOMRADE_ADDR -u KOMRADE_TMUX_SOCKET -u KOMRADE_DATABASE_URL -u KOMRADE_READONLY_DATABASE_URL \
		-u KOMRADE_OWNER_DATABASE_URL -u KOMRADE_CACHE_DIR \
		"$komrade" "$@"
}

# Replaces the server of every other engine on this machine.
engines_dir="$HOME/.config/komrade/engines"
if [ "${MISE_ENV:-}" != test ] && [ -d "$engines_dir" ]; then
	for file in "$engines_dir"/*.toml; do
		[ -e "$file" ] || continue
		if grep -Eq '^[[:space:]]*(ssh|exec)[[:space:]]*=' "$file"; then
			continue
		fi

		name="$(basename "$file" .toml)"
		engine_komrade stop --engine "$name" 2>/dev/null || true
		if ! engine_komrade start --engine "$name"; then
			echo "warning: the $name engine's server did not come up" >&2
		fi
	done
fi

echo "killed $agents panes and restarted the server; press prefix+g for the panel"
