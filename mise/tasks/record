#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
#MISE description="Record the throwaway instance from a VHS tape, to a video, a gif and a still."
set -euo pipefail

usage() {
	echo "Usage: MISE_ENV=test mise run record <tape> [--out dir]"
	echo
	echo "Runs the tape with VHS against the throwaway instance, after"
	echo "recordings/settings.tape, which sets the size, the font and the docs site's"
	echo "colours. recording.mp4, recording.webm, recording.gif and last.png, the final"
	echo "frame, land under local/recordings/<tape name>/ unless --out says otherwise."
	echo
	echo "The tape runs in a bash of its own, with this checkout's komrad first on the"
	echo "path. A tape that starts in a shell sources recordings/shell.tape, and one that"
	echo "starts on the panel sources recordings/panel.tape. Tapes live under recordings/."
	echo
	echo "It needs the instance up, which 'MISE_ENV=test mise run restart' does, and ttyd,"
	echo "which mise cannot install on macOS; install it with nix or Homebrew. It refuses"
	echo "to run against any tmux socket but komrad-test."
}

TAPE=""
OUT=""

while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--out)
		OUT="${2:-}"
		shift 2
		;;
	*)
		TAPE="$1"
		shift
		;;
	esac
done

if [ "${KOMRAD_TMUX_SOCKET:-}" != "komrad-test" ]; then
	echo "record: KOMRAD_TMUX_SOCKET is '${KOMRAD_TMUX_SOCKET:-}', not komrad-test; run it as MISE_ENV=test mise run record" >&2
	exit 1
fi

if [ -z "$TAPE" ]; then
	usage >&2
	exit 1
fi

if ! command -v ttyd >/dev/null; then
	echo "record: VHS needs ttyd, which mise cannot install on macOS; install it with nix or Homebrew" >&2
	exit 1
fi

case "$TAPE" in
/*) ;;
*) TAPE="$MISE_ORIGINAL_CWD/$TAPE" ;;
esac

cd "$MISE_CONFIG_ROOT"

if [ -z "$OUT" ]; then
	OUT="local/recordings/$(basename "$TAPE" .tape)"
fi

case "$OUT" in
/*) ;;
*) OUT="$MISE_CONFIG_ROOT/$OUT" ;;
esac

rm -rf "$OUT"
mkdir -p "$OUT"

cat >"$OUT/run.tape" <<TAPE
Source "recordings/settings.tape"
Source "$TAPE"
Sleep 1s
Screenshot "$OUT/last.png"
TAPE

env -u TMUX -u TMUX_PANE PATH="$MISE_CONFIG_ROOT/bin:$PATH" \
	vhs --quiet \
	--output "$OUT/recording.mp4" \
	--output "$OUT/recording.webm" \
	--output "$OUT/recording.gif" \
	"$OUT/run.tape"

if [ ! -s "$OUT/recording.mp4" ]; then
	echo "record: VHS wrote no video for $TAPE" >&2
	exit 1
fi

if [ ! -s "$OUT/last.png" ]; then
	ffmpeg -v error -y -sseof -0.1 -i "$OUT/recording.mp4" -frames:v 1 "$OUT/last.png"
fi

gum log --level info "recorded $(basename "$TAPE" .tape) into $OUT"
