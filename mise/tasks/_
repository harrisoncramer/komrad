#!/usr/bin/env bash
# Shared helpers for mise tasks. Sourced, not run directly.
#
# Host-side tasks that reach the database (Atlas, sqlc's dev container, psql)
# read DATABASE_URL from the environment. When it is not set they fall back to
# the local docker-compose Postgres, so a plain checkout works after
# `mise run docker:up` with nothing else exported. A deployed environment sets
# DATABASE_URL to its own instance and never uses the fallback.
: "${DB_PORT:=5460}"
export DB_PORT
export DATABASE_URL="${DATABASE_URL:-postgres://weave:weave@localhost:${DB_PORT}/weave?sslmode=disable}"

# adminURL rewrites DATABASE_URL to point at the server's default database,
# which is where a throwaway test database has to be created from since you
# cannot create a database while connected to the one being replaced.
adminURL() {
	echo "${DATABASE_URL%/*}/postgres?sslmode=disable"
}

# shell_scripts lists every shell script the repo owns, one per line. The scripts
# have no extension, so they are found by what `file` says they are rather than by
# name, and the tmux entry point is named explicitly because it lives at the root.
shell_scripts() {
	find mise/tasks scripts -type f -exec file {} + | grep -i 'shell script' | cut -d: -f1
	echo "weave.tmux"
}
