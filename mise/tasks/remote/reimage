#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
source "$MISE_CONFIG_ROOT/mise/tasks/remote/_remote_utils"
set -euo pipefail
#MISE description="Rebuild the engine from a machine image, which stops every agent on it."

usage() {
	echo "Usage: mise run remote:reimage [ami-id] [-- <terraform args>]"
	echo
	echo "Moves the engine to a machine image and applies it, which replaces the instance."
	echo "Every agent on the box stops and does not come back."
	echo
	echo "With no argument it uses the image CI last built. CI records one whenever something"
	echo "under packer/ reaches main, and never applies it, because applying is this."
	echo
	echo "  mise run remote:reimage"
	echo "  mise run remote:reimage ami-0123456789abcdef0"
	echo "  mise run remote:reimage -- -auto-approve"
	echo
	echo "Needs AWS credentials in the environment, as AWS_PROFILE or the access key variables."
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	esac
done

cd "$MISE_CONFIG_ROOT"

require_aws_profile

REGION="$(require_output aws_region)"
CURRENT="$(require_output instance_ami)"

AMI=""
TERRAFORM_ARGS=()

for arg in "$@"; do
	case "$arg" in
	ami-*)
		AMI="$arg"
		;;
	*)
		TERRAFORM_ARGS+=("$arg")
		;;
	esac
done

if [ -z "$AMI" ]; then
	PARAMETER="$(require_output ami_parameter)"

	if ! AMI="$(aws ssm get-parameter --region "$REGION" --name "$PARAMETER" \
		--query Parameter.Value --output text 2>/dev/null)"; then
		echo "nothing is recorded at $PARAMETER, so there is no image to move to." >&2
		echo >&2
		echo "CI writes that when something under packer/ reaches main. Build one with" >&2
		echo "'mise run packer:build' and pass the id, or name an image yourself." >&2
		exit 1
	fi
fi

if [ "$CURRENT" = "$AMI" ]; then
	gum log --level info "the engine is already on $AMI"
	exit 0
fi

if ! aws ec2 describe-images --region "$REGION" --image-ids "$AMI" \
	--query 'Images[0].State' --output text 2>/dev/null | grep -q available; then
	echo "$AMI is not an image this account can use in $REGION" >&2
	exit 1
fi

gum log --level info "moving the engine from $CURRENT to $AMI"

# Read before the instance goes, since afterwards there is nothing to ask.
AGENTS="$(mise run remote:connect -- \
	'tmux -L komrade list-windows -a -F "#{window_name}" 2>/dev/null | sort -u | grep -v "^sh$"' 2>/dev/null || true)"

if [ -n "$AGENTS" ]; then
	echo
	echo "These agents are running on the engine and will stop:"

	while IFS= read -r agent; do
		echo "  $agent"
	done <<<"$AGENTS"

	echo
fi

if ! printf '%s\n' "$@" | grep -q -- "-auto-approve"; then
	gum confirm "Replace the instance with $AMI?" || {
		gum log --level info "left the engine as it is"
		exit 0
	}
fi

python3 - "$AMI" <<'PY'
import re
import sys

path, ami = "infra/terraform/terraform.tfvars", sys.argv[1]
text = open(path).read()
updated, count = re.subn(
    r'(^[ \t]*ami_id[ \t]*=[ \t]*)"[^"]*"',
    lambda match: match.group(1) + '"' + ami + '"',
    text,
    count=1,
    flags=re.M,
)

if count != 1:
    sys.exit("no ami_id line to change in " + path)

open(path, "w").write(updated)
PY

terraform -chdir=infra/terraform apply -input=false "${TERRAFORM_ARGS[@]+"${TERRAFORM_ARGS[@]}"}"

# The address outlives the instance, so what answers on it now has a host key nothing has seen
# before. Anything still holding the old one refuses to connect until it is dropped, and a shared
# ssh connection to an instance that no longer exists does the same.
HOST="$(terraform_output instance_public_ip)"

if [ -n "$HOST" ]; then
	rm -f "/tmp/cm-komrade-komrade@$HOST:22"
	ssh-keygen -R "$HOST" >/dev/null 2>&1 || true
	ssh-keygen -R "$HOST" -f "${KOMRADE_ENGINE_KNOWN_HOSTS:-$HOME/.ssh/known_hosts_komrade_engine}" >/dev/null 2>&1 || true

	gum log --level info "dropped the old host key for $HOST"
fi

gum log --level info "the engine is on $AMI, rebuilt from the image"
echo "  mise run remote:connect -- 'systemctl list-units --state=failed --no-legend | wc -l'"
