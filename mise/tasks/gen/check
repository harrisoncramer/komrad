#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
set -euo pipefail
#MISE description="Rerun every generator and fail if the checked-in output moved."

usage() {
	echo "Usage: mise run gen:check"
	echo
	echo "Checks that every resource the protos declare has its queries and its"
	echo "renderer, then reruns the sqlc, buf, config, and command reference"
	echo "generators and fails if any of their committed output changed. Skips the"
	echo "comparison when those paths already differ from HEAD, since then a"
	echo "difference says nothing about whether the generators are in sync."
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	esac
done

cd "$MISE_CONFIG_ROOT"

go run ./cmd/check-resources

GENERATED=(config.toml db/models proto/gen docs/reference)

generated_changes() {
	git status --porcelain -- "${GENERATED[@]}"
}

if [ -n "$(generated_changes)" ]; then
	echo "warning: generated paths already differ from HEAD; skipping the drift check"
	echo "         (${GENERATED[*]})"
	exit 0
fi

mise run db:sqlc
mise run proto:generate
mise run gen:config
mise run gen:docs

if [ -n "$(generated_changes)" ]; then
	echo "generated files are out of date; commit the regenerated output:" >&2
	generated_changes >&2
	exit 1
fi

echo "generated files up to date"
