#!/usr/bin/env bash
set -euo pipefail

if [ $# -ne 2 ] || { [ "$1" != grant ] && [ "$1" != revoke ]; }; then
	echo "usage: komrad-access grant|revoke EMAIL" >&2
	exit 2
fi

# shellcheck source=/dev/null
. /etc/komrad/database-source.env

owner="$(komrad-owner-database-url)"

HOME="${HOME:-/root}" KOMRAD_OWNER_DATABASE_URL="$owner" komrad engine "$1" "${KOMRAD_ENGINE_NAME:-default}" "$2"
