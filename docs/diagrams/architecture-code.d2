...@_theme

grid-rows: 4
grid-columns: 3
grid-gap: 80

blank1: "" {style.opacity: 0}
ui: "ui\na client, talks\nover Connect only"
blank2: "" {style.opacity: 0}
cli
server
handlers: "rpc, mcp\nhandlers"
postgres: Postgres {shape: cylinder}
store
services: "services\nagents, mail,\nreviews, ..."
blank3: "" {style.opacity: 0}
world: the outside world {style.stroke-dash: 3}
adapters: "adapters\ngit, tmux,\nharness, forge"

cli -> server -> handlers -> services
services -> store -> postgres
services -> adapters -> world
ui -> server: Connect {style.stroke-dash: 3}
