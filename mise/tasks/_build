#!/usr/bin/env bash
# Building weave, with nothing exported, so a task that starts a server can source it too.

tree_is_dirty() {
	[ -n "$(git status --porcelain)" ]
}

# The toolchain records no revision when it is built from a git worktree, so the commit is
# stamped in the same way the version is.
build_commit() {
	if ! git rev-parse --git-dir >/dev/null 2>&1 || tree_is_dirty; then
		return 0
	fi

	git rev-parse HEAD
}

dirty_suffix() {
	echo "+dirty.$(date +%H%M%S)"
}

local_version() {
	if ! git rev-parse --git-dir >/dev/null 2>&1 || ! tree_is_dirty; then
		return 0
	fi

	echo "v0.0.0-local.$(git rev-parse --short HEAD)$(dirty_suffix)"
}

go_build_binary() {
	local os="$1" arch="$2" version="$3" out="$4"
	local commit
	commit="$(build_commit)"

	CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" go build \
		-trimpath \
		-ldflags "-s -w -X weave/internal/version.stamped=$version -X weave/internal/version.stampedCommit=$commit" \
		-o "$out" .
}

# A build for this machine, which takes its version from the toolchain unless the tree is
# dirty, and only its commit from here.
go_build_local() {
	local out="$1"
	local version commit
	version="$(local_version)"
	commit="$(build_commit)"

	go build -ldflags "-X weave/internal/version.stamped=$version -X weave/internal/version.stampedCommit=$commit" -o "$out" .
}

bind_panel_key() {
	local weave="$1"

	if [ -n "${WEAVE_TMUX_SOCKET:-}" ] || [ "$(git rev-parse --git-common-dir)" != ".git" ]; then
		return 0
	fi

	"$weave" tmux --if-running
}

custom_gcl_sum() {
	find tools/weavelint .custom-gcl.yml -type f -print0 | LC_ALL=C sort -z | xargs -0 git hash-object | git hash-object --stdin
}

build_custom_gcl() {
	local sum
	sum="$(custom_gcl_sum)"
	golangci-lint custom
	echo "$sum" >local/custom-gcl.sum
}
