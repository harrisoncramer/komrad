#!/usr/bin/env bash

# Explainer: what every remote task needs to know, asked of the thing that knows it.
#
# Terraform built the engine, so Terraform is what says where it is. Reading its outputs keeps
# these tasks agreeing with the infrastructure rather than with a copy of it, and means none of
# them has to read the files an operator edits.
#
# The AWS profile is not one of those things. It is a credential choice belonging to whoever is
# running the command, so it comes from the environment like it does for every other AWS tool.

require_aws_profile() {
	if [ -n "${AWS_PROFILE:-}" ] || [ -n "${AWS_ACCESS_KEY_ID:-}" ] || [ -n "${AWS_SESSION_TOKEN:-}" ]; then
		return 0
	fi

	echo "no AWS credentials in the environment." >&2
	echo >&2
	echo "Export AWS_PROFILE, or whichever of AWS_ACCESS_KEY_ID and friends you use:" >&2
	echo >&2
	echo "  export AWS_PROFILE=your-profile" >&2
	exit 1
}

terraform_output() {
	local name=$1

	if [ ! -d infra/terraform/.terraform ] && [ -f infra/terraform/backend.hcl ]; then
		terraform -chdir=infra/terraform init \
			-backend-config=backend.hcl -input=false >/dev/null 2>&1 || true
	fi

	terraform -chdir=infra/terraform output -raw "$name" 2>/dev/null
}

# terraform_output_list reads an output holding a list, which -raw refuses to print.
terraform_output_list() {
	local name=$1

	terraform -chdir=infra/terraform output -json "$name" 2>/dev/null |
		jq -r 'join(" ")' 2>/dev/null || true
}

# refuse_unreachable says why a connection will not be made, since a firewall that drops a packet
# looks the same from here as a box that is not running.
refuse_unreachable() {
	local host=$1 mine allowed

	if nc -z -G 5 "$host" 22 2>/dev/null; then
		return 0
	fi

	mine="$(public_address)"
	allowed="$(terraform_output_list ssh_allowed_cidrs)"

	echo "nothing on $host is answering ssh from this machine." >&2
	echo >&2
	echo "  this machine looks like  ${mine:-could not tell}" >&2
	echo "  the firewall allows      ${allowed:-nothing}" >&2
	echo >&2

	if [ -n "$mine" ] && [ -n "$allowed" ] && ! printf '%s' "$allowed" | grep -qF "$mine"; then
		echo "Your address is not one of those, which is what happens after you change network." >&2
		echo "Add it with:" >&2
		echo >&2
		echo "  mise run remote:allow" >&2
	else
		echo "Your address is allowed, so the engine itself is not answering. Check it is running." >&2
	fi

	exit 1
}

# require_output reads one output, and says what to do when there is no infrastructure to read.
require_output() {
	local name=$1 value

	value="$(terraform_output "$name")"

	if [ -z "$value" ]; then
		echo "could not read $name from Terraform, so there is no engine to work with." >&2
		echo >&2
		echo "Run 'mise run terraform:apply' to build one, or set the matching WEAVE_ENGINE_*" >&2
		echo "variable to skip Terraform entirely." >&2
		exit 1
	fi

	echo "$value"
}
