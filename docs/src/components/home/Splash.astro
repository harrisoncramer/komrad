---
import { REPO_URL } from "../../consts";
import { link } from "../../site";

const WORDS = [
  "APIs",
  "microservices",
  "data pipelines",
  "CLIs",
  "SDKs",
  "integrations",
  "test suites",
  "dashboards",
  "infrastructure",
  "mobile apps",
];
---

<figure class="splash">
  <div class="media">
    <picture>
      <source media="(max-width: 767.98px)" srcset={link("/splash/splash-960.webp")} />
      <img
        src={link("/splash/splash.webp")}
        alt="The komrad panel: a list of agents grouped by project beside a live Claude session."
        width="1920"
        height="930"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <video
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      data-webm={link("/splash/splash.webm")}
      data-mp4={link("/splash/splash.mp4")}
    ></video>
    <div class="scrim" aria-hidden="true"></div>
  </div>
  <div class="overlay">
    <h1>
      <span class="sr-only">Build anything with komrad</span>
      <span aria-hidden="true">
        <span class="line">
          Build{" "}
          <span class="spin" data-spin data-words={JSON.stringify(WORDS)}>
            {WORDS[0]}
          </span>
        </span>{" "}
        <span class="rest">with komrad</span>
      </span>
    </h1>
    <p class="long">
      Run Claude and Codex agents side by side in tmux. Komrad keeps them organised, lets them talk, and remembers what
      they did.
    </p>
    <p class="short">Claude and Codex agents, side by side in tmux.</p>
    <div class="actions">
      <a class="primary" href={link("/guides/install")}>
        Get started
      </a>
      <a class="secondary" href={REPO_URL} target="_blank" rel="noreferrer">
        GitHub
      </a>
    </div>
  </div>
</figure>

<style>
  @reference "../../styles/global.css";

  .splash {
    @apply relative mx-auto mt-6 w-full max-w-[1920px] overflow-hidden md:mt-10;
    aspect-ratio: 1920 / 930;
  }

  .media {
    @apply absolute inset-0;
    mask-image:
      linear-gradient(to right, transparent, #000 5%, #000 95%, transparent),
      linear-gradient(to bottom, transparent, #000 10%, #000 55%, transparent);
    mask-composite: intersect;
  }

  @media (max-width: 767.98px) {
    .splash {
      @apply mt-2;
      aspect-ratio: 4 / 5;
    }

    .media {
      mask-image:
        linear-gradient(to right, #000 70%, transparent),
        linear-gradient(to bottom, transparent, #000 8%, #000 60%, transparent);
    }
  }

  .splash img,
  .splash video {
    @apply absolute inset-0 h-full w-full object-cover object-left-top;
  }

  .splash video {
    @apply opacity-0 transition-opacity duration-500;
  }

  .splash video[data-playing] {
    @apply opacity-100;
  }

  .scrim {
    @apply absolute inset-0;
    background:
      radial-gradient(ellipse 38% 36% at 50% 50%, rgba(8, 13, 26, 0.8), rgba(8, 13, 26, 0) 100%),
      radial-gradient(ellipse 55% 65% at 50% 50%, rgba(8, 13, 26, 0.55), rgba(8, 13, 26, 0.3) 80%);
  }

  @media (max-width: 767.98px) {
    .scrim {
      background:
        radial-gradient(ellipse 80% 40% at 50% 50%, rgba(8, 13, 26, 0.88), rgba(8, 13, 26, 0) 100%),
        rgba(8, 13, 26, 0.5);
    }
  }

  .overlay {
    @apply absolute inset-0 flex flex-col items-center justify-center px-6 text-center;
  }

  .overlay h1 {
    @apply text-[2rem] leading-[1.1] font-semibold tracking-tight md:text-5xl lg:text-[3.5rem];
    text-wrap: balance;
    background: linear-gradient(to bottom, #fff 35%, var(--color-app-gray-light));
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 18px rgba(158, 196, 255, 0.35));
  }

  .overlay p {
    text-wrap: balance;
    @apply mt-4 max-w-md text-base leading-relaxed text-app-gray md:max-w-2xl md:text-lg;
  }

  .spin {
    @apply text-app-blue;
    -webkit-text-fill-color: var(--color-app-blue);
    filter: drop-shadow(0 0 14px rgba(158, 196, 255, 0.45));
  }

  .overlay h1 .line {
    white-space: nowrap;
  }

  @media (max-width: 975.98px) {
    .overlay h1 .line,
    .overlay h1 .rest {
      display: block;
    }
  }

  @media (max-width: 767.98px) {
    .overlay h1 {
      font-size: clamp(1.5rem, 7.6vw, 2rem);
    }
  }

  .overlay .short {
    @apply hidden;
  }

  @media (max-width: 767.98px) {
    .overlay .long {
      @apply hidden;
    }

    .overlay .short {
      @apply block max-w-[20rem];
    }
  }

  .actions {
    @apply mt-8 flex gap-3;
  }

  .actions a {
    @apply rounded-md px-5 py-2.5 text-base font-medium no-underline transition-colors duration-200;
  }

  .primary {
    @apply bg-app-blue text-app-black hover:bg-app-white;
  }

  .secondary {
    @apply border border-app-gray/30 bg-app-black/40 text-app-white backdrop-blur-sm hover:border-app-blue/60;
  }
</style>

<script>
  const GLYPHS = "abcdefghijklmnopqrstuvwxyz#%&*+=<>/";
  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  async function scramble(node: HTMLElement, word: string) {
    const frames = 14;
    for (let frame = 0; frame <= frames; frame += 1) {
      const settled = Math.floor((word.length * frame) / frames);
      node.textContent = [...word]
        .map((char, index) =>
          index < settled || char === " " ? char : (GLYPHS[Math.floor(Math.random() * GLYPHS.length)] ?? char),
        )
        .join("");
      await sleep(40);
    }
  }

  const spin = document.querySelector<HTMLElement>("[data-spin]");
  const WORDS = JSON.parse(spin?.dataset.words ?? "[]") as string[];
  if (spin && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    void (async () => {
      for (let index = 1; ; index += 1) {
        await sleep(2400);
        const word = WORDS[index % WORDS.length] ?? "APIs";
        await scramble(spin, word);
      }
    })();
  }

  const video = document.querySelector<HTMLVideoElement>(".splash video");
  const wide = window.matchMedia("(min-width: 768px)");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (video && wide.matches && !still.matches) {
    for (const [type, attribute] of [
      ["video/webm", "webm"],
      ["video/mp4", "mp4"],
    ] as const) {
      const source = document.createElement("source");
      source.type = type;
      source.src = video.dataset[attribute] ?? "";
      video.append(source);
    }

    video.addEventListener(
      "playing",
      () => {
        video.dataset.playing = "";
      },
      { once: true },
    );
    video.load();
    void video.play().catch(() => undefined);
  }
</script>
