#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
set -euo pipefail
#MISE description="Hold struct declarations and literals to one field per line, with no blank lines between them."

usage() {
	echo "Usage: mise run go:structs"
	echo
	echo "Puts keyed struct literals onto one field per line and closes the blank"
	echo "lines between the fields of a struct, which read as a grouping nobody"
	echo "meant. It rewrites what it finds and then exits non-zero, so a tree that"
	echo "was already right passes and one that was not is fixed and reported."
	echo
	echo "Both codemods run even when the first has something to say, so one run"
	echo "lists everything that was wrong."
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	*)
		echo "unknown flag: $arg" >&2
		usage >&2
		exit 1
		;;
	esac
done

cd "$MISE_CONFIG_ROOT"

fixed=()

if ! go run ./cmd/structexpand .; then
	fixed+=("structexpand")
fi

if ! go run ./cmd/structgap .; then
	fixed+=("structgap")
fi

if ((${#fixed[@]} > 0)); then
	gum log --level error "rewrote the tree: ${fixed[*]}; review and commit the change"
	exit 1
fi
