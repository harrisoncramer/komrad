---
import type { Ref } from "../reference/refs";

type Props = {
  target: Ref;
};

const { target } = Astro.props;
---

<a class="ref" href={target.href}>
  <slot />
  <span class="ref-card" aria-hidden="true">
    <code>{target.title}</code>
    {target.description && <span>{target.description}</span>}
    {target.detail && <span class="ref-detail">{target.detail}</span>}
  </span>
</a>

<style>
  .ref {
    position: relative;
    text-decoration: none;
  }

  .ref-card {
    display: none;
  }

  .ref-detail {
    color: var(--color-app-gray);
    font-size: 0.9em;
  }

  @media (hover: hover) {
    .ref:hover .ref-card {
      position: absolute;
      bottom: calc(100% + 0.4rem);
      left: 0;
      z-index: 10;
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      width: max-content;
      max-width: 22rem;
      padding: 0.5rem 0.7rem;
      border: 1px solid var(--color-app-background-medium);
      border-radius: 6px;
      background: var(--color-app-background-medium-dark);
      color: var(--color-app-gray-light);
      font-size: 0.85rem;
      font-weight: normal;
      line-height: 1.4;
      white-space: normal;
    }
  }
</style>
