#!/usr/bin/env bash
# The throwaway instance a checkout tests against.
#
# Sourced for require_test_instance, or run as `_test_instance down --root <checkout>`.

test_instance_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"

# komradslot runs the slot tool, built once per source into the cache every checkout shares.
komradslot() {
	local bin="$test_instance_root/local/komradslot"
	local src="$test_instance_root/tools/komradslot"
	local key entry tmp
	key="$( (find "$src" -type f ! -name komradslot -print0 | LC_ALL=C sort -z | xargs -0 git hash-object && uname -sm) | git hash-object --stdin)"
	entry="${XDG_CACHE_HOME:-$HOME/.cache}/komrad-dev/komradslot/$key"
	touch -c "$entry"

	if [ ! -x "$entry" ]; then
		mkdir -p "$(dirname "$entry")"
		tmp="$(mktemp "$entry.XXXXXX")"
		if ! go build -C "$src" -o "$tmp" .; then
			rm -f "$tmp"
			return 1
		fi
		mv -f "$tmp" "$entry"
		find "$(dirname "$entry")" -mindepth 1 -maxdepth 1 -mtime +14 -exec rm -rf {} +
	fi

	if [ "$(readlink "$bin")" != "$entry" ]; then
		mkdir -p "$test_instance_root/local"
		ln -sfn "$entry" "$bin"
	fi

	"$bin" "$@"
}

forget_caller() {
	unset \
		KOMRAD_AGENT_ID \
		KOMRAD_SESSION_ID \
		CLAUDECODE \
		CLAUDE_CODE_SESSION_ID \
		CLAUDE_CODE_ENTRYPOINT \
		CLAUDE_CODE_EXECPATH \
		CLAUDE_CODE_CHILD_SESSION \
		CLAUDE_CODE_SESSION_ATTENDED \
		CLAUDE_CODE_MESSAGING_SOCKET \
		CLAUDE_CODE_MESSAGING_TOKEN \
		CLAUDE_EFFORT \
		CLAUDE_PID \
		CODEX_INTERNAL_ORIGINATOR_OVERRIDE
}

# require_test_instance refuses to go on under MISE_ENV=test unless the environment is exactly the
# one this checkout's slot derives.
require_test_instance() {
	[ "${MISE_ENV:-}" = test ] || return 0

	forget_caller

	komradslot check --root "$test_instance_root" || exit 1
}

# run_clean runs a command that outlives the task, under MISE_ENV=test, in a fresh terminal's
# environment plus the slot's, so nothing of the shell that ran the task reaches the instance's
# server or panes. A pane's shell otherwise reruns mise activate on the state it inherited and puts
# a live panel's address back, which sends the hooks of the instance's agents to the live server.
run_clean() {
	if [ "${MISE_ENV:-}" != test ]; then
		"$@"
		return
	fi

	local kept=() name path
	for name in HOME USER LOGNAME SHELL TERM COLORTERM LANG LC_ALL LC_CTYPE TMPDIR SSH_AUTH_SOCK \
		XDG_CONFIG_HOME XDG_CACHE_HOME XDG_DATA_HOME XDG_STATE_HOME CLAUDE_CONFIG_DIR CODEX_HOME MISE_ENV $(compgen -e | grep '^KOMRAD_'); do
		if [ -n "${!name+set}" ]; then
			kept+=("$name=${!name}")
		fi
	done

	path="$(tr ':' '\n' <<<"$PATH" | grep -v '/komrad-agent-tools$' | paste -sd: -)"

	env -i "${kept[@]}" PATH="$path" "$@"
}

# test_bin_dir holds the throwaway instance's build, apart from bin/komrad, which a live panel may run.
test_bin_dir() {
	echo "$test_instance_root/bin/test"
}

# komrad_bin is the binary a task builds and runs, the throwaway instance's under MISE_ENV=test.
komrad_bin() {
	if [ "${MISE_ENV:-}" = test ]; then
		echo "$(test_bin_dir)/komrad"
	else
		echo "$test_instance_root/bin/komrad"
	fi
}

# test_instance_holds_slot succeeds when some slot names the checkout.
test_instance_holds_slot() {
	local root
	root="$(cd "$1" && pwd -P)"

	grep -qxsF "$root" "$HOME/.local/state/komrad-test/instances"/*/root
}

# test_database_psql runs psql as the owner in the shared test container.
test_database_psql() {
	docker compose -p komrad-test-pg exec -T db psql -U komrad -d postgres -v ON_ERROR_STOP=1 "$@"
}

# test_database_create makes this checkout's database in the shared test container.
test_database_create() {
	local exists
	exists="$(test_database_psql -tAc "SELECT 1 FROM pg_database WHERE datname = '$KOMRAD_TEST_DATABASE'")"

	if [ "$exists" != 1 ]; then
		test_database_psql -c "CREATE DATABASE \"$KOMRAD_TEST_DATABASE\""
	fi
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
	set -euo pipefail

	if [ "${1:-}" = down ] && [ "${2:-}" = --root ] && ! test_instance_holds_slot "${3:?}"; then
		echo "komradslot: $3 holds no slot"
		exit 0
	fi

	komradslot "$@"
fi
