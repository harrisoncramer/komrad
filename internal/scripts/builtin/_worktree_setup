#!/bin/sh
#WEAVE description="Weave's own script for making an agent a worktree, run when its workflow's worktree toggle is on. Not yours to name or fire."
set -eu

repo="$WEAVE_WORKTREE_REPO"
tree="$WEAVE_WORKTREES_DIR/$WEAVE_AGENT_ID"

# The directory worktrees are made in can be pointed somewhere else while an agent is already
# provisioned, and the tree it holds is where its branch is checked out, so a resume goes back
# to that rather than to wherever worktrees live now. Holding a directory is not the claim: the
# launch path reaches a resume with the agent's cwd still set to whatever the workflow named
# when setup never got as far as replacing it, and taking that would put the agent inside the
# repository. Setup names the directory after the agent, and a linked worktree carries a .git
# file where a checkout carries a directory, which is the same claim cleanup makes.
if [ "$WEAVE_TRIGGER" = resume ] && [ -d "$WEAVE_AGENT_CWD" ] &&
	[ "$(basename "$WEAVE_AGENT_CWD")" = "$WEAVE_AGENT_ID" ] && [ -f "$WEAVE_AGENT_CWD/.git" ]; then
	tree="$WEAVE_AGENT_CWD"
fi

apply_paths() {
	list="$1"
	kind="$2"
	root=$(cd "$tree" && pwd -P)
	if [ -z "$root" ]; then
		echo "worktree setup: could not resolve $tree, skipping every $kind" >&2
		return 0
	fi
	printf '%s\n' "$list" | while IFS= read -r p; do
		if [ -z "$p" ]; then
			continue
		fi
		entry="$p"
		while [ "${p%/}" != "$p" ]; do
			p="${p%/}"
		done

		src="$repo/$p"
		dest="$tree/$p"
		if [ ! -e "$src" ]; then
			echo "worktree setup: $p not found in $repo, skipping $kind" >&2
			continue
		fi

		# The destination is cleared before it is applied, so a path that names something other
		# than a place inside the worktree is refused rather than removed. The worktree's own
		# link to the repo is inside it and would be cleared like anything else, which is what
		# would take the worktree with it.
		outside=
		if [ -z "$p" ]; then
			outside=yes
		fi
		case "/$p/" in
		*/./* | */../* | */.git/*) outside=yes ;;
		esac

		if [ -z "$outside" ]; then
			existing=$(dirname "$dest")
			while [ ! -d "$existing" ]; do
				existing=$(dirname "$existing")
			done
			existing=$(cd "$existing" && pwd -P)
			case "$existing" in
			"$root" | "$root"/*) ;;
			*) outside=yes ;;
			esac
		fi
		if [ -n "$outside" ]; then
			echo "worktree setup: $entry is not a path inside the worktree, skipping $kind" >&2
			continue
		fi

		if git -C "$repo" ls-files --error-unmatch -- "$p" >/dev/null 2>&1; then
			echo "worktree setup: $p is tracked, skipping $kind" >&2
			continue
		fi

		mkdir -p "$(dirname "$dest")"

		# A path applied earlier in this run leaves a directory that cp and ln would nest inside
		# rather than replace.
		if ! rm -rf "$dest"; then
			echo "worktree setup: could not clear $dest, skipping $kind of $p" >&2
			continue
		fi
		if [ "$kind" = copy ]; then
			cp -rf "$src" "$dest" || echo "worktree setup: failed to copy $p" >&2
		else
			ln -sfn "$src" "$dest" || echo "worktree setup: failed to symlink $p" >&2
		fi
	done
}

has_ref() {
	git -C "$repo" rev-parse --verify --quiet "$1" >/dev/null 2>&1
}

# origin_head asks origin which branch it defaults to, which is a network round trip.
origin_head() {
	git -C "$repo" ls-remote --symref origin HEAD 2>/dev/null | awk '/^ref:/ { sub("refs/heads/", "", $2); print $2; exit }' || true
}

# record_head writes down what origin answered so the clone can be read instead next time,
# which only takes once the fetch has made the tracking ref it points at.
record_head() {
	git -C "$repo" remote set-head origin "$base" >/dev/null 2>&1 || true
}

# fetch_base brings the base branch up to date and says where to cut the worktree from, or
# fails when origin has no such branch to fetch.
fetch_base() {
	echo "fetching $base from origin" >&2
	if ! git -C "$repo" fetch --quiet origin "$base" >&2; then
		return 1
	fi

	if has_ref "refs/remotes/origin/$base"; then
		point="origin/$base"
	elif git -C "$repo" fetch --quiet --no-tags origin "+$base:$staged" >&2; then
		point="$staged"
	fi

	return 0
}

# A directory removed without telling git leaves a registration behind that still claims the
# branch. Pruning only once something is blocking this add keeps the blast radius small, since
# a prune drops the registration of every worktree whose directory it cannot see, including one
# on a volume that is merely unmounted right now.
add_worktree() {
	if ! git -C "$repo" worktree add "$@" >&2; then
		echo "worktree setup: pruning stale worktree registrations and trying once more" >&2
		git -C "$repo" worktree prune 2>/dev/null || true
		git -C "$repo" worktree add "$@" >&2
	fi
}

# The branch of an adopted agent belongs to whoever made it, so it is checked out as it
# stands: no -B, which would reset it onto a base, and no branch of weave's own. A branch that
# is only on origin is checked out by name too, which is git making the tracking branch here.
adopt_worktree() {
	branch="$WEAVE_WORKTREE_ADOPT_BRANCH"

	if [ -n "$origin" ]; then
		echo "fetching $branch from origin" >&2
		git -C "$repo" fetch --quiet origin "$branch" >&2 || echo "worktree setup: could not fetch $branch from origin, using what is already here" >&2
	fi

	if ! has_ref "refs/heads/$branch" && ! has_ref "refs/remotes/origin/$branch"; then
		echo "worktree setup: $branch is not a branch $repo can reach" >&2
		exit 1
	fi

	mkdir -p "$WEAVE_WORKTREES_DIR"
	echo "creating a worktree at $tree on $branch" >&2
	add_worktree "$tree" "$branch"
}

# The worktree of an agent starting fresh work is its own branch cut from the base, named
# after the agent so nothing else claims it.
fresh_worktree() {
	branch="agent/$WEAVE_AGENT_ID"

	# A branch this agent already has holds commits of its own, so it is checked out as it
	# stands rather than reset onto the base, which is what the -B below would do.
	if has_ref "refs/heads/$branch"; then
		mkdir -p "$WEAVE_WORKTREES_DIR"
		echo "creating a worktree at $tree on the existing $branch" >&2
		add_worktree "$tree" "$branch"
		return
	fi

	base="$WEAVE_WORKTREE_BASE_BRANCH"
	guessed=

	if [ -z "$base" ]; then
		head_ref=$(git -C "$repo" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null) || true
		if [ -n "$head_ref" ] && has_ref "$head_ref"; then
			base=${head_ref#refs/remotes/origin/}
			guessed=yes
		fi
	fi

	if [ -z "$base" ]; then
		for candidate in refs/remotes/origin/main refs/remotes/origin/master refs/heads/main refs/heads/master; do
			if has_ref "$candidate"; then
				base=${candidate##*/}
				guessed=yes
				break
			fi
		done
	fi

	# Every guess above is answered by the clone in microseconds, so origin is only asked when
	# the clone holds nothing to guess from, and the fetch below is what catches a guess that
	# the remote has since renamed away.
	asked=
	if [ -z "$base" ] && [ -n "$origin" ]; then
		base=$(origin_head)
		guessed=yes
		asked=yes
	fi

	if [ -z "$base" ]; then
		if [ -n "$origin" ]; then
			echo "worktree setup: could not work out which branch $repo defaults to, so set the workflow's base branch" >&2
			exit 1
		fi
		base=$(git -C "$repo" rev-parse --abbrev-ref HEAD)
	fi

	# A fetch by branch name always writes FETCH_HEAD but only updates the tracking ref when the
	# remote's refspec maps that branch, which a single-branch clone's does not, so exiting zero
	# is no proof of origin/$base. FETCH_HEAD is the obvious place to read what was fetched
	# instead and is one file the whole repo shares, so concurrent setups would read each
	# other's, and the fetch is made again under a name belonging to this agent alone.
	staged="refs/weave/base/$WEAVE_AGENT_ID"
	point=
	if [ -n "$origin" ]; then
		if ! fetch_base && [ -n "$guessed" ]; then
			# The clone's answer is stale rather than wrong when the default branch has been
			# renamed on the forge, and a fetch of a branch origin no longer has is how that
			# shows, so this is the one path that pays to ask origin itself.
			renamed=$(origin_head)
			if [ -n "$renamed" ] && [ "$renamed" != "$base" ]; then
				base="$renamed"
				asked=yes
				fetch_base || true
			fi
		fi

		if [ -n "$asked" ] && [ -n "$point" ]; then
			record_head
		fi
	fi

	# Either there is no origin or it could not be reached. What git cached the last time it
	# could is the better of the two guesses left, since the local branch is where the human's
	# own unpushed work sits.
	if [ -z "$point" ]; then
		for candidate in "refs/remotes/origin/$base" "refs/heads/$base"; do
			if has_ref "$candidate"; then
				point="$candidate"
				break
			fi
		done
	fi

	if [ -z "$point" ]; then
		echo "worktree setup: $base is not a branch $repo can reach, so set the workflow's base branch to one it has" >&2
		exit 1
	fi

	mkdir -p "$WEAVE_WORKTREES_DIR"
	echo "creating a worktree at $tree from $point" >&2

	# --no-track leaves the branch with no upstream, so git status inside the worktree measures
	# the agent against nothing but its own branch, and the add writes no branch config, which
	# is the shared lock every concurrent create would otherwise fail on.
	add_worktree --no-track -B "$branch" "$tree" "$point"

	# The branch the add just made holds the commit now, so a ref that named the branch point
	# for one command is not left behind in the human's repo.
	if [ "$point" = "$staged" ]; then
		git -C "$repo" update-ref -d "$staged" 2>/dev/null || true
	fi
}

if [ -d "$tree" ]; then
	echo "worktree already exists at $tree" >&2
else
	origin=
	if git -C "$repo" remote get-url origin >/dev/null 2>&1; then
		origin=yes
	fi

	if [ -n "$WEAVE_WORKTREE_ADOPT_BRANCH" ]; then
		adopt_worktree
	else
		fresh_worktree
	fi

	# With no upstream, a plain push has nothing to push to until this is set. --local in a
	# linked worktree writes the shared config, so this also decides what a plain push does in
	# the human's own checkout of the repo, and it is left alone if they have already set it.
	if ! git -C "$tree" config --get push.autoSetupRemote >/dev/null 2>&1; then
		git -C "$tree" config --local push.autoSetupRemote true 2>/dev/null || true
		if ! git -C "$tree" config --get push.autoSetupRemote >/dev/null 2>&1; then
			echo "worktree setup: could not set push.autoSetupRemote, so the first push needs -u" >&2
		fi
	fi

	# Only a worktree this run made is furnished. One that was already there holds
	# whatever the agent has done to it since, and copying a directory over one that
	# is already present nests it a level deeper every time.
	apply_paths "$WEAVE_WORKTREE_COPY_PATHS" copy || true
	apply_paths "$WEAVE_WORKTREE_SYMLINK_PATHS" symlink || true
fi

printf '%s' "$tree" >"$WEAVE_SETUP_DIR_FILE"
