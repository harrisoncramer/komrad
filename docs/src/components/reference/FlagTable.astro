---
import type { Flag } from "../../reference/types";

type Props = {
  flags: Flag[];
  prefix: string;
};

const { flags, prefix } = Astro.props;
---

<div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th>Flag</th>
        <th>Type</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {flags.map((flag) => (
        <tr id={`${prefix}-${flag.name}`}>
          <td>
            <a class="row-anchor" href={`#${prefix}-${flag.name}`}>
              <code>
                {flag.shorthand && `-${flag.shorthand}, `}--{flag.name}
              </code>
            </a>
          </td>
          <td class="type-cell" data-sep=":">
            {flag.type}
          </td>
          <td>
            <p>{flag.usage}</p>
            {flag.default && flag.default !== "[]" && flag.default !== "false" && (
              <p class="rules">default {flag.default}</p>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
