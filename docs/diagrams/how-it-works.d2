...@_theme

direction: right

terminal: Your terminal {
  class: group
  attach: Attach {class: leaf}
}

tmux: "Komrad's tmux server" {
  class: group
  grid-columns: 1
  grid-gap: 20
  panel: Panel {class: leaf}
  agent1: Agent {class: leaf}
  agent2: Agent {class: leaf}
  more: {class: more}
}

serve: Server {class: leaf}

postgres: Postgres {class: store}

terminal.attach -> tmux
tmux -> serve
serve -> postgres
