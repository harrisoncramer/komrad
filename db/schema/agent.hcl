schema "public" {
}

# pg_trgm backs the transcript search: it indexes every three-character run of
# the text, which is what makes a search match on any substring rather than on
# whole words only. The extension is not declared here because this Atlas edition
# does not manage extensions; it is created by the first migration, which the
# diff replays into its dev database before reaching the index that needs it.

# A workflow's default configuration, used only as the blueprint prefilled into
# the new-agent form. Agents copy it into their own config; they never
# reference it at rest.
table "workflow_configs" {
  schema  = schema.public
  comment = "Default config (harness, cwd, flags) seeded into new agents of a workflow."
  column "id" {
    null    = false
    type    = uuid
    default = sql("uuidv7()")
  }
  # Which agent CLI this workflow's agents run, empty when the workflow takes
  # whatever the user configured as their default. It sits here rather than on the
  # workflow because it is one of the defaults an agent inherits at launch.
  column "harness" {
    null    = false
    type    = text
    default = ""
  }
  column "cwd" {
    null    = false
    type    = text
    default = ""
  }
  column "flags" {
    null    = false
    type    = text
    default = ""
  }
  column "created_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  column "updated_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  primary_key {
    columns = [column.id]
  }
}

table "workflows" {
  schema  = schema.public
  comment = "A named bucket of related agents. Pure organization; runs nothing."
  # uuidv7, generated by the database, same scheme as agents.id. Everything
  # keys on this id; the name is a mutable display label.
  column "id" {
    null    = false
    type    = uuid
    default = sql("uuidv7()")
  }
  column "name" {
    null = false
    type = text
  }
  # Free-text durable state for the workflow, edited by the user. Holds shared
  # context that agents in the workflow can read; empty until filled in.
  column "context" {
    null    = false
    type    = text
    default = ""
  }
  # The workflow's default config. References workflow_configs.id.
  column "workflow_config_id" {
    null = false
    type = uuid
  }
  # Soft-delete flag: a deleted workflow is hidden from the panel but kept.
  column "is_deleted" {
    null    = false
    type    = boolean
    default = false
  }
  column "created_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  column "updated_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  primary_key {
    columns = [column.id]
  }
  # A workflow always owns exactly one config, so the reference is never null and
  # the config is never removed out from under it.
  foreign_key "workflows_workflow_config_id_fkey" {
    columns     = [column.workflow_config_id]
    ref_columns = [table.workflow_configs.column.id]
    on_delete   = RESTRICT
    on_update   = NO_ACTION
  }
  index "workflows_workflow_config_id" {
    columns = [column.workflow_config_id]
  }
}

table "agent_transcripts" {
  schema  = schema.public
  comment = "Flattened transcript for an agent, synced from Claude's on-disk JSONL and indexed for search. Strict 1:1 with an agent."
  # Equals agents.id, so this is the one id the caller supplies rather than the
  # database: the agent owns exactly one transcript, and reusing its id makes
  # the 1:1 link implicit and keyless.
  column "agent_id" {
    null = false
    type = uuid
  }
  # The user and assistant turns flattened to plain text, the corpus search runs
  # over. Tool calls, tool results, and thinking are dropped so the index stays
  # lean and matches read as conversation.
  column "content" {
    null    = false
    type    = text
    default = ""
  }
  # How many bytes of the source JSONL have been folded into content already.
  # The syncer seeks here and reads only the appended tail, so a large transcript
  # is not re-parsed every pass. The JSONL is append-only, so the offset only
  # grows unless the file is rewritten, which the syncer detects and reindexes.
  column "synced_offset" {
    null    = false
    type    = bigint
    default = 0
  }
  column "synced_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  primary_key {
    columns = [column.agent_id]
  }
  foreign_key "agent_transcripts_agent_id_fkey" {
    columns     = [column.agent_id]
    ref_columns = [table.agents.column.id]
    on_delete   = CASCADE
    on_update   = NO_ACTION
  }
}

# One turn of a transcript, the unit search matches and ranks. A whole
# conversation is too coarse to score: a long one covering many subjects is a
# mediocre match for all of them, and it can only ever yield a single snippet.
# Per-turn rows score as coherent units, let one conversation return several
# hits, and turn a sync into an append of small rows rather than a rewrite of a
# large one.
table "agent_transcript_chunks" {
  schema  = schema.public
  comment = "One turn of an agent's transcript, word-indexed for search."
  column "agent_id" {
    null = false
    type = uuid
  }
  # Position of the turn within the transcript, counting from zero. Assigned by
  # the syncer as it appends, so it orders turns the way the conversation ran.
  column "seq" {
    null = false
    type = int
  }
  # Who spoke, user or assistant, carried so a hit can say which side said it.
  column "role" {
    null = false
    type = text
  }
  # The turn's text, the same prose that sits inside agent_transcripts.content.
  column "content" {
    null = false
    type = text
  }
  # Byte offset where this turn begins inside agent_transcripts.content. The
  # panel loads the full transcript to preview a hit and needs the line to centre
  # on. Locating the turn by searching for its text would fail whenever a match
  # is stemmed rather than literal, so the offset is recorded at write time
  # instead, when it is known exactly.
  column "content_offset" {
    null = false
    type = bigint
  }
  # The turn reduced to stemmed lexemes with their positions, which is what the
  # GIN index below covers and what a tsquery is matched against. Generated by
  # the database so it cannot drift from content. to_tsvector is only immutable
  # when the configuration is named outright, which is why 'english' is spelled
  # here rather than left to default_text_search_config.
  column "tsv" {
    null = false
    type = sql("tsvector")
    as {
      expr = "to_tsvector('english', content)"
      type = STORED
    }
  }
  primary_key {
    columns = [column.agent_id, column.seq]
  }
  foreign_key "agent_transcript_chunks_agent_id_fkey" {
    columns     = [column.agent_id]
    ref_columns = [table.agents.column.id]
    on_delete   = CASCADE
    on_update   = NO_ACTION
  }
  # The search index. Inverted, so a lexeme resolves to the turns holding it in
  # one probe rather than a scan of the corpus.
  index "agent_transcript_chunks_tsv" {
    type    = GIN
    columns = [column.tsv]
  }
  # Lexemes are whole words, so a query typed halfway matches nothing until the
  # word is finished. Trigrams cover that gap: they index every three-character
  # run, which is what lets a partial word still find the turns containing it
  # while someone is still typing.
  index "agent_transcript_chunks_content_trgm" {
    type = GIN
    on {
      column = column.content
      ops    = gin_trgm_ops
    }
  }
}

# Facts an agent records about its own work as it goes, so the panel can show
# what an issue or pull request a conversation was about without reading the
# transcript back. The agent writes these itself, and nothing else does.
#
# A row per key rather than one document per agent, because an agent recording a
# second fact would otherwise have to rewrite the whole thing and could drop
# whatever it had not read first. The pair below is the identity, so a repeated
# write of the same fact updates in place instead of accumulating.
table "agent_metadata" {
  schema  = schema.public
  comment = "Key/value facts an agent recorded about its own work."
  column "agent_id" {
    null = false
    type = uuid
  }
  # The agent's own choice of name for the fact, constrained to a slug by the
  # proto so a key reads the same however many agents wrote it and the panel can
  # align a column of them.
  column "key" {
    null = false
    type = text
  }
  column "value" {
    null = false
    type = text
  }
  column "created_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  column "updated_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  primary_key {
    columns = [column.agent_id, column.key]
  }
  foreign_key "agent_metadata_agent_id_fkey" {
    columns     = [column.agent_id]
    ref_columns = [table.agents.column.id]
    on_delete   = CASCADE
    on_update   = NO_ACTION
  }
}

table "agents" {
  schema  = schema.public
  comment = "One background Claude agent, everything needed to restore it."
  # uuidv7, time-ordered so it sorts chronologically, which is what the keyset page
  # reads as newest-first. The service mints it before the insert, since the tmux
  # pane the agent runs in is stamped with it and has to be stamped before the row
  # exists. The default covers a writer that brings none, and generates the same
  # version so both sort together.
  column "id" {
    null    = false
    type    = uuid
    default = sql("uuidv7()")
  }
  column "name" {
    null = false
    type = text
  }
  # Where the agent runs and the flags it was launched with. A restore reads both
  # back to bring the agent up the same way, so they are the agent's own columns
  # rather than a row it points at.
  column "cwd" {
    null    = false
    type    = text
    default = ""
  }
  column "flags" {
    null    = false
    type    = text
    default = ""
  }
  column "prompt" {
    null    = false
    type    = text
    default = ""
  }
  column "pane_id" {
    null    = false
    type    = text
    default = ""
  }
  column "state" {
    null    = false
    type    = text
    default = "new"
  }
  # Which agent CLI this agent runs, which decides how it is launched, how its
  # state is read off its pane, and where its conversation log is found. Never
  # empty: an agent whose harness nothing implements cannot be relaunched or
  # observed, so the id is resolved and refused at create rather than here.
  column "harness" {
    null    = false
    type    = text
    default = "claude"
  }
  # The conversation this agent holds, minted by the panel at launch and handed to
  # the harness, which reopens it when a dormant agent is restored.
  column "session_id" {
    null    = false
    type    = text
    default = ""
  }
  # The workflow this agent belongs to, and every agent has one. A workflow is
  # where the directory, flags, and shared context an agent starts from live, so an
  # agent outside one would have no defaults to inherit and nowhere to be listed.
  # References workflows.id.
  column "workflow_id" {
    null = false
    type = uuid
  }
  # The schedule that launched this agent, or null for one a person started.
  column "schedule_id" {
    null = true
    type = uuid
  }
  # A caller-supplied key that makes a create idempotent. A retried launch, from
  # a background job or a tool call, passes the same key and gets the agent that
  # already exists rather than a second Claude process on the same prompt. Null
  # for a create that makes no such claim, which is every create from the panel.
  column "idempotency_key" {
    null = true
    type = text
  }
  # When the row was soft-deleted, null while it is live.
  column "deleted_at" {
    null = true
    type = timestamptz
  }
  # Hidden keeps an agent out of the panel's list while leaving it running. It is
  # not a second soft delete: the agent is live, still reconciled, and still
  # counted, it just does not take a row until the panel is asked to show the
  # hidden ones.
  column "is_hidden" {
    null    = false
    type    = boolean
    default = false
  }
  # The mark the user put on this agent, null when it carries none. It holds the
  # glyph itself, since which glyphs exist is their config and the glyph is the
  # whole meaning. Only the person writes it, never the reconciler, since what an
  # agent is doing is already in state.
  column "mark" {
    null = true
    type = text
  }
  column "created_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  column "updated_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  primary_key {
    columns = [column.id]
  }
  foreign_key "agents_workflow_id_fkey" {
    columns     = [column.workflow_id]
    ref_columns = [table.workflows.column.id]
    on_delete   = RESTRICT
    on_update   = NO_ACTION
  }
  foreign_key "agents_schedule_id_fkey" {
    columns     = [column.schedule_id]
    ref_columns = [table.schedules.column.id]
    on_delete   = RESTRICT
    on_update   = NO_ACTION
  }
  # Unique on name only among live records. A soft-deleted row keeps its name,
  # so without the predicate a deleted agent would block ever reusing its name
  # and the upsert-by-name path would resurrect the dead row instead of creating
  # a fresh one. Scoping the constraint to live rows lets deleted rows retain
  # their name harmlessly while every name-keyed lookup still resolves to at
  # most one live agent.
  index "agents_name_active" {
    unique  = true
    columns = [column.name]
    where   = "deleted_at IS NULL"
  }
  # Scoped listings filter by workflow, so index the foreign key.
  index "agents_workflow_id" {
    columns = [column.workflow_id]
  }
  # A schedule's detail view lists what it has launched, so index that key too.
  index "agents_schedule_id" {
    columns = [column.schedule_id]
  }
  # One agent per key, across live and deleted rows alike. Unlike the name
  # index this is not scoped to live records: a retry must find the agent it
  # already created even if that agent has since been archived, or it would
  # spawn a duplicate. Partial on non-null so the ordinary create, which claims
  # no key, is unconstrained.
  index "agents_idempotency_key" {
    unique  = true
    columns = [column.idempotency_key]
    where   = "idempotency_key IS NOT NULL"
  }
}
