---
import { Code } from "astro:components";
import Layout from "../layouts/Layout.astro";
import { codeTheme } from "../code-theme.mjs";
import { HOME_TITLE, REPO_URL, SITE_DESCRIPTION, SITE_TITLE, SPLASH } from "../consts";
import { canonical, link, media } from "../site";

const INSTALL = `gh release download tip --repo harrisoncramer/komrad --pattern komrad-darwin-arm64 --output ~/.local/bin/komrad
chmod +x ~/.local/bin/komrad`;

const NEXT = [
  { href: link("/guides/install"), title: "Install", text: "Set up Postgres, start the engine, open the panel." },
  { href: link("/guides/how-it-works"), title: "How it works", text: "The engine, the panel, and what each one owns." },
  { href: link("/guides"), title: "Guides", text: "Everything else: agents, workflows, mail, reviews, hooks." },
];

const homeUrl = canonical(link("/"));

const STRUCTURED_DATA = [
  { "@type": "WebSite", name: SITE_TITLE, url: homeUrl, description: SITE_DESCRIPTION },
  {
    "@type": "SoftwareApplication",
    name: SITE_TITLE,
    description: SITE_DESCRIPTION,
    url: homeUrl,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS, Linux",
    license: `${REPO_URL}/blob/main/LICENSE`,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    sameAs: [REPO_URL],
  },
];
---

<Layout title={HOME_TITLE} description={SITE_DESCRIPTION} structuredData={STRUCTURED_DATA}>
  <article class="home">
    <h1>komrad</h1>

    <p>
      Komrad is an open-source, terminal-based agent orchestrator. It wraps around agent CLIs like Claude and Codex.
    </p>
    <p>
      With komrad, you can search through old agent transcripts, restore old sessions, schedule agents, and orchestrate
      agentic workflows via the komrad MCP.
    </p>
    <p>Komrad runs on your machine by default, but can be deployed to a remote instance that you control.</p>
    <img
      src={media(SPLASH.name)}
      alt={SPLASH.alt}
      width={SPLASH.width}
      height={SPLASH.height}
      fetchpriority="high"
      decoding="async"
    />
    <p>
      Komrad caters to terminal enthusiasts, and will probably not work for everyone. Please read the{" "}
      <a href=`${link("/guides/philosophy")}`>philosophy</a> behind it before getting started.
    </p>
    <p>
      Everything in these guides has been hand-written. If you notice an issue, please file{" "}
      <a href="https://github.com/harrisoncramer/komrad/issues/new?template=docs_report.yml">a docs report</a> on
      Github. If you have any issues with Komrad itself, please file{" "}
      <a href={link("/guides/bug-reports")}>a bug report</a>. Reports that don't adhere to komrad's templates will be
      automatically closed.
    </p>
    <h2>Install</h2>
    <Code code={INSTALL} lang="sh" theme={codeTheme} />
    <p>
      Swap <code>darwin-arm64</code> for your platform, then follow the{" "}
      <a href={link("/guides/install")}>install guide</a> to set up Postgres and start the engine.
    </p>

    <h2>Read next</h2>
    <dl>
      {NEXT.map((item) => (
        <>
          <dt>
            <a href={item.href}>{item.title}</a>
          </dt>
          <dd>{item.text}</dd>
        </>
      ))}
    </dl>
  </article>
</Layout>

<style>
  @reference "../styles/global.css";

  .home {
    @apply mt-4 flex flex-col gap-5 pb-8 leading-relaxed text-app-gray;
  }

  .home h1 {
    @apply text-app-white;
  }

  .home h2 {
    @apply mt-6 text-app-white;
  }

  .home img {
    @apply my-4 h-auto w-full rounded-lg border border-app-background-medium;
  }

  .home p code {
    @apply font-mono text-[0.9em] text-app-white;
  }

  .home dl {
    @apply grid grid-cols-1 gap-x-6 gap-y-1 sm:grid-cols-[10rem_1fr] sm:gap-y-3;
  }

  .home dd {
    @apply mb-3 sm:mb-0;
  }
</style>
