---
import Anchor from "./Anchor.astro";

type Props = {
  items: { href: string; title: string; summary?: string; id?: string }[];
  rows?: boolean;
};

const { items, rows = false } = Astro.props;
---

<ul class:list={["index-list", { rows }]}>
  {items.map((item) => (
    <li id={item.id}>
      <span class="index-name">
        <a href={item.href}>
          <code>{item.title}</code>
        </a>
        {item.id && <Anchor id={item.id} />}
      </span>
      {item.summary && <p>{item.summary}</p>}
    </li>
  ))}
</ul>
