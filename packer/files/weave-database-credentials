#!/usr/bin/env bash
set -euo pipefail

# Explainer: this fetches weave's database connection string and writes it where the service
# reads it.
#
# Nobody types a connection string for this host, and none is baked into the image. Terraform
# puts the url in a secret under the weave namespace, and tells this machine only which secret
# to ask for. The instance reads it as itself, using the role attached to it, so no access key
# exists anywhere on the host and a rotated url is picked up by a restart.

source_file=/etc/weave/database-source.env
target=/etc/weave/database.env

if [ ! -f "$source_file" ]; then
	echo "$source_file is missing, so the database secret cannot be located" >&2
	exit 1
fi

# shellcheck source=/dev/null
. "$source_file"

: "${WEAVE_DATABASE_SECRET:?WEAVE_DATABASE_SECRET is not set}"

# The weave namespace is asked first, so putting a url there is how a person overrides where this
# host connects without touching Terraform or the image.
url="$(aws secretsmanager get-secret-value \
	--secret-id "$WEAVE_DATABASE_SECRET" \
	--query SecretString \
	--output text 2>/dev/null || true)"

# Failing that the url is composed from the password AWS owns for the database, which is left
# where AWS put it rather than copied into the namespace: copying it would mean Terraform reading
# it, and it would then live in state.
if [ -z "$url" ] || [ "$url" = "None" ]; then
	: "${WEAVE_DATABASE_FALLBACK_SECRET_ARN:?no url in $WEAVE_DATABASE_SECRET and no fallback secret named}"
	: "${WEAVE_DATABASE_HOST:?WEAVE_DATABASE_HOST is not set}"
	: "${WEAVE_DATABASE_NAME:?WEAVE_DATABASE_NAME is not set}"

	secret="$(aws secretsmanager get-secret-value \
		--secret-id "$WEAVE_DATABASE_FALLBACK_SECRET_ARN" \
		--query SecretString \
		--output text)"

	username="$(jq -re .username <<<"$secret")"
	password="$(jq -rn --arg p "$(jq -re .password <<<"$secret")" '$p|@uri')"

	url="postgres://$username:$password@$WEAVE_DATABASE_HOST:5432/$WEAVE_DATABASE_NAME"
	url="$url?sslmode=verify-full&sslrootcert=/etc/weave/rds-ca.pem"
fi

# The file is created empty and private first, so the url is never briefly readable by anyone
# else. The value is quoted because it contains an ampersand, which would otherwise be read as a
# command separator by anything sourcing this file in a shell.
install -m 0600 /dev/null "$target"
cat >"$target" <<ENV
WEAVE_DATABASE_URL='$url'
ENV
