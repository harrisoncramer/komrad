---
import Layout from "./Layout.astro";
import { REPO_URL } from "../consts";

type Neighbour = { title: string; href: string };

type Props = {
  title: string;
  description?: string;
  filePath?: string;
  prev?: Neighbour;
  next?: Neighbour;
};

const { title, description, filePath, prev, next } = Astro.props;
---

<Layout title={title} description={description}>
  <article data-pagefind-body>
    <h1 class="title" data-pagefind-meta="title">
      {title}
    </h1>
    {description && <p class="mt-2 mb-8 text-lg text-app-gray-light">{description}</p>}
    {filePath && (
      <div class="mb-3 flex justify-end" data-pagefind-ignore>
        <a class="edit-link" href={`${REPO_URL}/blob/main/docs/${filePath}`}>
          Edit this page on Github
        </a>
      </div>
    )}
    <div class="doc-content mt-4">
      <slot />
    </div>
    {(prev || next) && (
      <nav class="pager" aria-label="Guides" data-pagefind-ignore>
        {prev ? (
          <a class="pager-link" href={prev.href} rel="prev">
            <span class="pager-label">Previous</span>
            <span class="pager-title">&larr; {prev.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a class="pager-link pager-next" href={next.href} rel="next">
            <span class="pager-label">Next</span>
            <span class="pager-title">{next.title} &rarr;</span>
          </a>
        )}
      </nav>
    )}
  </article>
</Layout>

<style>
  @reference "../styles/global.css";

  .title {
    @apply leading-tight;
  }

  .edit-link {
    @apply text-sm text-app-gray opacity-70 transition-opacity duration-200;
    font-family: var(--font-sans);
  }

  .edit-link:hover,
  .edit-link:focus-visible {
    @apply opacity-100;
  }

  .doc-content {
    @apply mb-12 flex flex-col gap-4;
  }

  .pager {
    @apply mb-24 flex justify-between gap-4 border-t border-app-background-medium pt-6;
  }

  .pager-link {
    @apply flex flex-col gap-1 text-app-gray-light transition-colors hover:text-app-blue;
    font-family: var(--font-sans);
  }

  .pager-next {
    @apply items-end text-right;
  }

  .pager-label {
    @apply text-xs tracking-wide text-app-gray-dim uppercase;
  }

  .pager-title {
    @apply text-base;
  }

  .doc-content :global(:is(h2, h3, h4)) {
    @apply mt-6 leading-tight;
  }

  .doc-content :global(:is(p, li)) {
    font-size: 1em;
    line-height: 1.7;
    color: #e6ecf5;
  }

  @media (max-width: 639.98px) {
    .doc-content :global(:is(p, li)) {
      font-size: 0.95em;
      line-height: 1.65;
    }
  }

  .doc-content :global(ul:not(.index-list) li) {
    @apply ml-6 list-disc;
  }

  .doc-content :global(ol li) {
    @apply ml-6 list-decimal;
  }

  .doc-content :global(:not(pre) > code) {
    @apply rounded-xs bg-app-background-light px-1.5 py-0.5 text-app-gray;
    font-size: 0.85em;
  }

  .doc-content :global(blockquote) {
    @apply m-0 border-l-2 border-app-blue pl-5 text-app-gray;
    font-family: var(--font-sans);
  }

  .doc-content :global(a) {
    @apply underline decoration-app-blue/40 decoration-1 underline-offset-4 transition-[text-decoration-color] duration-200;
  }

  .doc-content :global(a:hover),
  .doc-content :global(a:focus-visible) {
    @apply decoration-app-blue decoration-2;
  }
</style>

<script>
  document.querySelectorAll<HTMLPreElement>(".doc-content pre.astro-code").forEach((pre) => {
    const block = document.createElement("div");
    block.className = "code-block";
    pre.replaceWith(block);
    block.appendChild(pre);

    const button = document.createElement("button");
    button.className = "code-copy-btn";
    button.textContent = "Copy";
    block.appendChild(button);

    button.addEventListener("click", () => {
      void navigator.clipboard.writeText(pre.innerText).then(() => {
        button.textContent = "Copied!";
        setTimeout(() => {
          button.textContent = "Copy";
        }, 1500);
      });
    });
  });
</script>
