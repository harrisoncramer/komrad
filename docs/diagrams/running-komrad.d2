...@_theme

direction: down

panel: Panel {class: leaf}
idp: Identity provider {class: leaf}

host: Engine host {
  class: group
  grid-columns: 3
  grid-gap: 40
  front: HTTPS proxy {class: leaf}
  serve: Server {class: leaf}
  agents: Agents {class: leaf}
}

postgres: Postgres {class: store}
forge: Forge {class: leaf}

panel -> idp: sign in
panel -> host: HTTPS
host -> postgres
host -> forge: git
