#!/usr/bin/env bash
set -euo pipefail

# Migrates the database, makes each engine's login and grant, and writes the control plane's config.

env_file=/etc/komrad/control-plane.env
engines_file=/etc/komrad/engines
owner_env=/etc/komrad/owner.env
config=/etc/komrad/control-plane.toml
ca_key=/run/komrad/forge-proxy-ca.key

if [ ! -f "$env_file" ] || [ ! -f "$engines_file" ]; then
	echo "$env_file or $engines_file is missing, so there are no engines to set up" >&2
	exit 1
fi

# shellcheck source=/dev/null
. "$env_file"
export AWS_REGION

: "${KOMRAD_STACK:?KOMRAD_STACK is not set}"
: "${KOMRAD_ENGINE_SECRET_PREFIX:?KOMRAD_ENGINE_SECRET_PREFIX is not set}"
: "${KOMRAD_LOGIN_SECRET_PREFIX:?KOMRAD_LOGIN_SECRET_PREFIX is not set}"
: "${KOMRAD_CA_KEY_SECRET:?KOMRAD_CA_KEY_SECRET is not set}"
: "${KOMRAD_GITHUB_CLIENT_ID:?KOMRAD_GITHUB_CLIENT_ID is not set}"
: "${KOMRAD_FORGE_PROXY_ADDR:?KOMRAD_FORGE_PROXY_ADDR is not set}"

# HOME is named because systemd sets none for a system service and komrad looks for its config
# under one.
export HOME="${HOME:-/root}"
KOMRAD_OWNER_DATABASE_URL="$(komrad-owner-database-url)"
export KOMRAD_OWNER_DATABASE_URL

work="$(mktemp -d -p /run komrad-control-plane.XXXXXX)"
trap 'rm -rf "$work"' EXIT

komrad migrate

entries=()
grants=()
while read -r name email address <&3; do
	if [ -z "$name" ]; then
		continue
	fi

	secret="$KOMRAD_ENGINE_SECRET_PREFIX$name"

	# Terraform makes each engine's secret with no value, and only this script ever writes one.
	if ! value="$(aws secretsmanager get-secret-value --secret-id "$secret" \
		--query SecretString --output text 2>"$work/errors")"; then
		if ! grep -q ResourceNotFoundException "$work/errors"; then
			cat "$work/errors" >&2
			exit 1
		fi

		install -m 0600 /dev/null "$work/value"
		jq -n --arg password "$(openssl rand -hex 24)" --arg credential "$(openssl rand -hex 24)" \
			'{password: $password, forge_proxy_credential: $credential}' >"$work/value"
		aws secretsmanager put-secret-value --secret-id "$secret" \
			--secret-string "file://$work/value" >/dev/null
		value="$(cat "$work/value")"
	fi

	KOMRAD_ENGINE_PASSWORD="$(jq -re .password <<<"$value")" komrad engine ensure "$name" >/dev/null

	entries+=("$name=$(jq -re .forge_proxy_credential <<<"$value")@$address")
	grants+=("$name=$email")
done 3<"$engines_file"

komrad engine grants "${grants[@]}"

previous="$(cat "$owner_env" "$config" "$ca_key" 2>/dev/null || true)"

install -m 0600 /dev/null "$owner_env"
cat >"$owner_env" <<ENV
KOMRAD_OWNER_DATABASE_URL='$KOMRAD_OWNER_DATABASE_URL'
ENV

# The key lands under /run, a tmpfs, so it is never written to the volume or an image.
install -d -m 0700 -o komrad -g komrad /run/komrad
install -m 0600 -o komrad -g komrad /dev/null "$ca_key"
aws secretsmanager get-secret-value --secret-id "$KOMRAD_CA_KEY_SECRET" \
	--query SecretString --output text >"$ca_key"

# toml_string writes a value as a JSON string, which TOML reads the same way.
toml_string() {
	jq -n --arg value "$1" '$value'
}

install -m 0640 -g komrad /dev/null "$config"
cat >"$config" <<TOML
[control_plane]
addr = "127.0.0.1:8790"
forge_proxy_addr = $(toml_string "$KOMRAD_FORGE_PROXY_ADDR")
ca_cert_file = "/etc/komrad/forge-proxy-ca.pem"
ca_key_file = "$ca_key"
github_client_id = $(toml_string "$KOMRAD_GITHUB_CLIENT_ID")
engines = $(jq -cn '$ARGS.positional' --args "${entries[@]}")

[control_plane.aws]
region = $(toml_string "$AWS_REGION")
stack = $(toml_string "$KOMRAD_STACK")
login_secret_prefix = $(toml_string "$KOMRAD_LOGIN_SECRET_PREFIX")
TOML

# try-restart rather than restart, since at boot the control plane is not up yet and must not be
# started early.
if [ -n "$previous" ] && [ "$previous" != "$(cat "$owner_env" "$config" "$ca_key")" ]; then
	systemctl try-restart komrad-control-plane.service
fi
