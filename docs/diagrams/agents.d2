...@_theme

direction: right

workflow: "workflow: neovim" {
  style.font-size: 18

  orchestrator: "orchestrator\ncoordinates the\nworkflow's tasks"

  fix-login: "task: fix-login" {
    style.font-size: 16
    grid-columns: 2
    grid-gap: 60
    writer: "writer\ndoes the work,\nowns the checkout"
    reviewer: "reviewer\nreads the\nwriter's change"
    writer -> reviewer: change {style.stroke-dash: 3}
  }

  rfc-truncate: "task: rfc-truncate" {
    style.font-size: 16
    writer
  }

  orchestrator -> fix-login {style.stroke-dash: 3}
  orchestrator -> rfc-truncate {style.stroke-dash: 3}
}
