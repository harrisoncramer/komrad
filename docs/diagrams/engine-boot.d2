...@_theme

direction: down

secrets: Secrets Manager {class: store}
params: Parameter Store {class: store}

host: Engine host {
  class: group

  userdata: User data {class: leaf}
  tailscaled: Tailscale {class: leaf}
  authkey: Auth key unit {class: leaf}
  volume: Data volume {class: leaf}
  timer: Hourly timer {class: leaf}
  creds: Credentials unit {class: leaf}
  key: GitHub key unit {class: leaf}
  caddy: Caddy {class: leaf}
  serve: Server {class: leaf}
  session: Manager session {class: leaf}

  userdata -> tailscaled
  userdata -> volume
  authkey -> tailscaled: first join {class: dashed}
  tailscaled -> caddy
  volume -> creds
  volume -> caddy
  timer -> creds {class: dashed}
  creds -> serve
  key -> serve
  serve -> session
}

rds: RDS Postgres {class: store}

host.tailscaled -> params: node key
host.authkey -> secrets: auth key
host.creds -> secrets: owner password
host.key -> secrets: App key
host.creds -> rds: migrate
