root = true

# The task scripts have no extension, so shell falls under the catch-all. Tabs
# match what shfmt writes with no flags, which is how mise run bash:fmt calls it.

[*]
indent_style = tab
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2

[*.sql]
indent_style = space
indent_size = 4
