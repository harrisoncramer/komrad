---
type Props = {
  items: { href: string; title: string; summary?: string }[];
};

const { items } = Astro.props;
---

<ul class="index-list">
  {
    items.map((item) => (
      <li>
        <a href={item.href}>
          <code>{item.title}</code>
        </a>
        {item.summary && <p>{item.summary}</p>}
      </li>
    ))
  }
</ul>
