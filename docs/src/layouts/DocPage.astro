---
import Layout from "./Layout.astro";
import { REPO_URL, SITE_TITLE } from "../consts";
import { breadcrumbs, canonical, link } from "../site";

type Neighbour = { title: string; href: string };

type Props = {
  title: string;
  description?: string;
  filePath?: string;
  prev?: Neighbour;
  next?: Neighbour;
};

const { title, description, filePath, prev, next } = Astro.props;

const markdown = `${Astro.url.pathname.replace(/\/$/, "")}.md`;

const crumbs = breadcrumbs(Astro.url.pathname, title);
const structuredData = [
  {
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonical(Astro.url.pathname),
    isPartOf: { "@type": "WebSite", name: SITE_TITLE, url: canonical(link("/")) },
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: crumbs.map((crumb, index) => ({ "@type": "ListItem", position: index + 1, ...crumb })),
  },
];
---

<Layout
  title={title}
  description={description}
  sidebar={Astro.slots.has("sidebar")}
  markdown={markdown}
  structuredData={structuredData}
>
  <slot name="sidebar" slot="sidebar" />
  <article data-pagefind-body>
    <header class="page-head">
      <div class="min-w-0">
        <h1 class="title" data-pagefind-meta="title">
          {title}
        </h1>
        {description && <p class="mt-2 mb-8 text-lg text-app-gray-light">{description}</p>}
      </div>
      <div class="page-actions" data-pagefind-ignore>
        <button
          class="page-action copy-markdown"
          type="button"
          title="Copy this page as Markdown"
          data-markdown={markdown}
        >
          <svg aria-hidden="true" viewBox="0 0 208 128">
            <rect width="198" height="118" x="5" y="5" ry="10" fill="none" stroke="currentColor" stroke-width="10" />
            <path
              fill="currentColor"
              d="M30 98V30h20l20 25 20-25h20v68H90V59L70 84 50 59v39zm125 0-30-33h20V30h20v35h20z"
            />
          </svg>
          <span class="page-action-label">For agents</span>
        </button>
        {filePath && (
          <a class="page-action" href={`${REPO_URL}/blob/main/docs/${filePath}`}>
            <svg aria-hidden="true" viewBox="0 0 16 16" fill="currentColor">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
            </svg>
            <span class="page-action-label">Edit on GitHub</span>
          </a>
        )}
      </div>
    </header>
    <div class="doc-content mt-4">
      <slot />
    </div>
    {(prev || next) && (
      <nav class="pager" aria-label="Guides" data-pagefind-ignore>
        {prev ? (
          <a class="pager-link" href={prev.href} rel="prev">
            <span class="pager-label">Previous</span>
            <span class="pager-title">&larr; {prev.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a class="pager-link pager-next" href={next.href} rel="next">
            <span class="pager-label">Next</span>
            <span class="pager-title">{next.title} &rarr;</span>
          </a>
        )}
      </nav>
    )}
  </article>
</Layout>

<style>
  @reference "../styles/global.css";

  .title {
    @apply leading-tight;
  }

  .page-head {
    @apply flex flex-col sm:flex-row sm:items-start sm:justify-between sm:gap-6;
  }

  .page-actions {
    @apply mb-6 flex shrink-0 gap-3 sm:mb-0 sm:flex-col sm:items-end sm:gap-1 sm:pt-3;
  }

  .page-action {
    @apply inline-flex cursor-pointer items-center gap-1.5 text-[11px] leading-tight whitespace-nowrap text-app-gray opacity-70 transition-opacity duration-200;
    font-family: var(--font-sans);
  }

  .page-action:hover,
  .page-action:focus-visible {
    @apply opacity-100;
  }

  .page-action svg {
    @apply h-2.5 w-auto;
  }

  .doc-content {
    @apply mb-12 flex flex-col gap-4;
  }

  .pager {
    @apply mb-24 flex justify-between gap-4 border-t border-app-background-medium pt-6;
  }

  .pager-link {
    @apply flex flex-col gap-1 text-app-gray-light transition-colors hover:text-app-blue;
    font-family: var(--font-sans);
  }

  .pager-next {
    @apply items-end text-right;
  }

  .pager-label {
    @apply text-xs tracking-wide text-app-gray-dim uppercase;
  }

  .pager-title {
    @apply text-base;
  }

  .doc-content :global(:is(h2, h3, h4)) {
    @apply mt-6 leading-tight;
  }

  .doc-content :global(:is(p, li)) {
    font-size: 1em;
    line-height: 1.7;
    color: #e6ecf5;
  }

  @media (max-width: 639.98px) {
    .doc-content :global(:is(p, li)) {
      font-size: 0.95em;
      line-height: 1.65;
    }
  }

  .doc-content :global(ul:not(.index-list) li) {
    @apply ml-6 list-disc;
  }

  .doc-content :global(ol li) {
    @apply ml-6 list-decimal;
  }

  .doc-content :global(:not(pre) > code) {
    @apply rounded-xs bg-app-background-light px-1.5 py-0.5 text-app-gray;
    font-size: 0.85em;
  }

  .doc-content :global(blockquote) {
    @apply m-0 border-l-2 border-app-blue pl-5 text-app-gray;
    font-family: var(--font-sans);
  }

  .doc-content :global(a) {
    @apply underline decoration-app-blue/40 decoration-1 underline-offset-4 transition-[text-decoration-color] duration-200;
  }

  .doc-content :global(a:hover),
  .doc-content :global(a:focus-visible) {
    @apply decoration-app-blue decoration-2;
  }
</style>

<script>
  document.querySelectorAll<HTMLPreElement>(".doc-content pre.astro-code").forEach((pre) => {
    const block = document.createElement("div");
    block.className = "code-block";
    pre.replaceWith(block);
    block.appendChild(pre);

    const button = document.createElement("button");
    button.className = "code-copy-btn";
    button.textContent = "Copy";
    block.appendChild(button);

    button.addEventListener("click", () => {
      void navigator.clipboard.writeText(pre.innerText).then(() => {
        button.textContent = "Copied!";
        setTimeout(() => {
          button.textContent = "Copy";
        }, 1500);
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".copy-markdown").forEach((button) => {
    const label = button.querySelector(".page-action-label");
    if (!label) return;
    const text = label.textContent;
    button.addEventListener("click", () => {
      const markdown = fetch(button.dataset.markdown ?? "")
        .then((response) => (response.ok ? response.text() : Promise.reject(new Error(response.statusText))))
        .then((body) => new Blob([body], { type: "text/plain" }));
      navigator.clipboard
        .write([new ClipboardItem({ "text/plain": markdown })])
        .then(
          () => (label.textContent = "Copied!"),
          () => (label.textContent = "Copy failed"),
        )
        .finally(() => setTimeout(() => (label.textContent = text), 1500));
    });
  });
</script>
