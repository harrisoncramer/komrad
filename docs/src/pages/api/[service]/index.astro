---
import DocPage from "../../../layouts/DocPage.astro";
import IndexList from "../../../components/reference/IndexList.astro";
import Sidebar from "../../../components/Sidebar.astro";
import { api, prose } from "../../../reference";
import { codeLink } from "../../../reference/refs";
import { link } from "../../../site";
import { apiSidebar } from "../../../sidebar";

export function getStaticPaths() {
  return api.services.map((service) => ({
    params: { service: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const summary = service.description
  .replace(/\n\s*\n[\s\S]*/, "")
  .replace(/\s+/g, " ")
  .replaceAll("`", "");
---

<DocPage title={service.title} summary={summary}>
  <Sidebar slot="sidebar" label="API" groups={apiSidebar({ service: service.slug })} />
  <div class="service-description" set:html={prose(service.description, codeLink({}))} />
  <p>
    <code>{service.name}</code>
  </p>
  <IndexList
    rows
    items={service.methods.map((method) => ({
      href: link(`/api/${service.slug}/${method.slug}`),
      title: method.tool,
      summary: method.summary,
      id: method.slug,
    }))}
  />
</DocPage>
