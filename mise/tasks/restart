#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_build"
source "$MISE_CONFIG_ROOT/mise/tasks/_test_instance"
#MISE description="Rebuild, then kill and restart the server and the panel, leaving agents stopped."
set -euo pipefail
require_test_instance
cd "$MISE_CONFIG_ROOT"

komrad="$MISE_CONFIG_ROOT/bin/komrad"

socket="${KOMRAD_TMUX_SOCKET:-komrad}"
addr="${KOMRAD_ADDR:-127.0.0.1:8787}"

go_build_local "$komrad"

agents="$( (tmux -L "$socket" list-panes -a -F x 2>/dev/null || true) | wc -l | tr -d ' ')"

tmux -L "$socket" kill-server 2>/dev/null || true

if ! "$komrad" stop; then
	pkill -f "komrad serve --addr $addr" 2>/dev/null || true
fi

"$komrad" migrate

engine="${KOMRAD_TEST_ENGINE:-default}"
case "${KOMRAD_DATABASE_URL:-komrad_engine_default:komrad@}" in
*"komrad_engine_$engine:komrad@"*) KOMRAD_ENGINE_PASSWORD=komrad "$komrad" engine ensure "$engine" >/dev/null ;;
esac

if ! "$komrad" start; then
	echo "warning: the server did not come up, so open the panel to see why" >&2
	echo "killed $agents panes; the server is not running"
	exit 1
fi

if ! "$komrad" open --detach; then
	echo "warning: the panel session did not come up" >&2
	exit 1
fi

# Runs komrad with the connection read from the engine file alone.
engine_komrad() {
	env -u KOMRAD_ADDR -u KOMRAD_TMUX_SOCKET -u KOMRAD_DATABASE_URL -u KOMRAD_READONLY_DATABASE_URL \
		-u KOMRAD_OWNER_DATABASE_URL -u KOMRAD_CACHE_DIR \
		"$komrad" "$@"
}

# Replaces the server of every other engine on this machine.
engines_dir="$HOME/.config/komrad/engines"
if [ "${MISE_ENV:-}" != test ] && [ -d "$engines_dir" ]; then
	for file in "$engines_dir"/*.toml; do
		[ -e "$file" ] || continue
		if grep -Eq '^[[:space:]]*(ssh|exec|forward)[[:space:]]*=' "$file"; then
			continue
		fi

		name="$(basename "$file" .toml)"
		engine_komrad stop --engine "$name" 2>/dev/null || true
		if ! engine_komrad start --engine "$name"; then
			echo "warning: the $name engine's server did not come up" >&2
		fi
	done
fi

echo "killed $agents panes and restarted the server; press prefix+g for the panel"
