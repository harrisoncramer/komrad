#!/usr/bin/env bash
set -euo pipefail

# Refreshes the database and engine credentials.

source_file=/etc/komrade/database-source.env
target=/etc/komrade/database.env

if [ ! -f "$source_file" ]; then
	echo "$source_file is missing, so the database secret cannot be located" >&2
	exit 1
fi

# shellcheck source=/dev/null
. "$source_file"

: "${KOMRADE_DATABASE_SECRET_ARN:?KOMRADE_DATABASE_SECRET_ARN is not set}"
: "${KOMRADE_DATABASE_HOST:?KOMRADE_DATABASE_HOST is not set}"
: "${KOMRADE_DATABASE_NAME:?KOMRADE_DATABASE_NAME is not set}"

secret="$(aws secretsmanager get-secret-value \
	--secret-id "$KOMRADE_DATABASE_SECRET_ARN" \
	--query SecretString \
	--output text)"

username="$(jq -re .username <<<"$secret")"

# AWS generates passwords containing characters that mean something inside a url, so the password
# is percent-encoded before being placed in one.
password="$(jq -rn --arg p "$(jq -re .password <<<"$secret")" '$p|@uri')"

owner="postgres://$username:$password@$KOMRADE_DATABASE_HOST:5432/$KOMRADE_DATABASE_NAME"
owner="$owner?sslmode=verify-full&sslrootcert=/etc/komrade/rds-ca.pem"

engine="${KOMRADE_ENGINE_NAME:-default}"
engine_password_file=/etc/komrade/engine-password
if [ ! -s "$engine_password_file" ]; then
	install -m 0600 /dev/null "$engine_password_file"
	openssl rand -hex 24 >"$engine_password_file"
fi
engine_password="$(cat "$engine_password_file")"

# HOME is named because systemd sets none for a system service and komrade looks for its config
# under one.
HOME="${HOME:-/root}" KOMRADE_OWNER_DATABASE_URL="$owner" komrade migrate
HOME="${HOME:-/root}" KOMRADE_OWNER_DATABASE_URL="$owner" KOMRADE_ENGINE_PASSWORD="$engine_password" \
	komrade engine ensure "$engine" >/dev/null

url="postgres://komrade_engine_$engine:$engine_password@$KOMRADE_DATABASE_HOST:5432/$KOMRADE_DATABASE_NAME"
url="$url?sslmode=verify-full&sslrootcert=/etc/komrade/rds-ca.pem"

previous=""
if [ -f "$target" ]; then
	previous="$(cat "$target")"
fi

# The file is created empty and private first, so the url is never briefly readable by anyone
# else. The value is quoted because it contains an ampersand, which anything sourcing this file in
# a shell would otherwise read as a command separator.
install -m 0600 /dev/null "$target"
cat >"$target" <<ENV
KOMRADE_DATABASE_URL='$url'
ENV

# try-restart rather than restart, since at boot komrade is not up yet and must not be started early.
if [ -n "$previous" ] && [ "$previous" != "$(cat "$target")" ]; then
	systemctl try-restart komrade.service
fi
