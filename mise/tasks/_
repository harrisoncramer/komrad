#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_build"
: "${DB_PORT:=5460}"
export DB_PORT
export WEAVE_DATABASE_URL="${WEAVE_DATABASE_URL:-postgres://weave:weave@localhost:${DB_PORT}/weave?sslmode=disable}"
export DATABASE_URL="$WEAVE_DATABASE_URL"

adminURL() {
	echo "${DATABASE_URL%/*}/postgres?sslmode=disable"
}

shell_scripts() {
	local roots=(mise/tasks internal/scripts/builtin packer/scripts packer/files)

	for root in "${roots[@]}"; do
		if [ ! -d "$root" ]; then
			echo "shell_scripts: no directory at $root" >&2

			return 1
		fi
	done

	find "${roots[@]}" -type f -exec file {} + | grep -i 'shell script' | cut -d: -f1
}
