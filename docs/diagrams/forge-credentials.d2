...@_theme

direction: right

host: Engine host {
  class: group
  key: App key {class: store}
  connection: GitLab token {class: store}
  helper: Credential helper {class: leaf}

  key -> helper
  connection -> helper
}

github: GitHub {class: leaf}
gitlab: GitLab {class: leaf}

host.helper -> github
host.helper -> gitlab
