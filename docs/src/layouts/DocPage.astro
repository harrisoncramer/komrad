---
import Layout from "./Layout.astro";

type Props = {
  title: string;
  description?: string;
};

const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
  <article data-pagefind-body>
    <h1 class="mb-4" data-pagefind-meta="title">{title}</h1>
    {description && <p class="text-lg mb-8 text-app-gray">{description}</p>}
    <div class="doc-content">
      <slot />
    </div>
  </article>
</Layout>
