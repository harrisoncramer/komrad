#!/bin/sh
#WEAVE description="Open a shell in the agent's directory, beside its pane."
# What the panel's terminal key runs. Write your own _terminal in your actions directory
# to replace it.
#
# The shell is named rather than left out. respawn-pane with no command re-runs whatever
# the pane ran last, so a pane the editor had claimed would open the editor again.
set -eu

tmux -L "$WEAVE_TMUX_SOCKET" respawn-pane -k \
	-t "$WEAVE_SECONDARY_PANE" \
	-c "${WEAVE_AGENT_CWD:-$HOME}" \
	"${WEAVE_SHELL:-${SHELL:-/bin/sh}}"

exec tmux -L "$WEAVE_TMUX_SOCKET" select-pane -t "$WEAVE_SECONDARY_PANE"
