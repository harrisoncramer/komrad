#!/usr/bin/env bash
set -euo pipefail

source_file=/etc/komrad/control-plane.env

if [ ! -f "$source_file" ]; then
	echo "$source_file is missing, so the owner login cannot be located" >&2
	exit 1
fi

# shellcheck source=/dev/null
. "$source_file"

: "${KOMRAD_DATABASE_SECRET_ARN:?KOMRAD_DATABASE_SECRET_ARN is not set}"
: "${KOMRAD_DATABASE_HOST:?KOMRAD_DATABASE_HOST is not set}"
: "${KOMRAD_DATABASE_NAME:?KOMRAD_DATABASE_NAME is not set}"

secret="$(aws secretsmanager get-secret-value \
	--secret-id "$KOMRAD_DATABASE_SECRET_ARN" \
	--query SecretString \
	--output text)"

username="$(jq -re .username <<<"$secret")"

# AWS generates passwords containing characters that mean something inside a url, so the password
# is percent-encoded before being placed in one.
password="$(jq -rn --arg p "$(jq -re .password <<<"$secret")" '$p|@uri')"

echo "postgres://$username:$password@$KOMRAD_DATABASE_HOST:5432/$KOMRAD_DATABASE_NAME?sslmode=verify-full&sslrootcert=/etc/komrad/rds-ca.pem"
