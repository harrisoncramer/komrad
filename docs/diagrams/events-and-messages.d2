...@_theme

direction: down

change: One transaction {
  class: group
  grid-columns: 2
  horizontal-gap: 150
  change: The change {class: leaf}
  event: The event {class: leaf}
}

handle: One transaction {
  class: group
  grid-columns: 3
  horizontal-gap: 150
  find: Handler {class: leaf}
  write: Mail {class: leaf}
  done: Done {class: leaf}
  find -> write -> done
}

delivered: Delivered {class: leaf}

change -> handle: a moment later
handle -> delivered
