#!/bin/sh
#WEAVE description="A workflow's setup action when its worktree toggle is on. Configure it from the workflow's edit form; it does not take an argument of its own."
set -eu

repo="$WEAVE_WORKTREE_REPO"
tree="$WEAVE_WORKTREES_DIR/$WEAVE_AGENT_ID"

apply_paths() {
	list="$1"
	kind="$2"
	root=$(cd "$tree" && pwd -P)
	printf '%s\n' "$list" | while IFS= read -r p; do
		if [ -z "$p" ]; then
			continue
		fi
		src="$repo/$p"
		dest="$tree/$p"
		if [ ! -e "$src" ]; then
			echo "worktree setup: $p not found in $repo, skipping $kind" >&2
			continue
		fi

		outside=
		case "/$p/" in
		*/./* | */../* | */.git/*) outside=yes ;;
		esac

		if [ -z "$outside" ]; then
			existing=$(dirname "$dest")
			while [ ! -d "$existing" ]; do
				existing=$(dirname "$existing")
			done
			existing=$(cd "$existing" && pwd -P)
			case "$existing" in
			"$root" | "$root"/*) ;;
			*) outside=yes ;;
			esac
		fi
		if [ -n "$outside" ]; then
			echo "worktree setup: $p is not a path inside the worktree, skipping $kind" >&2
			continue
		fi

		if git -C "$repo" ls-files --error-unmatch -- "$p" >/dev/null 2>&1; then
			echo "worktree setup: $p is tracked, skipping $kind" >&2
			continue
		fi

		mkdir -p "$(dirname "$dest")"

		# A path applied earlier in this run leaves a directory that cp and ln would nest inside
		# rather than replace.
		if ! rm -rf "$dest"; then
			echo "worktree setup: could not clear $dest, skipping $kind of $p" >&2
			continue
		fi
		if [ "$kind" = copy ]; then
			cp -rf "$src" "$dest" || echo "worktree setup: failed to copy $p" >&2
		else
			ln -sfn "$src" "$dest" || echo "worktree setup: failed to symlink $p" >&2
		fi
	done
}

if [ -d "$tree" ]; then
	echo "worktree already exists at $tree" >&2
else
	base="$WEAVE_WORKTREE_BASE_BRANCH"
	if [ -z "$base" ]; then
		base=$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@') || true
		if [ -z "$base" ]; then
			base=$(git -C "$repo" rev-parse --abbrev-ref HEAD)
		fi
	fi

	point="$base"
	if git -C "$repo" remote get-url origin >/dev/null 2>&1; then
		echo "fetching $base from origin" >&2
		if git -C "$repo" fetch --quiet origin "$base" >&2; then
			point="origin/$base"
		fi
	fi

	mkdir -p "$WEAVE_WORKTREES_DIR"
	echo "creating a worktree at $tree from $point" >&2

	# --no-track leaves the branch with no upstream, so git status inside the worktree measures
	# the agent against nothing but its own branch, and the add writes no branch config, which
	# is the shared lock every concurrent create would otherwise fail on.
	if ! git -C "$repo" worktree add --no-track -B "agent/$WEAVE_AGENT_ID" "$tree" "$point" >&2; then
		# A directory removed without telling git leaves a registration behind that still claims
		# the branch. Pruning only once something is blocking this add keeps the blast radius
		# small, since a prune drops the registration of every worktree whose directory it
		# cannot see, including one on a volume that is merely unmounted right now.
		echo "worktree setup: pruning stale worktree registrations and trying once more" >&2
		git -C "$repo" worktree prune 2>/dev/null || true
		git -C "$repo" worktree add --no-track -B "agent/$WEAVE_AGENT_ID" "$tree" "$point" >&2
	fi

	# With no upstream, a plain push has nothing to push to until this is set. --local in a
	# linked worktree writes the shared config, so this also decides what a plain push does in
	# the human's own checkout of the repo, and it is left alone if they have already set it.
	if ! git -C "$tree" config --get push.autoSetupRemote >/dev/null 2>&1; then
		git -C "$tree" config --local push.autoSetupRemote true 2>/dev/null || true
		if ! git -C "$tree" config --get push.autoSetupRemote >/dev/null 2>&1; then
			echo "worktree setup: could not set push.autoSetupRemote, so the first push needs -u" >&2
		fi
	fi

	# Only a worktree this run made is furnished. One that was already there holds
	# whatever the agent has done to it since, and copying a directory over one that
	# is already present nests it a level deeper every time.
	apply_paths "$WEAVE_WORKTREE_COPY_PATHS" copy || true
	apply_paths "$WEAVE_WORKTREE_SYMLINK_PATHS" symlink || true
fi

printf '%s' "$tree" >"$WEAVE_SETUP_DIR_FILE"
