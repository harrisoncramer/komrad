#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
set -euo pipefail
#MISE description="Record the docs site's videos and stills into recordings/prod."

usage() {
	echo "Usage: mise run docs:recordings [name...]"
	echo
	echo "Records every script under recordings/prod, or only the ones named, against an"
	echo "empty throwaway instance, and writes <name>.mp4, <name>.webm and <name>.png"
	echo "beside each tape, untracked. The png is the last frame, which is a video's"
	echo "poster or a still on its own. A <name>.before script beside the recording runs"
	echo "against the fresh instance first, to set up what the recording should not show,"
	echo "and a <name>.after script runs once it is done, to clear what it made. Both run"
	echo "in the throwaway instance's environment, with this checkout's komrad first on"
	echo "the path, so KOMRAD_CONFIG names the instance's config file."
	echo
	echo "Every recording drops the throwaway instance's database first, so nothing"
	echo "recorded depends on what was there. Publish what it made to the docs site"
	echo "with 'mise run infra:docs:recordings upload'."
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	esac
done

cd "$MISE_CONFIG_ROOT"

run_script() {
	MISE_ENV="test" mise exec -- env -u KOMRAD_AGENT_ID -u KOMRAD_SESSION_ID PATH="$MISE_CONFIG_ROOT/bin:$PATH" "$1"
}

SCRIPTS=(recordings/prod/*.tape)
if [ $# -gt 0 ]; then
	SCRIPTS=()
	for name in "$@"; do
		if [ ! -f "recordings/prod/$name.tape" ]; then
			echo "no recording named $name under recordings/prod" >&2
			exit 1
		fi

		SCRIPTS+=("recordings/prod/$name.tape")
	done
fi

for script in "${SCRIPTS[@]}"; do
	name="$(basename "$script" .tape)"
	before="recordings/prod/$name.before"
	after="recordings/prod/$name.after"

	gum log --level info "recording $name"

	MISE_ENV="test" mise run test:reset >/dev/null
	MISE_ENV="test" mise run restart >/dev/null

	if [ -x "$before" ]; then
		run_script "$before"
	fi

	MISE_ENV="test" mise run record "$MISE_CONFIG_ROOT/$script"

	if [ -x "$after" ]; then
		run_script "$after"
	fi

	rm -f "recordings/prod/$name.gif"
done

MISE_ENV="test" mise run restart >/dev/null

gum log --level info "recorded into recordings/prod"
