#!/usr/bin/env bash
#MISE description="Restart serve and the panel so they pick up air's latest binary."
set -euo pipefail
cd "$MISE_CONFIG_ROOT"

weave="$MISE_CONFIG_ROOT/bin/weave"

# air (mise run go:dev) owns rebuilding bin/weave on save. Reload does not build; it
# restarts the long-lived processes still running the old binary.
if ! pgrep -x air >/dev/null 2>&1; then
	echo "warning: air is not running; start it with 'mise run go:dev' so saves rebuild the binary"
fi

if [ ! -x "$weave" ]; then
	echo "bin/weave missing; building once (start air to keep it fresh)"
	go build -o "$weave" .
fi

# Asking rather than signalling, so serve is given its own shutdown and this waits for
# however long that actually takes instead of guessing at a timeout. A build too old to
# hold the stop route is reported by the command itself, and the pkill below is what
# clears it.
if ! "$weave" stop; then
	echo "falling back to a signal" >&2
	pkill -f "/weave serve" 2>/dev/null || true
	for _ in $(seq 1 120); do
		pgrep -f "/weave serve" >/dev/null 2>&1 || break
		sleep 0.25
	done
	if pgrep -f "/weave serve" >/dev/null 2>&1; then
		echo "error: serve process would not die; kill it by hand" >&2
		exit 1
	fi
fi

# The panel and every agent live on a tmux server of their own, which a plain tmux command
# does not address. The socket is the same one the binary resolves from the environment.
socket="${WEAVE_TMUX_SOCKET:-weave}"
panel_pane="$(tmux -L "$socket" show -gv @weave_pane 2>/dev/null || true)"

if [ -z "$panel_pane" ]; then
	echo "no panel is running, so open it (prefix+g) to start both from the current binary"
	exit 0
fi

# Respawning the pane restarts the panel in place, keeping the session and the environment
# open recorded on it. The panel clears its own window and spawns serve as it starts, so
# both come back on the current binary with the agents left running.
tmux -L "$socket" respawn-pane -k -t "$panel_pane" -c "$MISE_CONFIG_ROOT" "$weave"

echo "restarted the panel and its serve from the current binary; agents were left running"
