#!/usr/bin/env bash
#MISE description="Run the panel against a fake service, to look at a screen without a database or an agent."
set -euo pipefail
cd "$MISE_CONFIG_ROOT"

# An argument of any kind is the caller saying what they want, including -list and -help.
if [ "$#" -gt 0 ]; then
	exec go run ./cmd/paneldemo "$@"
fi

if ! command -v gum >/dev/null; then
	echo "gum is not on PATH, so name a scenario yourself: mise run demo -- -scenario <name>" >&2
	exit 1
fi

chosen=$(go run ./cmd/paneldemo -list | gum choose --header "Draw the panel against which scenario?" || true)

if [ -z "$chosen" ]; then
	echo "no scenario chosen" >&2
	exit 1
fi

exec go run ./cmd/paneldemo -scenario "${chosen%% *}"
