#!/bin/bash
# Interactive panel of Claude agents. Meant to run inside a tmux popup.
# Usage: claude-panel <invoking-client-name>
# Pick an agent, then pick an action: jump / chat / send message. Esc closes.
set -euo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"
client="${1:-}"
[ -n "$client" ] || client="$(tmux -L default list-clients -F '#{client_name}' | head -1)"
reg="${CLAUDE_AGENTS_DIR:-$HOME/.claude/agents}"

field() { sed -n "s/^$1=//p" "$2" | head -1; }

files=(); labels=()
for f in "$reg"/*; do
  [ -e "$f" ] || continue
  fpane="$(field PANE "$f")"
  # Drop stale entries whose pane no longer exists.
  if [ -n "$fpane" ] && [ "$(tmux -L default display-message -p -t "$fpane" '#{pane_id}' 2>/dev/null)" != "$fpane" ]; then
    rm -f "$f"
    continue
  fi
  files+=("$f")
  sess="$(field SESSION "$f")"; st="$(field STATE "$f")"; msg="$(field MSG "$f")"
  case "$st" in
    done)     icon="✓" ;;
    thinking) icon="…" ;;
    *)        icon="•" ;;
  esac
  label="$icon  $sess"
  [ -n "$msg" ] && label="$label  —  $msg"
  labels+=("$label")
done

NEW_LABEL="+  new chat"
LAST_LABEL="←  last window/session"

# The nav entries are always available, even with no agents.
if [ ${#files[@]} -eq 0 ]; then
  choice="$(printf '%s\n' "$NEW_LABEL" "$LAST_LABEL" | gum choose --header 'Claude agents')" || exit 0
else
  choice="$(printf '%s\n' "$NEW_LABEL" "$LAST_LABEL" "${labels[@]}" | gum choose --header 'Claude agents')" || exit 0
fi
[ -n "$choice" ] || exit 0

case "$choice" in
  "$NEW_LABEL")
    # New session for more background work, rooted at the current terminal's dir.
    dir="$(tmux -L default display-message -p ${client:+-c "$client"} '#{pane_current_path}' 2>/dev/null)"
    [ -n "$dir" ] || dir="$HOME"
    sess="$(tmux -L default new-session -d -c "$dir" -P -F '#{session_name}' 2>/dev/null)"
    [ -n "$sess" ] && tmux -L default switch-client ${client:+-c "$client"} -t "$sess" 2>/dev/null || true
    exit 0
    ;;
  "$LAST_LABEL")
    tmux -L default switch-client ${client:+-c "$client"} -l 2>/dev/null || true
    exit 0
    ;;
esac

idx=-1
for i in "${!labels[@]}"; do
  [ "${labels[$i]}" = "$choice" ] && idx="$i" && break
done
[ "$idx" -ge 0 ] || exit 0

file="${files[$idx]}"
[ -f "$file" ] || exit 0
session="$(field SESSION "$file")"
pane="$(field PANE "$file")"

action="$(printf 'jump\nchat\n' | gum choose --header "$session")" || exit 0

case "$action" in
  jump)
    loc=""
    [ -n "$pane" ] && loc="$(tmux -L default display-message -p -t "$pane" '#{session_name}:#{window_index}' 2>/dev/null || echo)"
    tmux -L default switch-client ${client:+-c "$client"} -t "$session" 2>/dev/null || true
    if [ -n "$loc" ]; then
      tmux -L default select-window -t "$loc" 2>/dev/null || true
      tmux -L default select-pane -t "$pane" 2>/dev/null || true
    fi
    ;;
  chat)
    # Reopen as a large popup attached to the agent's session, once this small
    # panel popup has closed and freed the client.
    tmux -L default run-shell -b "$DIR/claude-chat-open '$session' '$pane'"
    ;;
  *)
    exit 0
    ;;
esac
