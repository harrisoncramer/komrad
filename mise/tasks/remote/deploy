#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
source "$MISE_CONFIG_ROOT/mise/tasks/remote/_remote_utils"
set -euo pipefail
#MISE description="Put this checkout's komrad on the control plane and every running engine."

usage() {
	echo "Usage: mise run remote:deploy"
	echo
	echo "Cross-compiles komrad, installs it on the control plane, which migrates the database"
	echo "and restarts, and then on every running engine, restarting its server. A stopped"
	echo "engine keeps its last build until the first deploy after it starts."
	echo
	echo "A clean deploy carries this checkout's commit, which is what the panel compares"
	echo "against, so a panel built from the same commit needs nothing further. A deploy"
	echo "from a dirty tree names no commit, so it also builds a local binary at the same"
	echo "version for you to put in place of your own komrad."
	echo
	echo "KOMRAD_VERSION names the version the binary reports, which is how a release deploy"
	echo "puts its own tag on the engines. It is refused from a dirty tree."
	echo
	echo "The binaries land in dist/."
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	*)
		usage >&2
		exit 1
		;;
	esac
done

cd "$MISE_CONFIG_ROOT"

use_komrad_aws_profile

CONTROL_PLANE="$(require_instance control-plane)"
REGION="$(engine_region)"
BUCKET="$(require_output state_bucket)"

STATE="$(instance_state "$CONTROL_PLANE" "$REGION")"
if [ "$STATE" != running ]; then
	echo "the control plane is ${STATE:-unreadable}, so nothing was deployed." >&2
	exit 1
fi

REVISION="$(git rev-parse --short HEAD)"
DIRTY=""
if tree_is_dirty; then
	DIRTY="$(dirty_suffix)"
fi

# A dirty build carries no commit, so its version string is the only thing anybody has to go on.
# Letting a caller name that version would put a binary on the engine that answers v0.3.0 and is
# not v0.3.0, which is why this refuses rather than annotating what it was given.
if [ -n "${KOMRAD_VERSION:-}" ] && [ -n "$DIRTY" ]; then
	echo "KOMRAD_VERSION names $KOMRAD_VERSION, and this tree has uncommitted changes." >&2
	echo >&2
	echo "Commit them, or unset KOMRAD_VERSION and deploy under the engine stamp." >&2
	exit 1
fi

VERSION="${KOMRAD_VERSION:-v0.0.0-engine.$REVISION$DIRTY}"

mkdir -p dist
go_build_binary linux arm64 "$VERSION" dist/komrad-linux-arm64
if [ -n "$DIRTY" ]; then
	go_build_binary "$(go env GOOS)" "$(go env GOARCH)" "$VERSION" dist/komrad-panel
else
	rm -f dist/komrad-panel
fi

STAGE="deploy/$VERSION"

# stage uploads a file for the instances to fetch and prints a link to it that expires.
stage() {
	local file=$1 key

	key="$STAGE/$(basename "$file")"
	aws s3 cp "$file" "s3://$BUCKET/$key" --only-show-errors
	aws s3 presign "s3://$BUCKET/$key" --expires-in 900 --region "$REGION"
}

trap 'aws s3 rm "s3://$BUCKET/$STAGE/" --recursive --only-show-errors || true' EXIT

# install_command prints the commands that fetch a staged file and install it with a mode.
install_command() {
	local url=$1 mode=$2 path=$3

	echo "curl -fsSL -o /tmp/komrad-deploy '$url'"
	echo "install -m $mode /tmp/komrad-deploy $path"
	echo "rm -f /tmp/komrad-deploy"
}

BINARY_URL="$(stage dist/komrad-linux-arm64)"
OWNER_URL="$(stage packer/files/komrad-owner-database-url)"
CONTROL_PLANE_CREDENTIALS_URL="$(stage packer/files/komrad-control-plane-credentials)"
ENGINE_CREDENTIALS_URL="$(stage packer/files/komrad-engine-credentials)"

# The instances fetch each file themselves, so nothing large travels through the command and they
# need no permission on the bucket.
mapfile -t CONTROL_PLANE_COMMANDS < <(
	echo "set -e"
	install_command "$BINARY_URL" 0755 /usr/local/bin/komrad
	install_command "$OWNER_URL" 0700 /usr/local/sbin/komrad-owner-database-url
	install_command "$CONTROL_PLANE_CREDENTIALS_URL" 0755 /usr/local/sbin/komrad-control-plane-credentials
	echo "systemctl start komrad-control-plane-credentials.service"
	echo "systemctl restart komrad-control-plane.service"
)

mapfile -t ENGINE_COMMANDS < <(
	echo "set -e"
	install_command "$BINARY_URL" 0755 /usr/local/bin/komrad
	install_command "$ENGINE_CREDENTIALS_URL" 0755 /usr/local/sbin/komrad-engine-credentials
	echo "systemctl start komrad-engine-credentials.service"
	echo "systemctl restart komrad.service"
)

gum log --level info "deploying $VERSION to the control plane"
run_on_instance "$CONTROL_PLANE" "$REGION" "${CONTROL_PLANE_COMMANDS[@]}" >/dev/null

FAILED=()
while read -r name instance; do
	if [ "$name" = control-plane ]; then
		continue
	fi

	# Systems Manager refuses an instance that is not running, so a stopped engine is skipped.
	STATE="$(instance_state "$instance" "$REGION")"
	if [ "$STATE" != running ]; then
		gum log --level info "$name is ${STATE:-unreadable}, so it keeps its last build"
		continue
	fi

	gum log --level info "deploying $VERSION to $name"
	if ! run_on_instance "$instance" "$REGION" "${ENGINE_COMMANDS[@]}" >/dev/null; then
		FAILED+=("$name")
	fi
done < <(instances)

if [ "${#FAILED[@]}" -gt 0 ]; then
	echo "the install did not finish on ${FAILED[*]}" >&2
	exit 1
fi

echo "deployed: $VERSION"
if [ -n "$DIRTY" ]; then
	echo "panel:    dist/komrad-panel at $VERSION, since a dirty build is known by its version alone"
fi
