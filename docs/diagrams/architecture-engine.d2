...@_theme

direction: right

laptop: Laptop {
  class: group
  panel: Panel {class: leaf}
  tmux: Local tmux {class: leaf}
}

actions: GitHub Actions {
  class: group
  release: Release {class: leaf}
}

aws: AWS {
  class: group

  ec2: "EC2, fixed IP" {
    class: group
    serve: Server {class: leaf}
    agents: Agents {class: leaf}
    volume: Data volume {class: store}
  }

  rds: RDS Postgres {class: store}

  ec2.serve -> rds
}

laptop.panel -> aws.ec2.serve: ssh -L
actions.release -> aws.ec2: ssm
