...@_theme

direction: right

panel: Panel {class: leaf}
idp: Identity provider {class: leaf}
operator: Operator {class: leaf}
ci: GitHub Actions {class: leaf}

host: Engine host {
  class: group

  caddy: Caddy {class: leaf}
  public: Public listener {class: leaf}
  api: API {class: leaf}
  loopback: Loopback listener {class: leaf}
  agent: SSM agent {class: leaf}
  shell: Shell {class: leaf}

  caddy -> public
  public -> api: checked
  loopback -> api
  agent -> shell
  shell -> loopback {class: dashed}
}

grants: Grants {class: store}

panel -> idp: sign in
panel -> host.caddy: HTTPS and token
host.public -> grants
operator -> host.agent
ci -> host.agent
