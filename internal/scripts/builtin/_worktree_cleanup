#!/bin/sh
#KOMRAD description="Komrad's own script for giving an agent's worktree back, run when its workflow's worktree toggle is on. Not yours to name or fire."
set -eu

tree="$KOMRAD_AGENT_CWD"
branch="$KOMRAD_WORKTREE_BRANCH"
adopted="${KOMRAD_WORKTREE_ADOPT_BRANCH:-}"

# A directory removed by hand leaves its registration locked, which no prune drops.
if [ ! -e "$tree" ]; then
	if [ "$(basename "$tree")" = "$KOMRAD_WORKTREE_NAME" ] && [ -n "${KOMRAD_WORKTREE_REPO:-}" ]; then
		git -C "$KOMRAD_WORKTREE_REPO" worktree unlock "$tree" 2>/dev/null || true
		git -C "$KOMRAD_WORKTREE_REPO" worktree remove --force "$tree" 2>/dev/null || true
	fi
	exit 0
fi

if [ ! -d "$tree" ] || [ ! -f "$tree/.git" ]; then
	exit 0
fi

# Resolved once, since worktree list reports resolved paths and comparing them against an
# unresolved one silently matches nothing on any machine whose temp or home path is a symlink.
tree=$(cd "$tree" && pwd -P)

# Being a worktree is not proof of being this agent's worktree: one made by hand passes the
# check above, and the launch path reaches cleanup with the agent's cwd still set to whatever
# the workflow named when setup never got as far as replacing it. Setup gives the directory the
# worktree name komrad hands it, and nothing an agent does renames it, so the directory's own
# name is the claim. A worktree komrad did not make carries a name a human chose, never one
# komrad hands out, and the branch the tree is on proves nothing once an agent detaches HEAD
# or works on a branch of its own.
if [ "$(basename "$tree")" != "$KOMRAD_WORKTREE_NAME" ]; then
	echo "worktree cleanup: $tree is not named $KOMRAD_WORKTREE_NAME, so it is not this agent's to remove" >&2
	exit 0
fi

# The .git file names an absolute path back into the repo, so a repo that has moved and a
# registration that is already gone both leave git with nothing to answer from. Exiting zero
# on that would record a clean deprovision for a directory and a branch still on disk.
if ! common_dir=$(git -C "$tree" rev-parse --git-common-dir 2>/dev/null); then
	gitdir=$(sed -n 's|^gitdir: ||p' "$tree/.git")
	echo "worktree cleanup: git cannot read $tree, whose .git names $gitdir; the repo has moved or the registration is gone, so that directory and the branch $branch have to be dealt with by hand" >&2
	exit 1
fi
repo=$(dirname "$common_dir")

# worktree remove --force reads a nested worktree as an ordinary untracked directory, deletes
# its files, and leaves git holding a registration for a checkout that is no longer there. A
# listing that could not be read is not proof that there is nothing nested.
if ! registered=$(git -C "$repo" worktree list --porcelain); then
	echo "worktree cleanup: could not list the worktrees of $repo, so $tree is being left alone" >&2
	exit 1
fi

# Through the environment rather than -v, which processes escape sequences in the value and so
# would hand awk something other than a path holding a backslash.
nested=$(printf '%s\n' "$registered" | sed -n 's|^worktree ||p' | prefix="$tree/" awk 'index($0, ENVIRON["prefix"]) == 1')
if [ -n "$nested" ]; then
	echo "worktree cleanup: $tree holds another registered worktree, so it is being left alone:" >&2
	printf '%s\n' "$nested" >&2
	exit 1
fi

# Nobody is left to ask by the time cleanup runs and the agent's row is already going, so a
# dirty worktree does not block the delete. What went with it is written down instead.
dirty=$(git -C "$tree" status --porcelain --untracked-files=all 2>/dev/null) || dirty=""
if [ -n "$dirty" ]; then
	echo "worktree cleanup: removing $tree along with uncommitted changes:" >&2
	printf '%s\n' "$dirty" >&2
fi

git -C "$repo" worktree unlock "$tree" 2>/dev/null || true
if ! git -C "$repo" worktree remove --force "$tree" >&2; then
	echo "worktree cleanup: could not remove $tree, so the branch $branch is being left with it" >&2
	exit 1
fi

git -C "$repo" update-ref -d "refs/komrad/stand/$KOMRAD_WORKTREE_NAME" 2>/dev/null || true

# An adopted branch was somebody else's before this agent was on it, so it outlives the agent
# whatever state it is in. Nothing below this line runs for one.
if [ -n "$adopted" ]; then
	echo "worktree cleanup: kept the branch $adopted, which was adopted rather than made here" >&2
	exit 0
fi

# Exit 1 is the only status that means the branch is not there; anything else is a git that
# could not answer, and deciding what to do about a branch on that basis is guesswork.
found=0
git -C "$repo" show-ref --quiet --verify "refs/heads/$branch" || found=$?
if [ "$found" -eq 1 ]; then
	exit 0
fi
if [ "$found" -ne 0 ]; then
	echo "worktree cleanup: could not tell whether the branch $branch is still there, so it is being left" >&2
	exit 1
fi

# The branch is worth keeping exactly when it is the only copy of the agent's commits.
# Reachability answers that; merge state does not, since the branch has no upstream and so a
# merge check measures it against the repo's HEAD alone, which reads a branch cut from origin
# as unmerged whenever the local base is behind.
elsewhere=$(git -C "$repo" for-each-ref --format='%(refname)' --contains "$branch" | grep -F -x -v "refs/heads/$branch" || true)
if [ -z "$elsewhere" ]; then
	echo "worktree cleanup: kept the branch $branch, whose commits are on no other ref" >&2
	exit 0
fi

git -C "$repo" branch -D "$branch" >&2 || echo "worktree cleanup: could not delete the branch $branch" >&2
