#!/usr/bin/env bash
set -euo pipefail

# Writes the engine's database url and forge proxy from the secret the control plane fills.

env_file=/etc/komrad/engine.env
database_env=/etc/komrad/database.env
forge_proxy=/etc/komrad/forge-proxy.toml
git_proxy=/etc/komrad/git-proxy.gitconfig

if [ ! -f "$env_file" ]; then
	echo "$env_file is missing, so the engine's secret cannot be located" >&2
	exit 1
fi

# shellcheck source=/dev/null
. "$env_file"
export AWS_REGION

: "${KOMRAD_ENGINE_NAME:?KOMRAD_ENGINE_NAME is not set}"
: "${KOMRAD_ENGINE_SECRET:?KOMRAD_ENGINE_SECRET is not set}"
: "${KOMRAD_DATABASE_HOST:?KOMRAD_DATABASE_HOST is not set}"
: "${KOMRAD_DATABASE_NAME:?KOMRAD_DATABASE_NAME is not set}"
: "${KOMRAD_FORGE_PROXY_ADDR:?KOMRAD_FORGE_PROXY_ADDR is not set}"

# The control plane writes the secret the first time it runs, which on a new stack can be after
# this engine has booted.
value=""
for attempt in {1..240}; do
	if value="$(aws secretsmanager get-secret-value --secret-id "$KOMRAD_ENGINE_SECRET" \
		--query SecretString --output text 2>&1)"; then
		break
	fi

	if [ $((attempt % 12)) -eq 1 ]; then
		echo "waiting for the control plane to write $KOMRAD_ENGINE_SECRET: $value" >&2
	fi
	value=""
	sleep 5
done

if [ -z "$value" ]; then
	echo "the control plane never wrote $KOMRAD_ENGINE_SECRET, so the server has no database login" >&2
	exit 1
fi

password="$(jq -re .password <<<"$value")"
credential="$(jq -re .forge_proxy_credential <<<"$value")"

url="postgres://komrad_engine_$KOMRAD_ENGINE_NAME:$password@$KOMRAD_DATABASE_HOST:5432/$KOMRAD_DATABASE_NAME"
url="$url?sslmode=verify-full&sslrootcert=/etc/komrad/rds-ca.pem"
proxy="http://$KOMRAD_ENGINE_NAME:$credential@$KOMRAD_FORGE_PROXY_ADDR"

previous="$(cat "$database_env" "$forge_proxy" "$git_proxy" 2>/dev/null || true)"

# Each file is created empty and private first, so its credential is never briefly readable by
# anyone else. The url is quoted because its ampersand would split a shell sourcing the file.
install -m 0600 /dev/null "$database_env"
cat >"$database_env" <<ENV
KOMRAD_DATABASE_URL='$url'
ENV

install -m 0640 -g komrad /dev/null "$forge_proxy"
cat >"$forge_proxy" <<TOML
[forge_proxy]
url = "$proxy"
ca_file = "/etc/komrad/forge-proxy-ca.pem"
TOML

install -m 0640 -g komrad /dev/null "$git_proxy"
cat >"$git_proxy" <<GITCONFIG
[http "https://github.com/"]
	proxy = $proxy
GITCONFIG

# try-restart rather than restart, since at boot komrad is not up yet and must not be started early.
if [ -n "$previous" ] && [ "$previous" != "$(cat "$database_env" "$forge_proxy" "$git_proxy")" ]; then
	systemctl try-restart komrad.service
fi
