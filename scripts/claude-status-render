#!/bin/bash
# Render a global summary of all Claude agents for the tmux status bar.
# Counts registry files by STATE. Prints tmux-format text (fg codes inline).
# Runs on every status-interval, so keep it cheap and side-effect free.
reg="${CLAUDE_AGENTS_DIR:-$HOME/.claude/agents}"
base="#[fg=#7E9CD8]"

w=0; d=0
if [ -d "$reg" ]; then
  for f in "$reg"/*; do
    [ -e "$f" ] || continue
    case "$(sed -n 's/^STATE=//p' "$f" | head -1)" in
      thinking) w=$((w+1)) ;;
      done)     d=$((d+1)) ;;
    esac
  done
fi

out=""
[ "$w" -gt 0 ] && out="#[fg=#FF9E3B]${w} working${base}"
[ "$d" -gt 0 ] && out="${out}${out:+  }#[fg=#E82424]${d} done${base}"
[ -n "$out" ] && printf '%s  ' "$out"
