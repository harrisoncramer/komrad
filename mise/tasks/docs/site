#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
set -euo pipefail
#MISE description="Serve the versioned docs site locally, laid out the way it is deployed."

usage() {
	echo "Usage: mise run docs:site [version...]"
	echo
	echo "Builds this checkout as latest, and again under each version named, into"
	echo "docs/site/<version>, writes docs/site/versions.json listing them, and serves"
	echo "docs/site on http://localhost:4330. The named versions are this checkout under"
	echo "another name, oldest first, there to exercise the version picker before any"
	echo "release exists:"
	echo
	echo "    mise run docs:site v0.1.0 v0.2.0"
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	esac
done

cd "$MISE_CONFIG_ROOT/docs"

docs_install

rm -rf site
mkdir site

PUBLIC_DOCS_COMMIT="$(build_commit)"
export PUBLIC_DOCS_COMMIT

stable="[]"
for version in latest "$@"; do
	gum log --level info "building docs as $version"
	PUBLIC_DOCS_VERSION="$version" npx astro build --outDir "site/$version" >/dev/null
	npx pagefind --site "site/$version" >/dev/null

	if [ "$version" != latest ]; then
		stable="$(jq --arg version "$version" --arg commit "$PUBLIC_DOCS_COMMIT" '. + [{version: $version, commit: $commit}]' <<<"$stable")"
	fi
done

jq -n --argjson stable "$stable" --arg commit "$PUBLIC_DOCS_COMMIT" \
	'{stable: ($stable | reverse), unstable: [{version: "latest", commit: $commit}]}' >site/versions.json

cat >site/index.html <<'HTML'
<!doctype html>
<meta http-equiv="refresh" content="0; url=/latest/">
HTML

cat >site/robots.txt <<'ROBOTS'
User-agent: *
Allow: /

Sitemap: https://komrad.dev/latest/sitemap-index.xml
ROBOTS

gum log --level info "serving docs/site on http://localhost:4330/latest/"
python3 -m http.server 4330 --directory site
