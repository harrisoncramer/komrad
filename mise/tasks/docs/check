#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
set -euo pipefail
#MISE description="Refuse a doc for people who installed weave that names the task runner."

usage() {
	echo "Usage: mise run docs:check"
	echo
	echo "Reads the README and every page under docs and fails on any line that says"
	echo "'mise', since a person who installed the binary has no checkout to run a task"
	echo "in. Pages under docs/internal are for whoever administers weave itself and"
	echo "are left alone."
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	esac
done

cd "$MISE_CONFIG_ROOT"

pages=()
while IFS= read -r page; do
	pages+=("$page")
done < <(find README.md docs -name '*.md' -not -path 'docs/internal/*' | sort)

found=0
for page in "${pages[@]}"; do
	if grep -niwH mise "$page"; then
		found=1
	fi
done

if ((found)); then
	echo "the pages above name mise; say what weave itself does, or move the page under docs/internal" >&2
	exit 1
fi

echo "docs clean"
