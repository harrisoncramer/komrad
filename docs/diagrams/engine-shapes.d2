...@_theme

direction: down

local: On your laptop {
  class: group

  panel: Panel {class: leaf}
  serve: Server {class: leaf}
  agents: Agents {class: leaf}
  postgres: Postgres {class: store}

  panel -> serve
  serve -> agents
  serve -> postgres
}

remote: Remote engine {
  class: group

  panel: Panel {class: leaf}
  serve: Server {class: leaf}
  agents: Agents {class: leaf}
  postgres: Postgres {class: store}

  panel -> serve: HTTPS
  serve -> agents
  serve -> postgres
}
