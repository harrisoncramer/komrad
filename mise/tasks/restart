#!/usr/bin/env bash
#MISE description="Rebuild, then kill and restart everything: the server, the panel, and every agent."
set -euo pipefail
cd "$MISE_CONFIG_ROOT"

weave="$MISE_CONFIG_ROOT/bin/weave"

socket="${WEAVE_TMUX_SOCKET:-weave}"
addr="${WEAVE_ADDR:-127.0.0.1:8787}"

go build -o "$weave" .

agents="$( (tmux -L "$socket" list-panes -a -F x 2>/dev/null || true) | wc -l | tr -d ' ')"

tmux -L "$socket" kill-server 2>/dev/null || true

if ! "$weave" stop; then
	pkill -f "weave serve --addr $addr" 2>/dev/null || true
fi

if ! "$weave" start; then
	echo "warning: the server did not come up, so open the panel to see why" >&2
	echo "killed $agents panes; the server is not running, so nothing was resumed"
	exit 1
fi

if ! "$weave" open --detach; then
	echo "warning: the panel session did not come up, so nothing was resumed" >&2
	exit 1
fi

resumed=0
cursor=""
while :; do
	request=(rpc list-agents --pagination.limit 500 --compact)
	if [ -n "$cursor" ]; then
		request+=(--pagination.cursor "$cursor")
	fi

	page="$("$weave" "${request[@]}")"

	while read -r id; do
		[ -n "$id" ] || continue
		if "$weave" rpc resume-agent --id "$id" --compact >/dev/null; then
			resumed=$((resumed + 1))
		else
			echo "warning: $id did not come back; the log says why" >&2
		fi
	done < <(jq -r '.agents // [] | .[].id' <<<"$page")

	cursor="$(jq -r '.nextPageToken // empty' <<<"$page")"
	[ -n "$cursor" ] || break
done

noun=agents
if [ "$resumed" -eq 1 ]; then
	noun=agent
fi

echo "killed $agents panes, restarted the server, and resumed $resumed $noun; press prefix+g for the panel"
