#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
set -euo pipefail
#MISE description="Rerun every generator and fail if the checked-in output moved."

usage() {
	echo "Usage: mise run gen:check"
	echo
	echo "Reruns the sqlc, buf, and config generators, then fails if any of their"
	echo "committed output changed. Skips the comparison when those paths already"
	echo "differ from HEAD, since then a difference says nothing about whether the"
	echo "generators are in sync."
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	esac
done

cd "$MISE_CONFIG_ROOT"

GENERATED=(config.toml db/models proto/gen)

# Staged and untracked changes count, not just unstaged ones: `git diff` alone
# would call a staged difference clean and let real drift through on the way into
# a commit, which is exactly when this runs.
generated_changes() {
	git status --porcelain -- "${GENERATED[@]}"
}

if [ -n "$(generated_changes)" ]; then
	echo "warning: generated paths already differ from HEAD; skipping the drift check"
	echo "         (${GENERATED[*]})"
	exit 0
fi

mise run db:sqlc
mise run proto:generate
mise run gen:config

if [ -n "$(generated_changes)" ]; then
	echo "generated files are out of date; commit the regenerated output:" >&2
	generated_changes >&2
	exit 1
fi

echo "generated files up to date"
