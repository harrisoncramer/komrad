...@_theme

direction: down

panel: Panel {class: leaf}
idp: Identity provider {class: leaf}
operator: Operator {class: leaf}

host: Engine host {
  class: group
  caddy: Caddy {class: leaf}
  public: Public listener {class: leaf}
  ssm: SSM agent {class: leaf}
  loopback: Loopback listener {class: leaf}

  caddy -> public
  ssm -> loopback: shell {class: dashed}
}

grants: Grants {class: store}

panel -> idp: sign in
panel -> host.caddy: HTTPS
host.public -> grants
operator -> host.ssm
