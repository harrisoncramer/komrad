#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_build"
source "$MISE_CONFIG_ROOT/mise/tasks/_test_instance"
require_test_instance

: "${DB_PORT:=5460}"
export DB_PORT
export KOMRAD_DATABASE_URL="${KOMRAD_DATABASE_URL:-postgres://komrad:komrad@localhost:${DB_PORT}/komrad?sslmode=disable}"
export DATABASE_URL="$KOMRAD_DATABASE_URL"

adminURL() {
	echo "${DATABASE_URL%/*}/postgres?sslmode=disable"
}

shell_scripts() {
	local roots=(mise/tasks internal/scripts/builtin packer/scripts packer/files)

	for root in "${roots[@]}"; do
		if [ ! -d "$root" ]; then
			echo "shell_scripts: no directory at $root" >&2

			return 1
		fi
	done

	find "${roots[@]}" -type f -exec file {} + | grep -i 'shell script' | cut -d: -f1
}

# docs_install brings docs/node_modules in line with its lockfile, run from docs/.
docs_install() {
	if [ ! -f node_modules/.package-lock.json ] || [ package-lock.json -nt node_modules/.package-lock.json ]; then
		npm install
	fi
}

get_random_port() {
	local port
	local attempt

	for ((attempt = 0; attempt < 100; attempt++)); do
		port=$((32768 + RANDOM % (65535 - 32768 + 1)))
		if ! nc -z localhost "$port" 2>/dev/null; then
			echo "$port"

			return 0
		fi
	done

	echo "get_random_port: no free port after 100 attempts" >&2

	return 1
}

in_linked_worktree() {
	[ "$(git -C "$MISE_CONFIG_ROOT" rev-parse --git-dir)" != "$(git -C "$MISE_CONFIG_ROOT" rev-parse --git-common-dir)" ]
}

refuse_panel_database() {
	if [ "${MISE_ENV:-}" != test ] && [ "$DB_PORT" = 5460 ] && in_linked_worktree; then
		echo "$1: refusing to test against the panel's Postgres on 5460 from a worktree; run it as MISE_ENV=test mise run $1" >&2

		exit 1
	fi
}
