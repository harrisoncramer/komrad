#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
set -euo pipefail
#MISE description="Build the weave AMI with Packer."

usage() {
	echo "Usage: mise run packer:build [-- <packer args>]"
	echo
	echo "Builds the weave machine image in AWS and prints the resulting AMI id."
	echo "The image is tagged with the revision baked into it, and with WEAVE_VERSION when"
	echo "one is set. Neither says what the instance ends up running: the binary is replaced"
	echo "on the next deploy."
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	esac
done

cd "$MISE_CONFIG_ROOT"

REVISION="$(git rev-parse --short HEAD)"
VERSION="${WEAVE_VERSION:-v0.0.0-ami.$REVISION}"

go_build_binary linux arm64 "$VERSION" dist/weave-linux-arm64

cd packer

packer init .
packer build \
	-var "weave_revision=$REVISION" \
	-var "weave_version=$VERSION" \
	"$@" \
	.
