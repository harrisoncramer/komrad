#!/usr/bin/env bash
set -euo pipefail

# Refreshes the database and engine credentials.

source_file=/etc/weave/database-source.env
target=/etc/weave/database.env

if [ ! -f "$source_file" ]; then
	echo "$source_file is missing, so the database secret cannot be located" >&2
	exit 1
fi

# shellcheck source=/dev/null
. "$source_file"

: "${WEAVE_DATABASE_SECRET_ARN:?WEAVE_DATABASE_SECRET_ARN is not set}"
: "${WEAVE_DATABASE_HOST:?WEAVE_DATABASE_HOST is not set}"
: "${WEAVE_DATABASE_NAME:?WEAVE_DATABASE_NAME is not set}"

secret="$(aws secretsmanager get-secret-value \
	--secret-id "$WEAVE_DATABASE_SECRET_ARN" \
	--query SecretString \
	--output text)"

username="$(jq -re .username <<<"$secret")"

# AWS generates passwords containing characters that mean something inside a url, so the password
# is percent-encoded before being placed in one.
password="$(jq -rn --arg p "$(jq -re .password <<<"$secret")" '$p|@uri')"

owner="postgres://$username:$password@$WEAVE_DATABASE_HOST:5432/$WEAVE_DATABASE_NAME"
owner="$owner?sslmode=verify-full&sslrootcert=/etc/weave/rds-ca.pem"

engine="${WEAVE_ENGINE_NAME:-default}"
engine_password_file=/etc/weave/engine-password
if [ ! -s "$engine_password_file" ]; then
	install -m 0600 /dev/null "$engine_password_file"
	openssl rand -hex 24 >"$engine_password_file"
fi
engine_password="$(cat "$engine_password_file")"

# HOME is named because systemd sets none for a system service and weave looks for its config
# under one.
HOME="${HOME:-/root}" WEAVE_OWNER_DATABASE_URL="$owner" weave migrate
HOME="${HOME:-/root}" WEAVE_OWNER_DATABASE_URL="$owner" WEAVE_ENGINE_PASSWORD="$engine_password" \
	weave engine ensure "$engine" >/dev/null

url="postgres://weave_engine_$engine:$engine_password@$WEAVE_DATABASE_HOST:5432/$WEAVE_DATABASE_NAME"
url="$url?sslmode=verify-full&sslrootcert=/etc/weave/rds-ca.pem"

previous=""
if [ -f "$target" ]; then
	previous="$(cat "$target")"
fi

# The file is created empty and private first, so the url is never briefly readable by anyone
# else. The value is quoted because it contains an ampersand, which anything sourcing this file in
# a shell would otherwise read as a command separator.
install -m 0600 /dev/null "$target"
cat >"$target" <<ENV
WEAVE_DATABASE_URL='$url'
ENV

# try-restart rather than restart, since at boot weave is not up yet and must not be started early.
if [ -n "$previous" ] && [ "$previous" != "$(cat "$target")" ]; then
	systemctl try-restart weave.service
fi
