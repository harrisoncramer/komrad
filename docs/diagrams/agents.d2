...@_theme

direction: right

workflow: "Workflow: neovim" {
  class: group

  orchestrator: Orchestrator {class: leaf}

  fix-login: "Task: fix-login" {
    class: group
    grid-columns: 2
    horizontal-gap: 100
    writer: Writer {class: leaf}
    reviewer: Reviewer {class: leaf}
  }

  rfc-truncate: "Task: rfc-truncate" {
    class: group
    writer: Writer {class: leaf}
  }

  orchestrator -> fix-login {class: dashed}
  orchestrator -> rfc-truncate {class: dashed}
}
