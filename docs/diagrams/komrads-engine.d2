...@_theme

direction: down

laptop: Laptop {
  class: group
  panel: Panel {class: leaf}
  cli: AWS CLI {class: leaf}
}

idp: Identity provider {class: leaf}
actions: GitHub Actions {class: leaf}

aws: AWS {
  class: group

  ssm: Systems Manager {class: leaf}
  params: Parameter Store {class: store}
  secrets: Secrets Manager {class: store}

  control: Control plane {
    class: group

    tailscaled: Tailscale {class: leaf}
    caddy: Caddy {class: leaf}
    komrad: Komrad {class: leaf}
    forge: Forge proxy {class: leaf}

    tailscaled -> caddy: 443 only
    caddy -> komrad
  }

  engine: Engine {
    class: group
    serve: Server {class: leaf}
    agents: Agents {class: leaf}
    serve <- agents: MCP
  }

  rds: RDS Postgres {class: store}

  params -> control.tailscaled: node key
  control.komrad -> engine.serve
  control.forge <- engine.agents: git
  control.forge <- engine.serve: pull requests
  control.forge -> secrets: GitHub logins
  engine.serve -> rds
  engine.serve -> secrets: engine login
  control -> rds: migrations
  ssm -> control: shells and deploys
  ssm -> engine: shells and deploys
}

github: GitHub {class: leaf}

laptop.panel -> idp: sign in
laptop.panel -> aws.control.tailscaled: tailnet
laptop.cli -> aws.ssm
actions -> aws.ssm
aws.control.forge -> github: GitHub login
