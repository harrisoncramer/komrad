...@_theme

direction: down

secrets: Secrets Manager {class: store}

host: Engine host {
  class: group

  git: git {class: leaf}
  serve: Server {class: leaf}
  helper: Credential helper {class: leaf}
  key: App key {class: store}
  token: GitLab token {class: store}

  git -> helper: asks for token
  helper -> key: GitHub
  helper -> token: GitLab
  serve -> token: rotates daily
}

github: GitHub {class: leaf}
gitlab: GitLab {class: leaf}

secrets -> host.key: copied at boot
host.git -> github: push
host.git -> gitlab: push
