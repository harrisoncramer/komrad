#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
source "$MISE_CONFIG_ROOT/mise/tasks/remote/_remote_utils"
set -euo pipefail
#MISE description="Open a shell on the remote engine, or run one command there."

usage() {
	echo "Usage: mise run remote:connect [-- command...]"
	echo
	echo "Opens a shell on the engine as the komrade account over ssh. With a command after --"
	echo "it runs that instead and returns, which is what a script wants."
	echo
	echo "The address comes from Terraform, the key from KOMRADE_ENGINE_KEY, and the connection"
	echo "is shared, so a second call costs a fraction of the first."
	echo
	echo "  mise run remote:connect"
	echo "  mise run remote:connect -- systemctl status komrade"
	echo "  mise run remote:connect -- tmux -L komrade list-sessions"
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	esac
done

cd "$MISE_CONFIG_ROOT"

require_aws_profile

HOST="${KOMRADE_ENGINE_HOST:-}"

if [ -z "$HOST" ]; then
	HOST="$(terraform_output instance_public_ip)"
fi

if [ -z "$HOST" ]; then
	echo "could not read the engine's address from Terraform." >&2
	echo >&2
	echo "Run 'mise run terraform:apply' to build one, or set KOMRADE_ENGINE_HOST." >&2
	exit 1
fi

KEY="${KOMRADE_ENGINE_KEY:-$HOME/.ssh/komrade_engine}"

if [ ! -f "$KEY" ]; then
	echo "no key at $KEY, so the engine will refuse the connection." >&2
	echo >&2
	echo "That key is the one whose public half Terraform put in the instance's authorized_keys," >&2
	echo "as ssh_public_key in terraform.tfvars. Set KOMRADE_ENGINE_KEY if yours lives elsewhere." >&2
	exit 1
fi

USER_NAME="${KOMRADE_ENGINE_USER:-komrade}"

# The address outlives the instance, so a rebuild answers on it with a new host key. The known
# hosts are kept in a file of this engine's own, which is what makes dropping the old key safe.
KNOWN_HOSTS="${KOMRADE_ENGINE_KNOWN_HOSTS:-$HOME/.ssh/known_hosts_komrade_engine}"
touch "$KNOWN_HOSTS"
chmod 600 "$KNOWN_HOSTS"

RECORDED="$(ssh-keygen -F "$HOST" -f "$KNOWN_HOSTS" 2>/dev/null | grep -c . || true)"
LIVE="$(ssh-keyscan -T 5 -t ed25519 "$HOST" 2>/dev/null | grep -v "^#" | head -1)"

if [ "$RECORDED" != "0" ] && [ -n "$LIVE" ] && ! grep -qxF "$LIVE" "$KNOWN_HOSTS"; then
	echo "the engine at $HOST answers with a new host key, which is what a rebuilt instance does." >&2
	echo "dropping the old one from $KNOWN_HOSTS and going on." >&2
	ssh-keygen -R "$HOST" -f "$KNOWN_HOSTS" >/dev/null 2>&1 || true
fi

# The same control path the panel's own transport uses, so a shell opened here and a stage pane
# attaching share one connection rather than building two.
SSH_ARGS=(
	-o ControlMaster=auto
	-o ControlPersist=10m
	-o "ControlPath=/tmp/cm-komrade-%r@%h:%p"
	-o StrictHostKeyChecking=accept-new
	-o "UserKnownHostsFile=$KNOWN_HOSTS"
	-o ConnectTimeout=10
	-i "$KEY"
)

if [ "$#" -gt 0 ]; then
	exec ssh "${SSH_ARGS[@]}" "${USER_NAME}@${HOST}" "$@"
fi

exec ssh -t "${SSH_ARGS[@]}" "${USER_NAME}@${HOST}"
