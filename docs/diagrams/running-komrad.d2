...@_theme

direction: down

laptop: Laptop {
  class: group
  panel: Panel {class: leaf}
}

idp: Identity provider {class: leaf}

control: Control plane {
  class: group

  proxy: HTTPS proxy {class: leaf}
  serve: Server {class: leaf}

  proxy -> serve: loopback
}

postgres: Postgres {class: store}
forge: Forge {class: leaf}

devbox: Dev box {
  class: group

  agents: Agents {class: leaf}
  runner: Runner {class: leaf}
  home: Home {class: store}

  runner <-> agents: MCP and git
  agents -> home
}

worker: Worker {
  class: group

  agents: Agents {class: leaf}
  runner: Runner {class: leaf}
  volume: Worktree {class: store}

  runner <-> agents: MCP and git
  agents -> volume
}

laptop.panel -> idp: sign in
laptop.panel -> control.proxy: HTTPS
control.serve -> postgres
control.serve -> forge: real credential
control.serve <-> devbox.runner: stream
control.serve <-> worker.runner: stream
