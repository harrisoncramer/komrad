...@_theme

direction: down

change: One transaction {
  style.font-size: 18
  grid-columns: 2
  change: The change {
    class: box
    note: "checks on #412 → failing" {class: note}
  }
  event: The event {
    class: box
    note: "\"pull request #412 changed\"" {class: note}
  }
}

handle: One transaction {
  style.font-size: 18
  grid-columns: 3
  grid-gap: 60
  find: Handler {
    class: box
    note: "Finds the writers\non the branch" {class: note}
  }
  write: Mail {
    class: box
    note: "Writes or rewrites\neach one's mail" {class: note}
  }
  done: Done {
    class: box
    note: "Marks the event done" {class: note}
  }
  find -> write -> done
}

delivered: Delivered {
  class: box
  note: "The same way as\nany other mail" {class: note}
}

change -> handle: a moment later
handle -> delivered
