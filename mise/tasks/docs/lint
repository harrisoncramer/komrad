#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
set -euo pipefail
#MISE description="Lint the docs site with ESLint."

usage() {
	echo "Usage: mise run docs:lint [--fix]"
	echo
	echo "Runs ESLint over docs/ with the strict type-checked typescript-eslint rules,"
	echo "the Astro and accessibility rules, and the React hooks rules. Pass --fix to"
	echo "apply the fixes ESLint can make on its own. It generates Astro's types first,"
	echo "since the type-aware rules cannot resolve astro:content or import.meta.env"
	echo "without them."
}

FIX=()
for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	--fix)
		FIX=(--fix)
		;;
	esac
done

cd "$MISE_CONFIG_ROOT/docs"

docs_install

npx astro sync >/dev/null
npx eslint --max-warnings 0 "${FIX[@]}" .
