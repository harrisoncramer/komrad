...@_theme

direction: right

workflow: "Workflow: neovim" {
  style.font-size: 18

  orchestrator: Orchestrator {
    class: box
    note: "Coordinates the\nworkflow's tasks" {class: note}
  }

  fix-login: "Task: fix-login" {
    style.font-size: 16
    grid-columns: 2
    grid-gap: 40
    writer: Writer {
      class: box
      note: "Does the work,\nowns the checkout" {class: note}
    }
    reviewer: Reviewer {
      class: box
      note: "Reads the\nwriter's change" {class: note}
    }
  }

  rfc-truncate: "Task: rfc-truncate" {
    style.font-size: 16
    writer: Writer
  }

  orchestrator -> fix-login {style.stroke-dash: 3}
  orchestrator -> rfc-truncate {style.stroke-dash: 3}
}
