...@_theme

grid-columns: 3
grid-gap: 100

panel: Panel {
  class: group
  grid-rows: 3
  grid-columns: 2
  grid-gap: 30
  blank1: {class: blank}
  cmd: Cmd {class: leaf}
  view: View {class: leaf}
  blank2: {class: blank}
  model: Model {class: leaf}
  update: Update {class: leaf}
}

serve: Server {
  class: group
  grid-rows: 4
  grid-columns: 2
  grid-gap: 30
  handler: API handler {class: leaf}
  service: Business logic {class: leaf}
  loops: Sync loops {class: leaf}
  store: Store {class: leaf}
  render: Reconciler {class: leaf}
  blank1: {class: blank}
  pending: Changed IDs {class: leaf}
  listener: Listener {class: leaf}
}

postgres: Postgres {
  class: group
  grid-rows: 4
  grid-columns: 1
  grid-gap: 30
  blank1: {class: blank}
  tables: Rows {class: store}
  blank2: {class: blank}
  trigger: Trigger {class: leaf}
}

panel.view -> panel.update: key press
panel.update -> panel.cmd
panel.update -> panel.model
panel.model -> panel.view

panel.cmd -> serve.handler: Connect RPC
serve.handler -> serve.service -> serve.store
serve.loops -> serve.store
serve.store -> postgres.tables: commit
postgres.tables -> postgres.trigger
postgres.trigger -> serve.listener: "table, key"
serve.listener -> serve.pending -> serve.render
serve.render -> panel.update: Watch stream
