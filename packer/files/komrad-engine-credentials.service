[Unit]
Description=Fetch the engine's database login and forge proxy credential
Before=komrad.service
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/komrad/engine.env

[Service]
Type=oneshot
TimeoutStartSec=25min
ExecStart=/usr/local/sbin/komrad-engine-credentials

[Install]
WantedBy=multi-user.target
