---
import Heading from "./Heading.astro";
import Required from "./Required.astro";
import { anchor, prose } from "../../reference";
import type { Field, Message, Oneof } from "../../reference/types";

type Props = {
  name: string;
  message: Message;
};

type Row = { field: Field; member: boolean } | { oneof: Oneof };

const { name, message } = Astro.props;
const id = anchor(name);
const tone = (type: string) => (/int|fixed|float|double/.test(type) ? "number" : type);
const rules = (field: Field) => field.rules.filter((rule) => rule !== "required");

const rows: Row[] = [];
const drawn = new Set<string>();
for (const field of message.fields) {
  if (!field.oneof) {
    rows.push({ field, member: false });
    continue;
  }
  if (drawn.has(field.oneof)) continue;
  drawn.add(field.oneof);

  const oneof = message.oneofs.find((candidate) => candidate.name === field.oneof);
  if (!oneof) throw new Error(`api.json has no oneof ${field.oneof} on ${name}`);
  rows.push({ oneof });
  for (const member of message.fields.filter((candidate) => candidate.oneof === field.oneof)) {
    rows.push({ field: member, member: true });
  }
}
---

<section class="type">
  <Heading id={id} level={3}>
    {message.name}
  </Heading>
  {message.description && <div class="type-description" set:html={prose(message.description)} />}
  {message.fields.length === 0 ? (
    <p class="empty">No fields.</p>
  ) : (
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Field</th>
            <th>Type</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) =>
            "oneof" in row ? (
              <tr id={`${id}-${row.oneof.name}`} class="oneof">
                <td>
                  <a class="row-anchor oneof-name" href={`#${id}-${row.oneof.name}`}>
                    {row.oneof.name}
                  </a>
                </td>
                <td class="type-cell" data-sep=":">
                  one of
                  {row.oneof.required && <Required />}
                </td>
                <td>{row.oneof.description && <Fragment set:html={prose(row.oneof.description)} />}</td>
              </tr>
            ) : (
              <tr id={`${id}-${row.field.name}`} class={row.member ? "oneof-member" : undefined}>
                <td>
                  <a class="row-anchor" href={`#${id}-${row.field.name}`}>
                    <code>{row.field.name}</code>
                  </a>
                </td>
                <td class="type-cell" data-sep=":">
                  {row.field.map && "map of "}
                  {row.field.repeated && !row.field.map && "list of "}
                  {row.field.ref ? (
                    <a href={`#${anchor(row.field.ref)}`}>{row.field.type}</a>
                  ) : (
                    <span class="type-name" data-tone={tone(row.field.type)}>
                      {row.field.type}
                    </span>
                  )}
                  {row.field.rules.includes("required") && <Required />}
                </td>
                <td>
                  {row.field.description && <Fragment set:html={prose(row.field.description)} />}
                  {rules(row.field).length > 0 && <p class="rules">{rules(row.field).join(", ")}</p>}
                </td>
              </tr>
            ),
          )}
        </tbody>
      </table>
    </div>
  )}
</section>
