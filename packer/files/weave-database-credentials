#!/usr/bin/env bash
set -euo pipefail

# Explainer: this fetches weave's database password and writes the url the service reads.
#
# Nobody types a connection string for this host and none is baked into the image. AWS owns the
# password for the database, Terraform tells this machine only which secret holds it, and the
# instance reads that secret as itself using the role attached to it, so no access key exists
# anywhere on the host.
#
# It also creates the least-privilege login the MCP query tools connect as, because this is the
# only moment anything on the host holds the credential that can grant it, and weave refuses to
# start without it.
#
# It runs at boot and again on a timer, since AWS rotates that password on a schedule of its own
# and a host that read it once would lose its database partway through a working day.

source_file=/etc/weave/database-source.env
target=/etc/weave/database.env

if [ ! -f "$source_file" ]; then
	echo "$source_file is missing, so the database secret cannot be located" >&2
	exit 1
fi

# shellcheck source=/dev/null
. "$source_file"

: "${WEAVE_DATABASE_SECRET_ARN:?WEAVE_DATABASE_SECRET_ARN is not set}"
: "${WEAVE_DATABASE_HOST:?WEAVE_DATABASE_HOST is not set}"
: "${WEAVE_DATABASE_NAME:?WEAVE_DATABASE_NAME is not set}"

secret="$(aws secretsmanager get-secret-value \
	--secret-id "$WEAVE_DATABASE_SECRET_ARN" \
	--query SecretString \
	--output text)"

username="$(jq -re .username <<<"$secret")"

# AWS generates passwords containing characters that mean something inside a url, so the password
# is percent-encoded before being placed in one.
password="$(jq -rn --arg p "$(jq -re .password <<<"$secret")" '$p|@uri')"

url="postgres://$username:$password@$WEAVE_DATABASE_HOST:5432/$WEAVE_DATABASE_NAME"
url="$url?sslmode=verify-full&sslrootcert=/etc/weave/rds-ca.pem"

previous=""
if [ -f "$target" ]; then
	previous="$(cat "$target")"
fi

# The file is created empty and private first, so the url is never briefly readable by anyone
# else. The value is quoted because it contains an ampersand, which anything sourcing this file in
# a shell would otherwise read as a command separator.
install -m 0600 /dev/null "$target"
cat >"$target" <<ENV
WEAVE_DATABASE_URL='$url'
ENV

# The restart comes first, so that a failure in the role work below cannot leave a rotated
# password in the file with a running weave still using the old one. try-restart rather than
# restart, since at boot weave is not up yet and must not be started early.
if [ -n "$previous" ] && [ "$previous" != "$(cat "$target")" ]; then
	systemctl try-restart weave.service
fi

# The read-only login is created from the writable url, and creating it again is harmless, so it
# is done on every pass rather than tracked. HOME is named because systemd sets none for a system
# service and weave looks for its config under one.
HOME="${HOME:-/root}" WEAVE_DATABASE_URL="$url" weave readonly-role
