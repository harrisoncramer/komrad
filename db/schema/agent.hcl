schema "public" {
}

# pg_trgm backs the transcript search: it indexes every three-character run of
# the text, which is what makes a search match on any substring rather than on
# whole words only. The extension is not declared here because this Atlas edition
# does not manage extensions; it is created by the first migration, which the
# diff replays into its dev database before reaching the index that needs it.

# A workflow's default configuration, used only as the blueprint prefilled into
# the new-agent form. Agents copy it into their own config; they never
# reference it at rest.
table "workflow_configs" {
  schema  = schema.public
  comment = "Default config (harness, cwd, flags) seeded into new agents of a workflow."
  column "id" {
    null    = false
    type    = uuid
    default = sql("uuidv7()")
  }
  # Which agent CLI this workflow's agents run, empty when the workflow takes
  # whatever the user configured as their default. It sits here rather than on the
  # workflow because it is one of the defaults an agent inherits at launch.
  column "harness" {
    null    = false
    type    = text
    default = ""
  }
  column "cwd" {
    null    = false
    type    = text
    default = ""
  }
  column "flags" {
    null    = false
    type    = text
    default = ""
  }
  column "created_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  column "updated_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  primary_key {
    columns = [column.id]
  }
}

# What runs around a workflow's agents' lives, and the worktree a workflow's setup and
# cleanup actions can point at instead of a hand-written script. Kept apart from
# workflow_configs because that table is what a launch seeds into the agent's own row and
# never looks at again, where this is looked up fresh every time a setup or cleanup action
# fires, the same way workflows.context is.
table "workflow_action_configs" {
  schema  = schema.public
  comment = "The setup/cleanup actions a workflow's agents run around their lives, and the worktree config those actions can point at instead."
  column "id" {
    null    = false
    type    = uuid
    default = sql("uuidv7()")
  }
  # The action run before an agent in this workflow starts, blank for none. It blocks and a
  # failure abandons the launch, so this is where a workflow puts the work an agent cannot run
  # without, like provisioning a worktree to sit in. It holds a name rather than an id because
  # an action is a file in a directory and has no row to reference.
  #
  # One action rather than a list of them, because an action is a script and a script already
  # sequences its own steps. A workflow wanting three things done in order writes them in one
  # file, where it also gets the error handling a list could not express.
  column "setup_action" {
    null    = false
    type    = text
    default = ""
  }
  # The action run once an agent in this workflow is deleted, blank for none. It undoes what
  # setup built. Nothing waits on it and nothing is downstream of a failure, so unlike setup
  # it does not block.
  column "cleanup_action" {
    null    = false
    type    = text
    default = ""
  }
  # Whether this workflow generates a git worktree for each of its agents instead of running
  # a hand-written setup and cleanup action. When true, setup_action and cleanup_action name
  # the built-in scripts weave points them at rather than anything hand-written, and the
  # fields below are what those scripts read.
  column "worktree_enabled" {
    null    = false
    type    = boolean
    default = false
  }
  # The branch a new worktree is built from, empty for the repo's default branch. Kept
  # whatever worktree_enabled is set to, so turning it off and back on hands back what was
  # here before rather than starting over blank.
  column "worktree_base_branch" {
    null    = false
    type    = text
    default = ""
  }
  # Files copied fresh into every new worktree, relative to the workflow's cwd. Kept
  # whatever worktree_enabled is set to, for the same reason the base branch is.
  column "worktree_copy_paths" {
    null    = false
    type    = sql("text[]")
    default = sql("'{}'")
  }
  # Directories symlinked back to the workflow's cwd instead of duplicated into every
  # worktree. Kept whatever worktree_enabled is set to, for the same reason the base branch is.
  column "worktree_symlink_paths" {
    null    = false
    type    = sql("text[]")
    default = sql("'{}'")
  }
  column "created_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  column "updated_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  primary_key {
    columns = [column.id]
  }
}

table "workflows" {
  schema  = schema.public
  comment = "A named bucket of related agents. Pure organization; runs nothing."
  # uuidv7, generated by the database, same scheme as agents.id. Everything
  # keys on this id; the name is a mutable display label.
  column "id" {
    null    = false
    type    = uuid
    default = sql("uuidv7()")
  }
  column "name" {
    null = false
    type = text
  }
  # Free-text durable state for the workflow, edited by the user. Holds shared
  # context that agents in the workflow can read; empty until filled in.
  column "context" {
    null    = false
    type    = text
    default = ""
  }
  # The workflow's default config. References workflow_configs.id.
  column "workflow_config_id" {
    null = false
    type = uuid
  }
  # The actions run around this workflow's agents' lives, and the worktree config they can
  # point at instead of a hand-written script. References workflow_action_configs.id.
  column "action_config_id" {
    null = false
    type = uuid
  }
  # When the workflow was archived, null while it is live. An archived workflow is
  # hidden from the panel but kept, with the agents inside it archived alongside it.
  column "archived_at" {
    null = true
    type = timestamptz
  }
  column "created_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  column "updated_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  primary_key {
    columns = [column.id]
  }
  # A workflow always owns exactly one config, so the reference is never null and
  # the config is never removed out from under it.
  foreign_key "workflows_workflow_config_id_fkey" {
    columns     = [column.workflow_config_id]
    ref_columns = [table.workflow_configs.column.id]
    on_delete   = RESTRICT
    on_update   = NO_ACTION
  }
  # A workflow always owns exactly one action config, for the same reason it always owns
  # exactly one workflow_configs row.
  foreign_key "workflows_action_config_id_fkey" {
    columns     = [column.action_config_id]
    ref_columns = [table.workflow_action_configs.column.id]
    on_delete   = RESTRICT
    on_update   = NO_ACTION
  }
  index "workflows_workflow_config_id" {
    columns = [column.workflow_config_id]
  }
  index "workflows_action_config_id" {
    columns = [column.action_config_id]
  }
}

table "agent_transcripts" {
  schema  = schema.public
  comment = "Flattened transcript for an agent, synced from Claude's on-disk JSONL and indexed for search. Strict 1:1 with an agent."
  # Equals agents.id, so this is the one id the caller supplies rather than the
  # database: the agent owns exactly one transcript, and reusing its id makes
  # the 1:1 link implicit and keyless.
  column "agent_id" {
    null = false
    type = uuid
  }
  # The user and assistant turns flattened to plain text, the corpus search runs
  # over. Tool calls, tool results, and thinking are dropped so the index stays
  # lean and matches read as conversation.
  column "content" {
    null    = false
    type    = text
    default = ""
  }
  # How many bytes of the source JSONL have been folded into content already.
  # The syncer seeks here and reads only the appended tail, so a large transcript
  # is not re-parsed every pass. The JSONL is append-only, so the offset only
  # grows unless the file is rewritten, which the syncer detects and reindexes.
  column "synced_offset" {
    null    = false
    type    = bigint
    default = 0
  }
  column "synced_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  primary_key {
    columns = [column.agent_id]
  }
  foreign_key "agent_transcripts_agent_id_fkey" {
    columns     = [column.agent_id]
    ref_columns = [table.agents.column.id]
    on_delete   = CASCADE
    on_update   = NO_ACTION
  }
}

# One turn of a transcript, the unit search matches and ranks. A whole
# conversation is too coarse to score: a long one covering many subjects is a
# mediocre match for all of them, and it can only ever yield a single snippet.
# Per-turn rows score as coherent units, let one conversation return several
# hits, and turn a sync into an append of small rows rather than a rewrite of a
# large one.
table "agent_transcript_chunks" {
  schema  = schema.public
  comment = "One turn of an agent's transcript, word-indexed for search."
  column "agent_id" {
    null = false
    type = uuid
  }
  # Position of the turn within the transcript, counting from zero. Assigned by
  # the syncer as it appends, so it orders turns the way the conversation ran.
  column "seq" {
    null = false
    type = int
  }
  # Who spoke, user or assistant, carried so a hit can say which side said it.
  column "role" {
    null = false
    type = text
  }
  # The turn's text, the same prose that sits inside agent_transcripts.content.
  column "content" {
    null = false
    type = text
  }
  # Byte offset where this turn begins inside agent_transcripts.content. The
  # panel loads the full transcript to preview a hit and needs the line to centre
  # on. Locating the turn by searching for its text would fail whenever a match
  # is stemmed rather than literal, so the offset is recorded at write time
  # instead, when it is known exactly.
  column "content_offset" {
    null = false
    type = bigint
  }
  # The turn reduced to stemmed lexemes with their positions, which is what the
  # GIN index below covers and what a tsquery is matched against. Generated by
  # the database so it cannot drift from content. to_tsvector is only immutable
  # when the configuration is named outright, which is why 'english' is spelled
  # here rather than left to default_text_search_config.
  column "tsv" {
    null = false
    type = sql("tsvector")
    as {
      expr = "to_tsvector('english', content)"
      type = STORED
    }
  }
  primary_key {
    columns = [column.agent_id, column.seq]
  }
  foreign_key "agent_transcript_chunks_agent_id_fkey" {
    columns     = [column.agent_id]
    ref_columns = [table.agents.column.id]
    on_delete   = CASCADE
    on_update   = NO_ACTION
  }
  # The search index. Inverted, so a lexeme maps to the turns holding it in
  # one probe rather than a scan of the corpus.
  index "agent_transcript_chunks_tsv" {
    type    = GIN
    columns = [column.tsv]
  }
  # Lexemes are whole words, so a query typed halfway matches nothing until the
  # word is finished. Trigrams cover that gap: they index every three-character
  # run, which is what lets a partial word still find the turns containing it
  # while someone is still typing.
  index "agent_transcript_chunks_content_trgm" {
    type = GIN
    on {
      column = column.content
      ops    = gin_trgm_ops
    }
  }
}

# Facts an agent records about its own work as it goes, so the panel can show
# what an issue or pull request a conversation was about without reading the
# transcript back. The agent writes these itself, and nothing else does.
#
# A row per key rather than one document per agent, because an agent recording a
# second fact would otherwise have to rewrite the whole thing and could drop
# whatever it had not read first. The pair below is the identity, so a repeated
# write of the same fact updates in place instead of accumulating.
table "agent_metadata" {
  schema  = schema.public
  comment = "Key/value facts an agent recorded about its own work."
  column "agent_id" {
    null = false
    type = uuid
  }
  # The agent's own choice of name for the fact, constrained to a slug by the
  # proto so a key reads the same however many agents wrote it and the panel can
  # align a column of them.
  column "key" {
    null = false
    type = text
  }
  column "value" {
    null = false
    type = text
  }
  column "created_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  column "updated_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  primary_key {
    columns = [column.agent_id, column.key]
  }
  foreign_key "agent_metadata_agent_id_fkey" {
    columns     = [column.agent_id]
    ref_columns = [table.agents.column.id]
    on_delete   = CASCADE
    on_update   = NO_ACTION
  }
}

table "agents" {
  schema  = schema.public
  comment = "One background Claude agent, everything needed to restore it."
  # uuidv7, time-ordered so it sorts chronologically, which is what the keyset page
  # reads as newest-first. The service mints it before the insert, since the tmux
  # pane the agent runs in is stamped with it and has to be stamped before the row
  # exists. The default covers a writer that brings none, and generates the same
  # version so both sort together.
  column "id" {
    null    = false
    type    = uuid
    default = sql("uuidv7()")
  }
  column "name" {
    null = false
    type = text
  }
  # Where the agent runs and the flags it was launched with. A restore reads both
  # back to bring the agent up the same way, so they are the agent's own columns
  # rather than a row it points at.
  column "cwd" {
    null    = false
    type    = text
    default = ""
  }
  column "flags" {
    null    = false
    type    = text
    default = ""
  }
  column "setup_action" {
    null = true
    type = text
  }
  column "cleanup_action" {
    null = true
    type = text
  }
  column "prompt" {
    null    = false
    type    = text
    default = ""
  }
  column "pane_id" {
    null    = false
    type    = text
    default = ""
  }
  # What the agent is doing, one of thinking, waiting, or idle, written only by the
  # reconciler off the agent's live pane. A fresh row starts idle because nothing has
  # been observed working yet, which is the same thing a finished agent shows.
  column "state" {
    null    = false
    type    = text
    default = "idle"
  }
  # When the agent entered the state it holds. Only a write that changes state
  # moves it, since the reconciler writes the state it observed every pass and a
  # stamp that moved with every write would say when the agent was last looked at.
  # It is how long an agent has been blocked or working, which is what a listing
  # orders by to put the ones wanting attention first.
  column "state_changed_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  # Which agent CLI this agent runs, which decides how it is launched, how its
  # state is read off its pane, and where its conversation log is found. Never
  # empty: an agent whose harness nothing implements cannot be relaunched or
  # observed, so the id is checked and refused at create rather than here.
  column "harness" {
    null    = false
    type    = text
    default = "claude"
  }
  # The conversation this agent holds, minted by the panel at launch and handed to
  # the harness, which reopens it when a dormant agent is restored.
  column "session_id" {
    null    = false
    type    = text
    default = ""
  }
  # The workflow this agent belongs to, and every agent has one. A workflow is
  # where the directory, flags, and shared context an agent starts from live, so an
  # agent outside one would have no defaults to inherit and nowhere to be listed.
  # References workflows.id.
  column "workflow_id" {
    null = false
    type = uuid
  }
  # The schedule that launched this agent, or null for one a person started.
  column "schedule_id" {
    null = true
    type = uuid
  }
  # A caller-supplied key that makes a create idempotent. A retried launch, from
  # a background job or a tool call, passes the same key and gets the agent that
  # already exists rather than a second Claude process on the same prompt. Null
  # for a create that makes no such claim, which is every create from the panel.
  column "idempotency_key" {
    null = true
    type = text
  }
  # The agent that called create_agent to launch this one, null for one a person started
  # from the panel. Set null rather than cascaded on delete: losing a parent must not take
  # the work its children did with it.
  column "spawned_by_agent_id" {
    null = true
    type = uuid
  }
  # When the row was archived, null while it is live.
  column "archived_at" {
    null = true
    type = timestamptz
  }
  # Hidden keeps an agent out of the panel's list while leaving it running. It is
  # not a second archive: the agent is live, still reconciled, and still
  # counted, it just does not take a row until the panel is asked to show the
  # hidden ones.
  column "is_hidden" {
    null    = false
    type    = boolean
    default = false
  }
  # When weave last typed at this agent to tell it about waiting mail, null for one it has
  # never nudged. Compared against state_changed_at, so an agent is nudged once per stretch
  # of sitting idle rather than every time the delivery job comes round.
  column "nudged_at" {
    null = true
    type = timestamptz
  }
  # The branch checked out at cwd, null when cwd is not a git worktree or has not been
  # looked at yet. Written only by a slow periodic pass, never by the reconciler, since
  # reading it is a shell-out rather than a tmux capture.
  column "branch" {
    null = true
    type = text
  }
  # The tag the user put on this agent, null when it carries none. It holds the
  # glyph itself, since which glyphs exist is their config and the glyph is the
  # whole meaning. Only the person writes it, never the reconciler, since what an
  # agent is doing is already in state.
  column "tag" {
    null = true
    type = text
  }
  column "created_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  column "updated_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  primary_key {
    columns = [column.id]
  }
  foreign_key "agents_workflow_id_fkey" {
    columns     = [column.workflow_id]
    ref_columns = [table.workflows.column.id]
    on_delete   = RESTRICT
    on_update   = NO_ACTION
  }
  foreign_key "agents_schedule_id_fkey" {
    columns     = [column.schedule_id]
    ref_columns = [table.schedules.column.id]
    on_delete   = RESTRICT
    on_update   = NO_ACTION
  }
  foreign_key "agents_spawned_by_agent_id_fkey" {
    columns     = [column.spawned_by_agent_id]
    ref_columns = [table.agents.column.id]
    on_delete   = SET_NULL
    on_update   = NO_ACTION
  }
  # Unique per workflow, among live records only. A name is a label the panel renders
  # rather than a key anything is looked up by, so two workflows may each hold an agent
  # called review without one of them having to be review-2. Archived rows are left out
  # of the predicate, since they keep their names and would otherwise block reuse.
  index "agents_name_active" {
    unique  = true
    columns = [column.workflow_id, column.name]
    where   = "archived_at IS NULL"
  }
  # Scoped listings filter by workflow, so index the foreign key.
  index "agents_workflow_id" {
    columns = [column.workflow_id]
  }
  # A schedule's detail view lists what it has launched, so index that key too.
  index "agents_schedule_id" {
    columns = [column.schedule_id]
  }
  # One agent per key, across live and archived rows alike. Unlike the name
  # index this is not scoped to live records: a retry must find the agent it
  # already created even if that agent has since been archived, or it would
  # spawn a duplicate. Partial on non-null so the ordinary create, which claims
  # no key, is unconstrained.
  index "agents_idempotency_key" {
    unique  = true
    columns = [column.idempotency_key]
    where   = "idempotency_key IS NOT NULL"
  }
}
