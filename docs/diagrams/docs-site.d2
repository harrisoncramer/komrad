...@_theme

direction: down

browser: Browser {class: leaf}
actions: GitHub Actions {class: leaf}

cloudflare: Cloudflare {
  class: group
  dns: DNS {class: leaf}
  redirects: Redirect rules {class: leaf}
}

aws: AWS {
  class: group
  cloudfront: CloudFront {class: leaf}
  function: Request function {class: leaf}
  bucket: Private bucket {class: store}

  cloudfront -> function
  cloudfront -> bucket
}

browser -> cloudflare.dns: komrad.dev
browser -> cloudflare.redirects: other domains
browser -> aws.cloudfront
actions -> aws.bucket: upload
actions -> aws.cloudfront: clear cache
