...@_theme

direction: down

laptop: Laptop {
  class: group
  panel: Panel {class: leaf}
}

idp: Identity provider {class: leaf}

control: Control plane {
  class: group

  proxy: HTTPS proxy {class: leaf}
  forge: Forge proxy {class: leaf}
}

engine: Engine {
  class: group

  serve: Server {class: leaf}
  agents: Agents {class: leaf}

  agents -> serve: MCP and git
}

postgres: Postgres {class: store}
github: Forge {class: leaf}

laptop.panel -> idp: sign in
laptop.panel -> control.proxy: HTTPS
control.proxy -> engine.serve
engine.serve -> postgres
control.forge <- engine.serve: git
control.forge -> github: real credential
