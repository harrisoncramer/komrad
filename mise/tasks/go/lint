#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
set -euo pipefail
#MISE description="Run the custom golangci-lint over every Go module."

usage() {
	echo "Usage: mise run go:lint [--fix]"
	echo
	echo "Runs the custom golangci-lint against every module using .golangci.yaml,"
	echo "building the custom binary first if it is missing. Pass --fix to apply"
	echo "autofixes; without it the run only reports, so the check task can call it"
	echo "without rewriting the tree it is checking."
}

FIX_ARGS=()
for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	--fix)
		FIX_ARGS+=(--fix)
		;;
	esac
done

cd "$MISE_CONFIG_ROOT"

MODULES=(. tools/weavelint tools/weavepkg)

CONFIG="$MISE_CONFIG_ROOT/.golangci.yaml"
BIN_PATH="$MISE_CONFIG_ROOT/local/custom-gcl"
SUM_PATH="$BIN_PATH.sum"

# weave's own rules are built into the binary from a path rather than pinned as a
# version, so a binary older than them lints with the rules as they used to be.
if [ ! -x "$BIN_PATH" ]; then
	echo "==> custom-gcl missing, building it"
	build_custom_gcl
elif [ ! -f "$SUM_PATH" ]; then
	echo "==> custom-gcl.sum missing, rebuilding custom-gcl"
	build_custom_gcl
elif [ "$(cat "$SUM_PATH")" != "$(custom_gcl_sum)" ]; then
	echo "==> rules changed since custom-gcl was built, rebuilding it"
	build_custom_gcl
fi

failed=()
for MODULE in "${MODULES[@]}"; do
	echo "==> linting $MODULE"
	if ! (
		cd "$MISE_CONFIG_ROOT/$MODULE" &&
			"$BIN_PATH" run ${FIX_ARGS[@]+"${FIX_ARGS[@]}"} --config "$CONFIG" --timeout 5m ./...
	); then
		failed+=("$MODULE")
	fi
done

echo "==> reading the user pages"
if ! lint_pages "$BIN_PATH"; then
	failed+=("pages")
fi

if ((${#failed[@]} > 0)); then
	echo "lint failed for: ${failed[*]}" >&2
	exit 1
fi

echo "lint clean"
