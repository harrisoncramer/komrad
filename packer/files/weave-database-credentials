#!/usr/bin/env bash
set -euo pipefail

# Explainer: this fetches the database password and writes the connection string weave reads.
#
# Nobody types a connection string for this host. Terraform creates the RDS instance and
# lets AWS own the password, so the only things Terraform can tell the machine are where
# the database is and which secret holds the password. This turns those into a URL.
#
# It runs before weave on every boot rather than baking anything into the image, so the
# image carries no credentials and a rotated password is picked up by a restart.

source_file=/etc/weave/database-source.env
target=/etc/weave/database.env

if [ ! -f "$source_file" ]; then
	echo "$source_file is missing, so the database cannot be located" >&2
	exit 1
fi

# shellcheck source=/dev/null
. "$source_file"

: "${WEAVE_DATABASE_SECRET_ID:?WEAVE_DATABASE_SECRET_ID is not set}"
: "${WEAVE_DATABASE_HOST:?WEAVE_DATABASE_HOST is not set}"
: "${WEAVE_DATABASE_NAME:?WEAVE_DATABASE_NAME is not set}"

# The instance reads the secret as itself, using the role attached to it, so no access key
# exists anywhere on the host.
secret="$(aws secretsmanager get-secret-value \
	--secret-id "$WEAVE_DATABASE_SECRET_ID" \
	--query SecretString \
	--output text)"

username="$(jq -re .username <<<"$secret")"
password="$(jq -re .password <<<"$secret")"

# AWS generates passwords containing characters that mean something inside a URL, so the
# password is percent-encoded before being placed in one.
encoded_password="$(jq -rn --arg p "$password" '$p|@uri')"

url="postgres://$username:$encoded_password@$WEAVE_DATABASE_HOST:5432/$WEAVE_DATABASE_NAME?sslmode=verify-full&sslrootcert=/etc/weave/rds-ca.pem"

# The file is created empty and private first, so the password is never briefly readable
# by anyone else. The value is quoted because the URL contains an ampersand, which would
# otherwise be read as a command separator by anything sourcing this file in a shell.
install -m 0600 /dev/null "$target"
cat >"$target" <<ENV
WEAVE_DATABASE_URL='$url'
ENV
