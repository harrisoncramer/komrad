#!/bin/sh
#KOMRAD description="Give back what a deleted task's komrad checkout claimed: its throwaway test instance. Does nothing in any other checkout."
#KOMRAD timeout="10m"
set -eu

if [ -z "${KOMRAD_WORKTREE_NAME:-}" ]; then
	exit 0
fi

tree="$KOMRAD_AGENT_CWD"

if [ ! -x "$tree/mise/tasks/_test_instance" ]; then
	exit 0
fi

name="${KOMRAD_WORKTREE_NAME:-}"

if [ "$(basename "$tree")" != "$name" ]; then
	echo "teardown: $tree is not named $name, so it is not this agent's to tear down" >&2
	exit 0
fi

"$tree/mise/tasks/_test_instance" down --root "$tree"
