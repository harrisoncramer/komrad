...@_theme

direction: down

panel: Panel {class: leaf}
actions: GitHub Actions {class: leaf}

aws: AWS {
  class: group

  ssm: Systems Manager {class: leaf}

  ec2: EC2 instance {
    class: group
    grid-columns: 2
    grid-gap: 40
    caddy: Caddy {class: leaf}
    serve: Server {class: leaf}
  }

  volume: Data volume {class: store}
  rds: RDS Postgres {class: store}

  ssm -> ec2
  ec2 -> rds
  ec2 -> volume
}

panel -> aws.ec2: HTTPS
actions -> aws.ssm
