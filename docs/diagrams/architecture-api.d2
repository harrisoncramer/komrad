...@_theme

direction: right

proto: Proto file {class: leaf}

generated: Generated code {
  class: group
  grid-columns: 1
  grid-gap: 30
  types: Types {class: leaf}
  routes: "Routes, client" {class: leaf}
  strict: Strict handler {class: leaf}
}

surfaces: Surfaces {
  class: group
  grid-columns: 1
  grid-gap: 30
  handlers: Server handlers {class: leaf}
  rpc: RPC commands {class: leaf}
  mcp: MCP tools {class: leaf}
  docs: Docs {class: leaf}
}

proto -> generated: "buf lint,\nbuf generate"
generated -> surfaces: "read at startup\nby internal/rpcapi"
