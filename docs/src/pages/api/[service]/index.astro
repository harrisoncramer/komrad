---
import DocPage from "../../../layouts/DocPage.astro";
import IndexList from "../../../components/reference/IndexList.astro";
import { api, prose } from "../../../reference";

export function getStaticPaths() {
  return api.services.map((service) => ({
    params: { service: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<DocPage title={service.title}>
  <div class="service-description" set:html={prose(service.description)} />
  <p><code>{service.name}</code></p>
  <IndexList
    rows
    items={service.methods.map((method) => ({
      href: `/api/${service.slug}/${method.slug}`,
      title: method.tool,
      summary: method.summary,
    }))}
  />
</DocPage>
