...@_theme

direction: right

proto: "<pkg>.proto\nwith surfaces"

generated: generated code {
  style.font-size: 18
  grid-columns: 1
  types: "types\nprotoc-gen-go"
  routes: "routes, client\nconnect-go"
  strict: "strict handler\nkomrad's plugin"
}

surfaces: {
  style.font-size: 18
  grid-columns: 1
  handlers: server handlers
  rpc: komrad rpc commands
  mcp: MCP tools
  docs
}

proto -> generated: "buf lint,\nbuf generate"
generated -> surfaces: "read at startup\nby internal/rpcapi"
