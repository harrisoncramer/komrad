---
import { Code } from "astro:components";

type Props = {
  tabs: { label: string; code: string; lang: "bash" | "json"; note?: string }[];
};

const { tabs } = Astro.props;
---

<call-tabs class="call-tabs">
  <div class="tab-list" role="tablist">
    {
      tabs.map((tab, index) => (
        <button type="button" role="tab" class="tab" aria-selected={index === 0 ? "true" : "false"} data-index={index}>
          {tab.label}
        </button>
      ))
    }
  </div>
  {
    tabs.map((tab, index) => (
      <div class="tab-panel" role="tabpanel" data-index={index} hidden={index !== 0}>
        <Code code={tab.code} lang={tab.lang} theme="tokyo-night" />
        {tab.note && <p class="tab-note">{tab.note}</p>}
      </div>
    ))
  }
</call-tabs>

<style>
  @reference "../../styles/global.css";

  .call-tabs {
    @apply block overflow-hidden rounded-lg border border-app-background-medium bg-app-background-medium-dark;
  }

  .tab-list {
    @apply flex gap-1 border-b border-app-background-medium px-2 pt-2;
  }

  .tab {
    @apply -mb-px rounded-t-md border border-transparent px-4 py-2 text-sm text-app-gray-light transition-colors;
    font-family: var(--font-sans);
  }

  .tab:hover {
    @apply text-app-white;
  }

  .tab[aria-selected="true"] {
    @apply border-app-background-medium bg-[#1a1b26] text-app-blue;
    border-bottom-color: #1a1b26;
  }

  .tab-panel :global(pre.astro-code) {
    @apply m-0 rounded-none border-0;
  }

  .tab-note {
    @apply border-t border-app-background-medium px-4 py-3 text-sm text-app-gray-light;
  }
</style>

<script>
  class CallTabs extends HTMLElement {
    connectedCallback() {
      const tabs = Array.from(this.querySelectorAll<HTMLButtonElement>("[role=tab]"));
      const panels = Array.from(this.querySelectorAll<HTMLElement>("[role=tabpanel]"));

      for (const tab of tabs) {
        tab.addEventListener("click", () => {
          for (const other of tabs) other.setAttribute("aria-selected", String(other === tab));
          for (const panel of panels) panel.hidden = panel.dataset.index !== tab.dataset.index;
        });
      }
    }
  }

  customElements.define("call-tabs", CallTabs);
</script>
