---
type Props = {
  items: { href: string; title: string; summary?: string }[];
  rows?: boolean;
};

const { items, rows = false } = Astro.props;
---

<ul class:list={["index-list", { rows }]}>
  {
    items.map((item) => (
      <li>
        <a href={item.href}>
          <code>{item.title}</code>
        </a>
        {item.summary && <p>{item.summary}</p>}
      </li>
    ))
  }
</ul>
