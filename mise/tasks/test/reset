#!/usr/bin/env bash
#MISE description="Drop this checkout's test database and make it again, empty and migrated. Run with MISE_ENV=test."
set -euo pipefail
source "$MISE_CONFIG_ROOT/mise/tasks/_"

if [ "${MISE_ENV:-}" != test ]; then
	echo "test:reset: run it with MISE_ENV=test" >&2
	exit 1
fi

cd "$MISE_CONFIG_ROOT"
test_database_psql -c "DROP DATABASE IF EXISTS \"$KOMRAD_TEST_DATABASE\" WITH (FORCE)" \
	-c "DROP ROLE IF EXISTS komrad_engine_$KOMRAD_TEST_ENGINE, komrad_engine_${KOMRAD_TEST_ENGINE}_reader"
exec mise run docker:up
