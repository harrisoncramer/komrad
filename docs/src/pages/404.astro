---
import Layout from "../layouts/Layout.astro";
import { link } from "../site";
---

<Layout title="Page not found" description="That page does not exist in the komrad docs">
  <div class="mt-4 flex flex-col gap-4">
    <h1 class="mb-4">Page not found</h1>
    <p>There's nothing at this address. The link may be out of date, or the page may have moved.</p>
    <p>
      Try the <a href={link("/guides")}>guides</a> or the <a href={link("/api")}>API reference</a>.
    </p>
  </div>
</Layout>
