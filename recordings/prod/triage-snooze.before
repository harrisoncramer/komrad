#!/usr/bin/env bash
# The tasks from triage-tasks, waited on until all but the long one have finished or asked.
set -euo pipefail

"$(dirname "$0")/triage-tasks"

database="${KOMRAD_DATABASE_URL%&pool_max_conns=*}"

settled() {
	[ "$(psql "$database" -Atc "SELECT count(*) FROM agents WHERE role = 'writer' AND name <> 'lsp-tests' AND turn_ended_at IS NULL AND state <> 'waiting'")" = 0 ]
}

for _ in $(seq 180); do
	settled && exit 0
	sleep 1
done
echo "the triage tasks never settled" >&2
exit 1
