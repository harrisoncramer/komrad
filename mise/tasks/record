#!/usr/bin/env bash
source "$MISE_CONFIG_ROOT/mise/tasks/_"
#MISE description="Record the throwaway instance from a VHS tape, to a video, a gif and a still."
set -euo pipefail

usage() {
	echo "Usage: MISE_ENV=test mise run record <tape> [--out dir]"
	echo
	echo "Runs the tape with VHS against the throwaway instance, after"
	echo "recordings/settings.tape, which sets the size, the font and the docs site's"
	echo "colours. <name>.mp4, <name>.webm, <name>.gif and <name>.png, the final frame,"
	echo "land beside the tape unless --out names another directory."
	echo
	echo "The tape runs in a bash of its own, with this checkout's komrad first on the"
	echo "path. A tape that starts in a shell sources recordings/shell.tape, and one that"
	echo "starts on the panel sources recordings/panel.tape. Tapes live under"
	echo "recordings/prod, which is tracked, or recordings/dev, which is not."
	echo
	echo "It needs the instance up, which 'MISE_ENV=test mise run restart' does. It closes"
	echo "the instance's panel first, so a tape opens a fresh one rather than the screen"
	echo "the last recording left it on. It refuses to run against any tmux socket but a"
	echo "throwaway instance's."
}

TAPE=""
OUT=""

while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--out)
		OUT="${2:-}"
		shift 2
		;;
	*)
		TAPE="$1"
		shift
		;;
	esac
done

case "${KOMRAD_TMUX_SOCKET:-}" in
komrad-test-*) ;;
*)
	echo "record: KOMRAD_TMUX_SOCKET is '${KOMRAD_TMUX_SOCKET:-}', not a throwaway instance's; run it as MISE_ENV=test mise run record" >&2
	exit 1
	;;
esac

if [ -z "$TAPE" ]; then
	usage >&2
	exit 1
fi

if ! command -v ttyd >/dev/null; then
	echo "record: VHS needs ttyd, which 'mise install' puts on the path" >&2
	exit 1
fi

case "$TAPE" in
/*) ;;
*) TAPE="$MISE_ORIGINAL_CWD/$TAPE" ;;
esac

cd "$MISE_CONFIG_ROOT"

NAME="$(basename "$TAPE" .tape)"

if [ -z "$OUT" ]; then
	OUT="$(dirname "$TAPE")"
fi

case "$OUT" in
/*) ;;
*) OUT="$MISE_CONFIG_ROOT/$OUT" ;;
esac

SCRATCH="$MISE_CONFIG_ROOT/local/recordings/$NAME"

rm -rf "$SCRATCH"
mkdir -p "$SCRATCH" "$OUT"
rm -f "$OUT/$NAME".{mp4,webm,gif,png}

PANEL_PANE="$(tmux -L "$KOMRAD_TMUX_SOCKET" show-options -gqv @komrad_panel_pane 2>/dev/null || true)"
if [ -n "$PANEL_PANE" ]; then
	tmux -L "$KOMRAD_TMUX_SOCKET" kill-pane -t "$PANEL_PANE" 2>/dev/null || true
fi

PACE="$(sed -n 's/^# pace: *//p' recordings/settings.tape)"
if [ -z "$PACE" ]; then
	echo "record: recordings/settings.tape names no '# pace:'" >&2
	exit 1
fi

awk -v pace="$PACE" '
	/^Hide/ { hidden = 1 }
	/^Show/ { hidden = 0 }
	{ print }
	!hidden && /^(Type|Enter|Tab|Space|Backspace|Delete|Escape|Up|Down|Left|Right|PageUp|PageDown|Ctrl\+|Alt\+|Shift\+)/ { print "Sleep " pace }
' "$TAPE" >"$SCRATCH/paced.tape"

cat >"$SCRATCH/run.tape" <<TAPE
Source "recordings/settings.tape"
Source "$SCRATCH/paced.tape"
Sleep 1s
Screenshot "$OUT/$NAME.png"
TAPE

env -u TMUX -u TMUX_PANE -u KOMRAD_AGENT_ID -u KOMRAD_SESSION_ID \
	KOMRAD_ENGINES_DIR="$SCRATCH/engines" PATH="$MISE_CONFIG_ROOT/bin:$PATH" \
	vhs --quiet \
	--output "$OUT/$NAME.mp4" \
	--output "$OUT/$NAME.webm" \
	--output "$OUT/$NAME.gif" \
	"$SCRATCH/run.tape"

if [ ! -s "$OUT/$NAME.mp4" ]; then
	echo "record: VHS wrote no video for $TAPE" >&2
	exit 1
fi

if [ ! -s "$OUT/$NAME.png" ]; then
	ffmpeg -v error -y -sseof -0.1 -i "$OUT/$NAME.mp4" -frames:v 1 "$OUT/$NAME.png"
fi

gum log --level info "recorded $NAME into $OUT"
